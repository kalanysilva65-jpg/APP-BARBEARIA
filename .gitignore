# Dependências
node_modules/

# Variáveis de ambiente (use o .env.example como base)
.env

# Banco de dados SQLite (gerado por migrations/seed)
prisma/dev.db
prisma/dev.db-journal

# Uploads de imagens (mantém a pasta, ignora o conteúdo)
uploads/*
!uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# Banco e sessoes SQLite em ambiente local/producao
data/*.db
data/*.sqlite
data/*.db-journal
data/*.sqlite-journal
# Sessoes gravadas em arquivo (session-file-store)
data/sessions/
!data/.gitkeep

# Config local do preview (dev server)
.claude/

# Projeto nativo iOS (Capacitor).
# A pasta ios/ EM SI e versionada de proposito: nela ficam a assinatura, as
# capabilities (Push Notifications) e o icone configurados no Xcode — perder
# isso obriga a refazer tudo a cada `npx cap add ios`.
# O que NAO entra: dependencias e saidas de build, que o Xcode e o CocoaPods
# regeneram sozinhos e pesam centenas de MB no repositorio que o VPS puxa.
ios/App/Pods/
ios/App/App/public/
ios/App/build/
ios/App/output/
ios/DerivedData/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcworkspace/xcuserdata/
*.xcuserstate

# macOS
.DS_Store
