<%
  var PAPEL_LABEL = { admin: 'Administrador', funcionario: 'Barbeiro' };
%>

<%/* Equipe no design SUAVE (pedido do dono, 2026-07-31): as faixas de fio com
     o nome em 40px do Turno 6 dão lugar aos cartões arredondados da
     referência, sob um par de abas em pílula (Barbeiros / Histórico) que fica
     FIXO junto com o título.
     Tocar num barbeiro continua abrindo a PÁGINA DO BARBEIRO em tela cheia —
     mas agora ela é clara e feita de cartões (foto arredondada, dois números,
     bloco escuro, comissão e desempenho) em vez dos blocos pretos de canto
     vivo. Estilos em public/css/sv-clientes-equipe.css. */%>
<div class="sv-tela sv-eq-tela">

  <div class="sv-eq-topo sv-reveal">
    <div class="sv-eq-topo-linha">
      <div class="sv-titulo">Equipe</div>
      <button type="button" class="sv-btn sv-eq-novo" onclick="eqAbrirFolha('novo')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>Novo</span>
      </button>
    </div>
    <div class="sv-eq-abas">
      <button type="button" class="sv-eq-aba <%= aba === 'equipe' ? 'ativo' : '' %>" data-aba="equipe" onclick="eqSelecionarAba(this)">Barbeiros</button>
      <button type="button" class="sv-eq-aba <%= aba === 'historico' ? 'ativo' : '' %>" data-aba="historico" onclick="eqSelecionarAba(this)">Histórico</button>
    </div>
  </div>

  <div class="sv-eq-painel sv-rolagem" id="eq-painel-equipe" <%= aba === 'equipe' ? '' : 'hidden' %>>
    <% if (membros.length === 0) { %>
      <div class="sv-vazio">Nenhum membro na equipe ainda.</div>
    <% } else { %>
      <div class="sv-eq-lista">
        <% membros.forEach(function (m) { %>
          <button type="button" class="sv-eq-item" onclick="eqAbrirPagina(<%= m.id %>)">
            <span class="sv-eq-av">
              <% if (m.fotoUrl) { %><img src="<%= m.fotoUrl %>" alt="" /><% } else { %><%= m.iniciais %><% } %>
            </span>
            <span class="sv-eq-item-corpo">
              <span class="sv-eq-nome-linha">
                <span class="sv-eq-nome"><%= m.nome %></span>
                <% if (!m.ativo) { %><span class="sv-eq-selo">inativo</span><% } %>
              </span>
              <span class="sv-eq-sub"><%= PAPEL_LABEL[m.papel] || m.papel %> · <%= m.comissaoPercentual %>% comissão</span>
            </span>
            <span class="sv-eq-lado">
              <span class="sv-eq-lado-num"><%= m.stats.ocupacaoPct === null ? '—' : m.stats.ocupacaoPct + '%' %></span>
              <span class="sv-eq-lado-rot">ocupação</span>
            </span>
          </button>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%/* Histórico: feed enxuto dos últimos atendimentos concluídos da casa. O
       relatório com comissão por período continua em Comissões — aqui é o
       "quem atendeu quem" de relance, como na referência. */%>
  <div class="sv-eq-painel sv-rolagem" id="eq-painel-historico" <%= aba === 'historico' ? '' : 'hidden' %>>
    <% if (historico.length === 0) { %>
      <div class="sv-vazio">Nenhum atendimento concluído ainda.</div>
    <% } else { %>
      <div class="sv-eq-hist">
        <% historico.forEach(function (h) { %>
          <div class="sv-eq-hist-item">
            <div class="sv-eq-hist-quando">
              <div class="sv-eq-hist-hora"><%= h.hora %></div>
              <div class="sv-eq-hist-data"><%= fmtData(h.data).slice(0, 5) %></div>
            </div>
            <div class="sv-eq-hist-corpo">
              <div class="sv-eq-hist-cliente"><%= h.cliente %></div>
              <div class="sv-eq-hist-sub"><%= h.item %> · <%= h.barbeiro %></div>
            </div>
            <div class="sv-eq-hist-valor"><%= fmtT6(h.valor) %></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%/* Novo membro — folha inferior, mesmo formato do "Novo cliente". */%>
<div class="sv-folha-fundo" id="eq-folha-novo" hidden>
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-folha-titulo">Novo barbeiro</div>
    <form method="POST" action="/painel/equipe">
      <div class="sv-campo">
        <label class="sv-campo-rot" for="eq-novo-nome">Nome</label>
        <input class="sv-campo-input" id="eq-novo-nome" name="nome" placeholder="Nome completo" required />
      </div>
      <%/* Sem e-mail/senha/papel (pedido do dono, 2026-07-28: "só quem vai ter
           acesso sou eu"). O barbeiro é cadastro para a agenda e a comissão,
           não conta de login — o controller gera as credenciais internas que
           o banco exige. */%>
      <button type="submit" class="sv-btn sv-eq-btn-bloco">Adicionar</button>
    </form>
  </div>
</div>

<%/* Página do barbeiro — tela cheia sobre a lista (referência, linhas
     1654-1741). O formulário de edição não é um bloco separado: os campos
     moram DENTRO dos cartões que mostram os números (o nome no cartão de
     identidade, a comissão no cartão de comissões), que é como a referência
     trata edição. */%>
<% membros.forEach(function (m) { %>
  <div class="sv-eq-pg" id="eq-pg-<%= m.id %>" hidden>
    <div class="sv-eq-pg-rolagem sv-rolagem">
      <div class="sv-eq-pg-topo">
        <div class="sv-eq-pg-eyebrow">Barbeiro</div>
        <button type="button" class="sv-eq-pg-fechar" onclick="eqFecharPagina()" aria-label="Fechar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <form method="POST" enctype="multipart/form-data" action="/painel/equipe/<%= m.id %>">
        <div class="sv-cartao sv-eq-hero">
          <%/* A foto É o botão de trocar: o <input file> fica escondido e o
               <label> em cima da imagem abre a galeria. */%>
          <label class="sv-eq-foto" for="eq-foto-<%= m.id %>">
            <% if (m.fotoUrl) { %>
              <img src="<%= m.fotoUrl %>" alt="<%= m.nome %>" />
            <% } else { %>
              <span class="sv-eq-foto-vazia">Foto</span>
            <% } %>
          </label>
          <input class="sv-eq-foto-input" id="eq-foto-<%= m.id %>" name="foto" type="file" accept="image/*" onchange="eqFotoEscolhida(this, <%= m.id %>)" />
          <div class="sv-eq-hero-corpo">
            <input class="sv-eq-nome-input" name="nome" value="<%= m.nome %>" aria-label="Nome do barbeiro" required />
            <div class="sv-eq-papel"><%= m.ativo ? (PAPEL_LABEL[m.papel] || m.papel) : 'Inativo' %></div>
            <span class="sv-pilula sv-eq-hero-pilula"><%= m.jornadaLabel %></span>
            <div class="sv-eq-foto-dica" id="eq-foto-dica-<%= m.id %>">Toque na foto para trocar</div>
          </div>
        </div>

        <div class="sv-eq-par">
          <div class="sv-cartao sv-eq-par-cel">
            <div class="sv-eq-num"><%= fmtT6(m.stats.faturado) %></div>
            <div class="sv-eq-num-rot">Faturamento</div>
          </div>
          <div class="sv-cartao sv-eq-par-cel">
            <div class="sv-eq-num"><%= m.stats.atendimentos %></div>
            <div class="sv-eq-num-rot">Atendimentos no mês</div>
          </div>
        </div>

        <div class="sv-cartao sv-cartao--escuro sv-eq-escuro">
          <div class="sv-eq-par-cel">
            <div class="sv-eq-num"><%= fmtT6(m.stats.ticketMedio) %></div>
            <div class="sv-eq-num-rot">Ticket médio</div>
          </div>
          <div class="sv-eq-divisor"></div>
          <div class="sv-eq-par-cel">
            <div class="sv-eq-num"><%= m.stats.ocupacaoPct === null ? '—' : m.stats.ocupacaoPct + '%' %></div>
            <div class="sv-eq-num-rot">Ocupação</div>
          </div>
        </div>

        <div class="sv-cartao sv-eq-bloco">
          <div class="sv-eq-bloco-tit">Comissões</div>
          <%/* A referência tem duas caixas (serviços e produtos). Aqui só a de
               serviços é do barbeiro: a comissão de produto é por PRODUTO, e
               fica na tela de Produtos — duplicá-la aqui daria dois donos para
               o mesmo número. */%>
          <div class="sv-eq-com">
            <div class="sv-eq-com-caixa">
              <input class="sv-eq-com-input" id="eq-com-<%= m.id %>" name="comissaoPercentual" type="number" min="0" max="100" step="0.1" value="<%= m.comissaoPercentual %>" placeholder="0" />
              <label class="sv-eq-com-rot" for="eq-com-<%= m.id %>">% sobre serviços</label>
            </div>
          </div>
          <div class="sv-eq-com-pe">
            <span class="sv-eq-com-pe-rot">Comissão a receber</span>
            <span class="sv-eq-com-pe-val"><%= fmtT6(m.stats.comissaoReceber) %></span>
          </div>
        </div>

        <div class="sv-cartao sv-eq-bloco">
          <div class="sv-eq-bloco-tit">Desempenho</div>
          <div class="sv-eq-desemp">
            <div class="sv-eq-desemp-linha">
              <div class="sv-eq-desemp-cel">
                <div class="sv-eq-desemp-num"><%= m.stats.clientesAtendidos %></div>
                <div class="sv-eq-desemp-rot">Clientes atendidos</div>
              </div>
              <div class="sv-eq-desemp-cel">
                <div class="sv-eq-desemp-num"><%= m.stats.taxaRetorno === null ? '—' : m.stats.taxaRetorno + '%' %></div>
                <div class="sv-eq-desemp-rot">Taxa de retorno</div>
              </div>
            </div>
            <div class="sv-eq-desemp-linha">
              <div class="sv-eq-desemp-cel">
                <div class="sv-eq-desemp-num"><%= m.stats.servicoTop || '—' %></div>
                <div class="sv-eq-desemp-rot">Serviço mais feito</div>
              </div>
              <div class="sv-eq-desemp-cel">
                <div class="sv-eq-desemp-num"><%= m.stats.produtosVendidos %></div>
                <div class="sv-eq-desemp-rot">Produtos vendidos</div>
              </div>
            </div>
          </div>
        </div>

        <div class="sv-eq-acoes">
          <button type="submit" class="sv-btn sv-eq-btn-bloco">Salvar alterações</button>
        </div>
      </form>

      <%/* Fora do formulário acima de propósito: <form> não aninha. */%>
      <form method="POST" action="/painel/equipe/<%= m.id %>/toggle" class="sv-eq-acoes">
        <button type="submit" class="sv-btn sv-btn--claro sv-eq-btn-bloco"><%= m.ativo ? 'Desativar membro' : 'Ativar membro' %></button>
      </form>
    </div>
  </div>
<% }) %>

<script>
  // Folha inferior (novo barbeiro): `hidden` liga/desliga. Tirar o `hidden`
  // recria o elemento na tela, e é isso que faz a animação de subida rodar de
  // novo a cada abertura.
  function eqAbrirFolha(id) {
    var f = document.getElementById('eq-folha-' + id);
    if (f) f.hidden = false;
  }
  Array.prototype.forEach.call(document.querySelectorAll('.sv-folha-fundo'), function (f) {
    // Só o fundo fecha — clique DENTRO da folha não deve fechá-la.
    f.addEventListener('click', function (e) { if (e.target === f) f.hidden = true; });
  });

  // Página do barbeiro: sobe por cima da lista, sem recarregar.
  function eqAbrirPagina(id) {
    var p = document.getElementById('eq-pg-' + id);
    if (p) p.hidden = false;
  }
  function eqFecharPagina() {
    Array.prototype.forEach.call(document.querySelectorAll('.sv-eq-pg'), function (p) { p.hidden = true; });
  }
  // O <input file> está escondido, então sem isto nada indicaria que a foto
  // foi escolhida antes de salvar.
  function eqFotoEscolhida(input, id) {
    var dica = document.getElementById('eq-foto-dica-' + id);
    if (dica && input.files && input.files[0]) dica.textContent = 'Nova foto: ' + input.files[0].name;
  }

  // Troca de aba sem recarregar: as duas listas já vêm renderizadas. O
  // ?aba=historico do servidor só decide qual nasce visível.
  function eqSelecionarAba(btn) {
    var alvo = btn.getAttribute('data-aba');
    Array.prototype.forEach.call(document.querySelectorAll('.sv-eq-aba'), function (b) {
      b.classList.toggle('ativo', b === btn);
    });
    document.getElementById('eq-painel-equipe').hidden = alvo !== 'equipe';
    document.getElementById('eq-painel-historico').hidden = alvo !== 'historico';
  }

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    Array.prototype.forEach.call(document.querySelectorAll('.sv-folha-fundo'), function (f) { f.hidden = true; });
    eqFecharPagina();
  });
</script>
