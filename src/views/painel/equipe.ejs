<%
  var nomeBarbearia = (typeof barbeariaAtual !== 'undefined' && barbeariaAtual) ? barbeariaAtual.nome : 'Barbearia';
  var PAPEL_LABEL = { admin: 'Administrador', funcionario: 'Barbeiro' };
%>

<!-- Cabeçalho: mesmo padrão de marca-com-ícone da tela de Clientes (o HTML
     original tem um segmentado Equipe/Histórico aqui — sem Histórico, viraria
     um segmentado de 1 item só, então fica o cabeçalho padrão mesmo). -->
<div class="ag2-topo">
  <div class="ag2-marca-linha">
    <span class="ag2-avatar-deco"></span>
    <span class="ag2-marca cl-marca">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#8a8a85" stroke-width="2"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 20a6 6 0 0 1 12 0M15.5 20a5 5 0 0 1 5.5-5"/></svg>
      <%= nomeBarbearia %>
    </span>
    <button type="button" class="ag2-add" onclick="abrirModal('novo')" aria-label="Novo membro">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
    </button>
  </div>
  <div class="ag2-titulo">Equipe</div>
</div>

<%/* Pilha de cards arrastável (drag/swipe), igual ao HTML original: o card
     ativo fica centralizado, os vizinhos "espiam" nas bordas em escala/
     opacidade reduzida, e arrastar troca o card ativo. Sem a aba "Histórico"
     do mockup — esse feed de atendimentos por barbeiro já existe, com mais
     detalhe, na tela de Comissões. */%>
<div class="ag2-corpo eq-corpo">
  <% if (membros.length === 0) { %>
    <div class="ag2-vazio">Nenhum membro na equipe ainda.</div>
  <% } else { %>
    <div class="eq-swipe-wrap" id="eq-swipe-wrap">
      <% membros.forEach(function (m, i) { %>
        <div class="eq-swipe-card" data-id="<%= m.id %>" data-idx="<%= i %>">
          <% if (!m.ativo) { %><span class="eq-swipe-inativo">Inativo</span><% } %>
          <div class="eq-swipe-foto">
            <% if (m.fotoUrl) { %><img src="<%= m.fotoUrl %>" alt="<%= m.nome %>" /><% } %>
          </div>
          <div class="eq-swipe-corpo">
            <div class="eq-swipe-nome-linha">
              <span class="eq-swipe-nome"><%= m.nome %></span>
              <% if (m.ativo) { %><svg width="16" height="16" viewBox="0 0 24 24" fill="#2fae5c" stroke="#fff" stroke-width="1.5"><path d="M8.5 12.2l2.3 2.3 4.7-4.9" stroke="#fff" stroke-width="2" fill="none"/></svg><% } %>
            </div>
            <div class="eq-swipe-papel"><%= PAPEL_LABEL[m.papel] || m.papel %></div>
            <div class="eq-swipe-marca"><%= nomeBarbearia %> · Equipe</div>
            <div class="eq-swipe-stats">
              <div class="eq-swipe-stats-esq">
                <span class="eq-swipe-stat">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8a8a85" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 20a6 6 0 0 1 12 0M15.5 20a5 5 0 0 1 5.5-5"/></svg>
                  <%= m.stats.ocupacaoPct === null ? '—' : m.stats.ocupacaoPct + '%' %>
                </span>
                <span class="eq-swipe-stat">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8a8a85" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h5"/></svg>
                  <%= fmtBRL(m.stats.ticketMedio) %>
                </span>
              </div>
              <span class="eq-swipe-vermais">Ver +</span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <% if (membros.length > 1) { %>
      <div class="eq-swipe-dots">
        <% membros.forEach(function (m, i) { %><span class="eq-swipe-dot" data-idx="<%= i %>"></span><% }) %>
      </div>
    <% } %>
  <% } %>
</div>

<!-- Pop-up: novo membro (escurece atrás, igual Serviços/Planos). -->
<div class="ag-overlay" id="agm-novo" onclick="if(event.target===this)fecharModal(this)">
  <div class="ag-modal-box">
    <div class="ag-modal-topo">
      <div class="ag-modal-nome">Novo membro</div>
      <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
    </div>
    <form method="POST" action="/painel/equipe" class="form mt-16">
      <div class="campo">
        <label for="nome-novo">Nome</label>
        <input id="nome-novo" name="nome" required />
      </div>
      <div class="campo">
        <label for="email-novo">E-mail (login)</label>
        <input id="email-novo" name="email" type="email" required />
      </div>
      <div class="campo">
        <label for="senha-novo">Senha</label>
        <input id="senha-novo" name="senha" type="password" minlength="6" required />
      </div>
      <div class="campo">
        <label>Papel</label>
        <input type="hidden" name="papel" id="papel-novo" value="funcionario" />
        <div class="pill-group">
          <button type="button" class="pill-opcao ativo" data-valor="funcionario" onclick="selecionarPapel(this,'novo')">Barbeiro</button>
          <button type="button" class="pill-opcao" data-valor="admin" onclick="selecionarPapel(this,'novo')">Administrador</button>
        </div>
      </div>
      <div class="modal-acoes">
        <button type="button" class="modal-cancelar" onclick="fecharModal(this.closest('.ag-overlay'))">Cancelar</button>
        <button class="btn btn-primario" type="submit">Adicionar</button>
      </div>
    </form>
  </div>
</div>

<%/* Pop-up de edição: um por membro. No HTML original não tem barra de
     título/X — é avatar + nome/papel editáveis direto no topo, fundo mais
     translúcido (rgba(255,255,255,.7), não o rgba(.97) padrão das outras
     telas) e o "fechar" é clicar fora. Comissão/e-mail/senha/foto não têm
     equivalente no mockup (que é só protótipo) — entram depois da parte
     fiel ao HTML, com o padrão .campo já usado no resto do app. */%>
<% membros.forEach(function (m) { %>
  <div class="ag-overlay" id="agm-<%= m.id %>" onclick="if(event.target===this)fecharModal(this)">
    <div class="ag-modal-box eq-modal-box">
      <div class="eq-modal-topo">
        <span class="eq-modal-avatar"><% if (m.fotoUrl) { %><img src="<%= m.fotoUrl %>" alt="" /><% } %></span>
        <div class="eq-modal-identidade">
          <div class="eq-modal-nome"><%= m.nome %></div>
          <div class="eq-modal-papel"><%= PAPEL_LABEL[m.papel] || m.papel %></div>
        </div>
      </div>

      <div class="eq-modal-stats">
        <div class="eq-modal-stat">
          <div class="eq-modal-stat-label">Comissão serviços</div>
          <div class="eq-modal-stat-valor"><%= m.comissaoPercentual %>%</div>
        </div>
        <div class="eq-modal-stat">
          <div class="eq-modal-stat-label">Ticket médio</div>
          <div class="eq-modal-stat-valor"><%= fmtBRL(m.stats.ticketMedio) %></div>
        </div>
        <div class="eq-modal-stat">
          <div class="eq-modal-stat-label">Ocupação (mês)</div>
          <div class="eq-modal-stat-valor"><%= m.stats.ocupacaoPct === null ? '—' : m.stats.ocupacaoPct + '%' %></div>
        </div>
        <div class="eq-modal-stat">
          <div class="eq-modal-stat-label">Status</div>
          <div class="eq-modal-stat-valor"><%= m.ativo ? 'Ativo' : 'Inativo' %></div>
        </div>
      </div>

      <form method="POST" enctype="multipart/form-data" action="/painel/equipe/<%= m.id %>" class="form mt-16">
        <div class="campo">
          <label for="nome-<%= m.id %>">Nome</label>
          <input id="nome-<%= m.id %>" name="nome" value="<%= m.nome %>" required />
        </div>
        <div class="campo">
          <label>Papel</label>
          <input type="hidden" name="papel" id="papel-<%= m.id %>" value="<%= m.papel %>" />
          <div class="pill-group">
            <button type="button" class="pill-opcao <%= m.papel === 'funcionario' ? 'ativo' : '' %>" data-valor="funcionario" onclick="selecionarPapel(this,'<%= m.id %>')">Barbeiro</button>
            <button type="button" class="pill-opcao <%= m.papel === 'admin' ? 'ativo' : '' %>" data-valor="admin" onclick="selecionarPapel(this,'<%= m.id %>')">Administrador</button>
          </div>
        </div>
        <div class="campo">
          <label for="comissao-<%= m.id %>">Comissão em serviços (%)</label>
          <input id="comissao-<%= m.id %>" name="comissaoPercentual" type="number" min="0" max="100" step="0.1" value="<%= m.comissaoPercentual %>" />
        </div>
        <div class="campo">
          <label for="email-<%= m.id %>">E-mail (login)</label>
          <input id="email-<%= m.id %>" name="email" type="email" value="<%= m.email %>" required />
        </div>
        <div class="campo">
          <label for="senha-<%= m.id %>">Nova senha <span class="texto-sutil">(deixe em branco pra manter)</span></label>
          <input id="senha-<%= m.id %>" name="senha" type="password" minlength="6" />
        </div>
        <div class="campo">
          <label for="foto-<%= m.id %>">Foto</label>
          <input id="foto-<%= m.id %>" name="foto" type="file" accept="image/*" />
        </div>
        <div class="modal-acoes">
          <button type="button" class="modal-cancelar" onclick="fecharModal(this.closest('.ag-overlay'))">Cancelar</button>
          <button class="btn btn-primario" type="submit">Salvar alterações</button>
        </div>
      </form>
      <div class="flex gap-8 mt-16">
        <form method="POST" action="/painel/equipe/<%= m.id %>/toggle" class="inline">
          <button class="btn btn-secundario btn-sm"><%= m.ativo ? 'Desativar' : 'Ativar' %></button>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<script>
  function abrirModal(id) {
    var o = document.getElementById('agm-' + id);
    if (o) { o.style.display = 'flex'; document.body.classList.add('modal-aberto'); }
  }
  function fecharModal(o) {
    if (o) { o.style.display = 'none'; document.body.classList.remove('modal-aberto'); }
  }
  function selecionarPapel(btn, id) {
    var grupo = btn.parentElement;
    Array.prototype.forEach.call(grupo.querySelectorAll('.pill-opcao'), function (b) { b.classList.remove('ativo'); });
    btn.classList.add('ativo');
    document.getElementById('papel-' + id).value = btn.getAttribute('data-valor');
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.ag-overlay').forEach(function (o) { o.style.display = 'none'; });
      document.body.classList.remove('modal-aberto');
    }
  });

  // Pilha de cards arrastável — mesma matemática de transform/opacidade do
  // HTML original (buildBarberCards/barberTouchStart/Move/End).
  (function () {
    var wrap = document.getElementById('eq-swipe-wrap');
    if (!wrap) return;
    var cards = Array.prototype.slice.call(wrap.querySelectorAll('.eq-swipe-card'));
    var dots = Array.prototype.slice.call(document.querySelectorAll('.eq-swipe-dot'));
    var n = cards.length;
    var activeIdx = 0;
    var dragging = false;
    var startX = null;
    var dragX = 0;

    function render() {
      var dragPct = Math.max(-1, Math.min(1, dragX / 220));
      var shift = dragPct * 30;
      cards.forEach(function (card, i) {
        var rel = i - activeIdx;
        var transform, opacity, zIndex, pointerEvents;
        if (rel === 0) {
          transform = 'translate(calc(-50% + ' + dragX + 'px),-50%) scale(' + (1 - Math.abs(dragPct) * 0.12) + ')';
          opacity = 1; zIndex = 3; pointerEvents = 'auto';
        } else if (rel === 1) {
          transform = 'translate(calc(-20% + ' + shift + 'px),-50%) scale(' + (0.86 + Math.max(0, dragPct) * 0.14) + ')';
          opacity = 0.55 + Math.max(0, dragPct) * 0.45; zIndex = 2; pointerEvents = 'auto';
        } else if (rel === -1) {
          transform = 'translate(calc(-80% + ' + shift + 'px),-50%) scale(' + (0.86 + Math.max(0, -dragPct) * 0.14) + ')';
          opacity = 0.55 + Math.max(0, -dragPct) * 0.45; zIndex = 2; pointerEvents = 'auto';
        } else {
          transform = rel > 0 ? 'translate(10%,-50%) scale(0.8)' : 'translate(-110%,-50%) scale(0.8)';
          opacity = 0; zIndex = 1; pointerEvents = 'none';
        }
        card.style.transform = transform;
        card.style.opacity = opacity;
        card.style.zIndex = zIndex;
        card.style.pointerEvents = pointerEvents;
        card.style.transition = dragging ? 'none' : 'transform 0.45s cubic-bezier(.2,.9,.25,1.4), opacity 0.35s ease';
      });
      dots.forEach(function (d, i) { d.classList.toggle('ativo', i === activeIdx); });
    }

    function irPara(i) {
      activeIdx = Math.max(0, Math.min(n - 1, i));
      render();
    }

    wrap.addEventListener('pointerdown', function (e) {
      startX = e.clientX;
      dragging = true;
      dragX = 0;
      wrap.setPointerCapture(e.pointerId);
    });
    wrap.addEventListener('pointermove', function (e) {
      if (startX == null) return;
      dragX = e.clientX - startX;
      render();
    });
    function terminarArrasto(e) {
      if (startX == null) return;
      var delta = e.clientX - startX;
      startX = null;
      dragging = false;
      if (delta < -40) irPara(activeIdx + 1);
      else if (delta > 40) irPara(activeIdx - 1);
      dragX = 0;
      render();
    }
    wrap.addEventListener('pointerup', terminarArrasto);
    wrap.addEventListener('pointercancel', terminarArrasto);

    cards.forEach(function (card, i) {
      card.addEventListener('click', function () {
        if (Math.abs(dragX) > 5) return; // era arrasto, não toque
        if (i === activeIdx) abrirModal(card.dataset.id);
        else irPara(i);
      });
    });
    dots.forEach(function (d, i) { d.addEventListener('click', function () { irPara(i); }); });

    render();
  })();
</script>
