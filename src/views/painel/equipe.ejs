<%
  var PAPEL_LABEL = { admin: 'Administrador', funcionario: 'Barbeiro' };
%>

<%/* Equipe no design TURNO 6 (pedido do dono, 2026-07-28): a pilha de cards
     arrastável saiu — a referência lista os barbeiros como faixas de fio com o
     NOME em 40px, sob duas abas de texto (Barbeiros / Histórico). O card só
     dava um resumo; agora tocar no nome abre a PÁGINA DO BARBEIRO em tela
     cheia (foto grande + blocos pretos), que é onde ficam os números do mês e
     todo o cadastro editável. */%>
<div class="t6-eq-tela">

  <div class="t6-eq-topo t6-reveal">
    <div class="t6-cl-titulo-linha">
      <div class="t6-eq-titulo">EQUIPE</div>
      <button type="button" class="t6-btn-novo" onclick="abrirModal('novo')">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>Novo</span>
      </button>
    </div>
    <div class="t6-eq-abas">
      <button type="button" class="t6-eq-aba <%= aba === 'equipe' ? 'ativo' : '' %>" data-aba="equipe" onclick="selecionarAba(this)">Barbeiros</button>
      <button type="button" class="t6-eq-aba <%= aba === 'historico' ? 'ativo' : '' %>" data-aba="historico" onclick="selecionarAba(this)">Histórico</button>
    </div>
  </div>

  <div class="t6-eq-painel" id="eq-painel-equipe" <%= aba === 'equipe' ? '' : 'hidden' %>>
    <% if (membros.length === 0) { %>
      <div class="t6-vazio">Nenhum membro na equipe ainda.</div>
    <% } else { %>
      <% membros.forEach(function (m) { %>
        <button type="button" class="t6-eq-item" onclick="abrirModal(<%= m.id %>)">
          <span class="t6-eq-item-linha">
            <span style="min-width:0;">
              <span class="t6-eq-nome"><%= m.nome %></span>
              <span class="t6-eq-sub">
                <%= PAPEL_LABEL[m.papel] || m.papel %> · <%= m.stats.atendimentos %> no mês · <%= m.comissaoPercentual %>% de comissão
              </span>
            </span>
            <span class="t6-eq-lado">
              <span class="t6-eq-lado-num"><%= m.stats.ocupacaoPct === null ? '—' : m.stats.ocupacaoPct + '%' %></span>
              <span class="t6-eq-lado-rot">ocupação</span>
              <% if (!m.ativo) { %><span class="t6-eq-selo">inativo</span><% } %>
            </span>
          </span>
        </button>
      <% }) %>
      <div class="t6-lista-fim"></div>
    <% } %>
  </div>

  <%/* Histórico: feed enxuto dos últimos atendimentos concluídos da casa. O
       relatório com comissão por período continua em Comissões — aqui é o
       "quem atendeu quem" de relance, como na referência. */%>
  <div class="t6-eq-painel" id="eq-painel-historico" <%= aba === 'historico' ? '' : 'hidden' %>>
    <% if (historico.length === 0) { %>
      <div class="t6-vazio">Nenhum atendimento concluído ainda.</div>
    <% } else { %>
      <% historico.forEach(function (h) { %>
        <div class="t6-eq-hist-linha">
          <div class="t6-eq-hist-quando">
            <div class="t6-eq-hist-hora"><%= h.hora %></div>
            <div class="t6-eq-hist-data"><%= fmtData(h.data).slice(0, 5) %></div>
          </div>
          <div class="t6-eq-hist-corpo">
            <div class="t6-eq-hist-cliente"><%= h.cliente %></div>
            <div class="t6-eq-hist-sub"><%= h.item %> · <%= h.barbeiro %></div>
          </div>
          <div class="t6-eq-hist-valor"><%= fmtT6(h.valor) %></div>
        </div>
      <% }) %>
      <div class="t6-lista-fim"></div>
    <% } %>
  </div>
</div>

<!-- Novo membro: diálogo CENTRADO (mesmo formato do "Novo cliente"). -->
<div class="ag-overlay" id="agm-novo" onclick="if(event.target===this)fecharModal(this)">
  <div class="ag-modal-box">
    <div class="t6-cl-dlg-titulo">Novo membro</div>
    <form method="POST" action="/painel/equipe">
      <div class="t6-cl-campo">
        <label class="t6-cl-campo-rot" for="nome-novo">Nome</label>
        <input class="t6-cl-campo-input" id="nome-novo" name="nome" placeholder="Nome completo" required />
      </div>
      <%/* Sem e-mail/senha/papel (pedido do dono, 2026-07-28: "só quem vai ter
           acesso sou eu"). O barbeiro é cadastro para a agenda e a comissão,
           não conta de login — o controller gera as credenciais internas que
           o banco exige. */%>
      <button type="submit" class="t6-cl-dlg-btn">Adicionar</button>
    </form>
  </div>
</div>

<%/* Página do barbeiro — folha de tela cheia com foto grande e canto vivo
     (referência, linhas 2049-2138). O bloco preto "Detalhes" É o formulário de
     edição: a referência já traz a comissão como input dentro dele, então
     nome/e-mail/senha/foto seguem a mesma linguagem em vez de virar um
     formulário claro solto embaixo. */%>
<% membros.forEach(function (m) { %>
  <div class="ag-overlay t6-folha t6-eq-folha" id="agm-<%= m.id %>">
    <div class="ag-modal-box">
      <div class="t6-eq-pg-topo">
        <div class="t6-eq-pg-eyebrow"><%= PAPEL_LABEL[m.papel] || m.papel %></div>
        <button type="button" class="t6-eq-pg-fechar" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <div class="t6-eq-hero">
        <div class="t6-eq-foto">
          <% if (m.fotoUrl) { %>
            <img src="<%= m.fotoUrl %>" alt="<%= m.nome %>" />
          <% } else { %>
            <span class="t6-eq-foto-vazia">Foto</span>
          <% } %>
        </div>
        <div class="t6-eq-hero-col">
          <div>
            <div class="t6-eq-hero-rot">Faturamento</div>
            <div class="t6-eq-hero-num"><%= fmtT6(m.stats.faturado) %></div>
          </div>
          <div>
            <div class="t6-eq-hero-rot">Atendimentos<br>no mês</div>
            <div class="t6-eq-hero-num t6-eq-hero-num--big"><%= m.stats.atendimentos %></div>
          </div>
        </div>
      </div>

      <div class="t6-eq-bloco">
        <div class="t6-eq-bloco-rot"><%= m.ativo ? (PAPEL_LABEL[m.papel] || m.papel) : 'Inativo' %></div>
        <div class="t6-eq-bloco-nome"><%= m.nome %></div>
        <div class="t6-eq-duo">
          <div class="t6-eq-duo-cel">
            <div class="t6-eq-duo-num"><%= fmtT6(m.stats.ticketMedio) %></div>
            <div class="t6-eq-duo-rot">Ticket médio</div>
          </div>
          <div class="t6-eq-duo-cel">
            <div class="t6-eq-duo-num"><%= m.stats.ocupacaoPct === null ? '—' : m.stats.ocupacaoPct + '%' %></div>
            <div class="t6-eq-duo-rot">Ocupação</div>
          </div>
        </div>
      </div>

      <div class="t6-eq-det">
        <div class="t6-eq-bloco-rot">Detalhes</div>

        <%/* Só de leitura: sai do mês corrente, não é campo de cadastro. */%>
        <div class="t6-eq-grade" style="margin-top:8px;">
          <div class="t6-eq-cel">
            <div class="t6-eq-cel-val"><%= fmtT6(m.stats.comissaoReceber) %></div>
            <div class="t6-eq-cel-rot">Comissão a receber</div>
          </div>
          <div class="t6-eq-cel">
            <div class="t6-eq-cel-val"><%= m.stats.servicoTop || '—' %></div>
            <div class="t6-eq-cel-rot">Serviço mais feito</div>
          </div>
        </div>
        <div class="t6-eq-grade">
          <div class="t6-eq-cel">
            <div class="t6-eq-cel-val"><%= m.stats.clientesAtendidos %></div>
            <div class="t6-eq-cel-rot">Clientes atendidos</div>
          </div>
          <div class="t6-eq-cel">
            <div class="t6-eq-cel-val"><%= m.ativo ? 'Ativo' : 'Inativo' %></div>
            <div class="t6-eq-cel-rot">Status</div>
          </div>
        </div>

        <form method="POST" enctype="multipart/form-data" action="/painel/equipe/<%= m.id %>">
          <div class="t6-eq-grade">
            <div class="t6-eq-cel">
              <input id="nome-<%= m.id %>" name="nome" value="<%= m.nome %>" required />
              <label class="t6-eq-cel-rot" for="nome-<%= m.id %>">Nome</label>
            </div>
            <div class="t6-eq-cel">
              <input id="comissao-<%= m.id %>" name="comissaoPercentual" type="number" min="0" max="100" step="0.1" value="<%= m.comissaoPercentual %>" placeholder="0" />
              <label class="t6-eq-cel-rot" for="comissao-<%= m.id %>">Comissão serviços (%)</label>
            </div>
          </div>
          <%/* E-mail, senha e papel saíram (pedido do dono, 2026-07-28: "só
               quem vai ter acesso sou eu") — o barbeiro é cadastro da agenda,
               não conta de login. Não vão nem como campo oculto: o controller
               preserva os valores que já estão no banco, senão salvar por aqui
               rebaixaria um administrador a funcionário. */%>
          <div class="t6-eq-grade">
            <div class="t6-eq-cel">
              <input id="foto-<%= m.id %>" name="foto" type="file" accept="image/*" />
              <label class="t6-eq-cel-rot" for="foto-<%= m.id %>">Foto</label>
            </div>
          </div>

          <button type="submit" class="t6-cta-claro">Salvar alterações</button>
        </form>

        <form method="POST" action="/painel/equipe/<%= m.id %>/toggle">
          <button type="submit" class="t6-cta-vazado"><%= m.ativo ? 'Desativar membro' : 'Ativar membro' %></button>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<script>
  function abrirModal(id) {
    var o = document.getElementById('agm-' + id);
    if (o) { o.style.display = 'flex'; document.body.classList.add('modal-aberto'); }
  }
  function fecharModal(o) {
    if (o) { o.style.display = 'none'; document.body.classList.remove('modal-aberto'); }
  }
  // Troca de aba sem recarregar: as duas listas já vêm renderizadas. O
  // ?aba=historico do servidor só decide qual nasce visível.
  function selecionarAba(btn) {
    var alvo = btn.getAttribute('data-aba');
    Array.prototype.forEach.call(document.querySelectorAll('.t6-eq-aba'), function (b) {
      b.classList.toggle('ativo', b === btn);
    });
    document.getElementById('eq-painel-equipe').hidden = alvo !== 'equipe';
    document.getElementById('eq-painel-historico').hidden = alvo !== 'historico';
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.ag-overlay').forEach(function (o) { o.style.display = 'none'; });
      document.body.classList.remove('modal-aberto');
    }
  });
</script>
