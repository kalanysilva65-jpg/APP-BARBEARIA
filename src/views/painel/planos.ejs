<%/* Planos no design SUAVE (pedido do dono, 2026-07-31): substitui os blocos
     chapados do Turno 6 (uma tinta de cinza por plano, receita em 72px) pelo
     HTML de referência — cartão preto do resumo no topo e, abaixo, um cartão
     branco arredondado por plano com o contador de assinantes em ladrilho e os
     sete dias como bolinhas no rodapé.
     A edição continua em pop-up, mas neste design o pop-up é FOLHA INFERIOR
     (sobe de baixo), não mais o diálogo centrado do Turno 6.
     Estilos em public/css/sv-planos-perfil.css. */%>
<%
  // diasSemana grava 0=Dom..6=Sáb, mas as bolinhas/pílulas aparecem na ordem
  // Seg→Dom — a ORDEM abaixo só afeta a exibição.
  var ORDEM_SEMANA = [1, 2, 3, 4, 5, 6, 0];
  var NOME_DIA = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
  var LETRA_DIA = ['D', 'S', 'T', 'Q', 'Q', 'S', 'S'];
  function _diasArr(diasStr) {
    return String(diasStr || '0,1,2,3,4,5,6').split(',').map(Number).filter(function (n) { return !isNaN(n); });
  }
%>

<div class="sv-tela">

  <div class="sv-pl-topo sv-reveal">
    <div class="sv-pl-topo-linha">
      <div class="sv-titulo">Planos</div>
      <% if (ehAdmin) { %>
        <button type="button" class="sv-pl-novo" data-sv-abre="novo">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          <span>Novo</span>
        </button>
      <% } %>
    </div>
    <div class="sv-pl-dica"><%= ehAdmin ? 'Toque em um plano para editar' : 'Assinaturas e pacotes para clientes' %></div>
  </div>

  <% if (ehAdmin) { %>
    <div class="sv-cartao sv-cartao--escuro sv-pl-resumo sv-reveal sv-pl-p2">
      <div class="sv-pl-resumo-rot">Receita recorrente</div>
      <div class="sv-pl-resumo-num"><%= fmtT6(resumo.mrr) %></div>
      <div class="sv-pl-selos">
        <span class="sv-pilula"><%= resumo.assinantes %> assinante<%= resumo.assinantes === 1 ? '' : 's' %></span>
        <% if (resumo.assinantes) { %>
          <span class="sv-pilula"><%= fmtT6(resumo.ticket) %> /assinante</span>
        <% } %>
      </div>
      <% if (resumo.lider) { %>
        <div class="sv-pl-resumo-linha"><%= resumo.lider.nome %> lidera com <%= resumo.lider.assinantes %> assinante<%= resumo.lider.assinantes === 1 ? '' : 's' %></div>
      <% } %>
    </div>
  <% } else { %>
    <%/* Funcionário não vê receita (mesma regra da Home): a mesma moldura
         mostra o VOLUME — quantos planos estão no ar e quantos clientes têm
         plano em dia —, sem dinheiro nenhum. */%>
    <div class="sv-cartao sv-cartao--escuro sv-pl-resumo sv-reveal sv-pl-p2">
      <div class="sv-pl-resumo-rot">Planos ativos</div>
      <div class="sv-pl-resumo-num"><%= resumo.ativos %></div>
      <div class="sv-pl-selos">
        <span class="sv-pilula"><%= resumo.assinantes %> assinante<%= resumo.assinantes === 1 ? '' : 's' %> em dia</span>
      </div>
    </div>
  <% } %>

  <% if (planos.length === 0) { %>
    <div class="sv-vazio sv-reveal sv-pl-p3">Nenhum plano cadastrado<%= ehAdmin ? ' ainda.' : '.' %></div>
  <% } else { %>
    <div class="sv-pl-lista">
      <% planos.forEach(function (p) { %>
        <%
          var ilimitado = p.tipo === 'ilimitado';
          var diasAtivos = _diasArr(p.diasSemana);
          var tipoRot = ilimitado ? 'Ilimitado' : 'Limitado';
          var usosRot = ilimitado ? 'usos livres' : (p.usos || 0) + 'x por mês';
          var descricao = (p.servico ? p.servico.nome : 'Qualquer serviço') + ' · validade de ' + p.validadeDias + ' dias';
        %>
        <%/* Só o admin edita, então só para ele o cartão é <button> (abre a
             folha). Para o funcionário sai um <div> — sem cursor, sem toque,
             sem foco. A tag sai por saída CRUA (traço) porque é MARCAÇÃO, não
             texto: escapada, as aspas do atributo virariam &#34; e a tag
             quebraria. */%>
        <<%- ehAdmin ? 'button type="button" data-sv-abre="' + p.id + '"' : 'div' %> class="sv-cartao sv-pl-card">
          <% if (!p.ativo) { %>
            <div class="sv-pl-inativo"><span class="sv-pilula">Inativo</span></div>
          <% } %>
          <div class="sv-pl-card-topo">
            <div class="sv-pl-card-corpo">
              <div class="sv-pl-nome"><%= p.nome %></div>
              <div class="sv-pl-meta"><%= fmtT6(p.valor) %> /mês · <%= tipoRot %> · <%= usosRot %></div>
            </div>
            <div class="sv-pl-assin">
              <div class="sv-pl-assin-num"><%= p.assinantes %></div>
              <div class="sv-pl-assin-rot">assin.</div>
            </div>
          </div>
          <div class="sv-pl-desc"><%= descricao %></div>
          <div class="sv-pl-rodape">
            <div class="sv-pl-dias">
              <% ORDEM_SEMANA.forEach(function (i) { %>
                <span class="sv-pl-dia <%= diasAtivos.indexOf(i) !== -1 ? 'on' : '' %>"><%= LETRA_DIA[i] %></span>
              <% }) %>
            </div>
            <%/* A receita do plano é dinheiro recorrente — só o admin vê. */%>
            <% if (ehAdmin && p.assinantes) { %>
              <div class="sv-pl-mrr"><%= fmtT6(p.mrr) %> /mês</div>
            <% } %>
          </div>
        </<%- ehAdmin ? 'button' : 'div' %>>
      <% }) %>
    </div>
  <% } %>

</div>

<% if (ehAdmin) { %>
  <%/* As folhas ficam FORA de .sv-tela: são `position:fixed` e, dentro de um
       elemento animado com transform, virariam posicionadas em relação a ele. */%>

  <div class="sv-folha-fundo" id="sv-pl-folha-novo" hidden>
    <div class="sv-folha">
      <div class="sv-folha-puxador"></div>
      <div class="sv-folha-titulo">Novo plano</div>
      <form method="POST" action="/painel/planos">
        <div class="sv-campo">
          <label class="sv-campo-rot" for="nome-novo">Nome</label>
          <input class="sv-campo-input" id="nome-novo" name="nome" placeholder="Ex.: Corte mensal" required />
        </div>

        <div class="sv-pl-dupla">
          <div class="sv-campo">
            <label class="sv-campo-rot" for="valor-novo">Preço (R$)</label>
            <input class="sv-campo-input" id="valor-novo" name="valor" type="number" step="0.01" min="0" placeholder="0,00" />
          </div>
          <div class="sv-campo" id="campo-usos-novo">
            <label class="sv-campo-rot" for="usos-novo">Usos/mês</label>
            <input class="sv-campo-input" id="usos-novo" name="usos" type="number" min="1" value="1" />
          </div>
        </div>

        <div class="sv-campo">
          <span class="sv-campo-rot">Tipo de uso</span>
          <input type="hidden" name="tipo" id="tipo-novo" value="limitado" />
          <div class="pill-group">
            <button type="button" class="pill-opcao ativo" data-valor="limitado" onclick="svPlTipo(this,'novo')">Limitado</button>
            <button type="button" class="pill-opcao" data-valor="ilimitado" onclick="svPlTipo(this,'novo')">Ilimitado</button>
          </div>
        </div>

        <div class="sv-campo">
          <span class="sv-campo-rot">Dias disponíveis</span>
          <input type="hidden" name="diasSemana" id="dias-novo" value="0,1,2,3,4,5,6" />
          <div class="pill-group" id="dias-group-novo">
            <% ORDEM_SEMANA.forEach(function (i) { %>
              <button type="button" class="pill-opcao ativo" data-dia="<%= i %>" onclick="svPlDia(this,'novo')"><%= NOME_DIA[i] %></button>
            <% }) %>
          </div>
        </div>

        <div class="sv-campo">
          <label class="sv-campo-rot" for="servicoId-novo">Serviço incluso</label>
          <select class="sv-campo-input sv-pl-select" id="servicoId-novo" name="servicoId">
            <option value="">Qualquer serviço</option>
            <% servicos.forEach(function (s) { %>
              <option value="<%= s.id %>"><%= s.nome %></option>
            <% }) %>
          </select>
          <div class="sv-pl-ajuda">É o serviço que o cliente agenda usando o plano.</div>
        </div>

        <div class="sv-campo">
          <label class="sv-campo-rot" for="validadeDias-novo">Validade (dias)</label>
          <input class="sv-campo-input" id="validadeDias-novo" name="validadeDias" type="number" min="1" value="30" />
        </div>

        <button class="sv-btn sv-pl-cta" type="submit">Adicionar</button>
        <button type="button" class="sv-btn sv-btn--claro sv-pl-cta sv-pl-cta--claro" data-sv-fecha>Cancelar</button>
      </form>
    </div>
  </div>

  <%/* Uma folha de edição por plano. */%>
  <% planos.forEach(function (p) { %>
    <% var diasAtivosEdit = _diasArr(p.diasSemana); %>
    <div class="sv-folha-fundo" id="sv-pl-folha-<%= p.id %>" hidden>
      <div class="sv-folha">
        <div class="sv-folha-puxador"></div>
        <div class="sv-folha-titulo"><%= p.nome %></div>
        <form method="POST" action="/painel/planos/<%= p.id %>">
          <div class="sv-campo">
            <label class="sv-campo-rot" for="nome-<%= p.id %>">Nome</label>
            <input class="sv-campo-input" id="nome-<%= p.id %>" name="nome" value="<%= p.nome %>" required />
          </div>

          <div class="sv-pl-dupla">
            <div class="sv-campo">
              <label class="sv-campo-rot" for="valor-<%= p.id %>">Preço (R$)</label>
              <input class="sv-campo-input" id="valor-<%= p.id %>" name="valor" type="number" step="0.01" min="0" value="<%= (p.valor / 100).toFixed(2) %>" />
            </div>
            <div class="sv-campo" id="campo-usos-<%= p.id %>" style="display:<%= p.tipo === 'ilimitado' ? 'none' : '' %>">
              <label class="sv-campo-rot" for="usos-<%= p.id %>">Usos/mês</label>
              <input class="sv-campo-input" id="usos-<%= p.id %>" name="usos" type="number" min="1" value="<%= p.usos || 1 %>" />
            </div>
          </div>

          <div class="sv-campo">
            <span class="sv-campo-rot">Tipo de uso</span>
            <input type="hidden" name="tipo" id="tipo-<%= p.id %>" value="<%= p.tipo %>" />
            <div class="pill-group">
              <button type="button" class="pill-opcao <%= p.tipo === 'limitado' ? 'ativo' : '' %>" data-valor="limitado" onclick="svPlTipo(this,'<%= p.id %>')">Limitado</button>
              <button type="button" class="pill-opcao <%= p.tipo === 'ilimitado' ? 'ativo' : '' %>" data-valor="ilimitado" onclick="svPlTipo(this,'<%= p.id %>')">Ilimitado</button>
            </div>
          </div>

          <div class="sv-campo">
            <span class="sv-campo-rot">Dias disponíveis</span>
            <input type="hidden" name="diasSemana" id="dias-<%= p.id %>" value="<%= p.diasSemana %>" />
            <div class="pill-group" id="dias-group-<%= p.id %>">
              <% ORDEM_SEMANA.forEach(function (i) { %>
                <button type="button" class="pill-opcao <%= diasAtivosEdit.indexOf(i) !== -1 ? 'ativo' : '' %>" data-dia="<%= i %>" onclick="svPlDia(this,'<%= p.id %>')"><%= NOME_DIA[i] %></button>
              <% }) %>
            </div>
          </div>

          <div class="sv-campo">
            <label class="sv-campo-rot" for="servicoId-<%= p.id %>">Serviço incluso</label>
            <select class="sv-campo-input sv-pl-select" id="servicoId-<%= p.id %>" name="servicoId">
              <option value="">Qualquer serviço</option>
              <% servicos.forEach(function (s) { %>
                <option value="<%= s.id %>" <%= p.servicoId === s.id ? 'selected' : '' %>><%= s.nome %></option>
              <% }) %>
            </select>
          </div>

          <div class="sv-campo">
            <label class="sv-campo-rot" for="validadeDias-<%= p.id %>">Validade (dias)</label>
            <input class="sv-campo-input" id="validadeDias-<%= p.id %>" name="validadeDias" type="number" min="1" value="<%= p.validadeDias %>" />
          </div>

          <button class="sv-btn sv-pl-cta" type="submit">Salvar alterações</button>
          <button type="button" class="sv-btn sv-btn--claro sv-pl-cta sv-pl-cta--claro" data-sv-fecha>Cancelar</button>
        </form>

        <div class="sv-pl-acoes">
          <form method="POST" action="/painel/planos/<%= p.id %>/toggle">
            <button class="sv-pl-acao" type="submit"><%= p.ativo ? 'Desativar' : 'Ativar' %></button>
          </form>
          <form method="POST" action="/painel/planos/<%= p.id %>/remover" onsubmit="return confirm('Excluir este plano?')">
            <button class="sv-pl-acao sv-pl-acao--perigo" type="submit">Excluir</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>

  <script>
    // Folha inferior: uma por plano (+ a de "novo"), abertas pelo cartão.
    function svPlAbrir(id) {
      var f = document.getElementById('sv-pl-folha-' + id);
      if (f) f.hidden = false;
    }
    function svPlFechar(f) {
      if (f) f.hidden = true;
    }
    document.querySelectorAll('[data-sv-abre]').forEach(function (el) {
      el.addEventListener('click', function () { svPlAbrir(el.getAttribute('data-sv-abre')); });
    });
    document.querySelectorAll('[data-sv-fecha]').forEach(function (el) {
      el.addEventListener('click', function () { svPlFechar(el.closest('.sv-folha-fundo')); });
    });
    // Só o fundo escurecido fecha — clique DENTRO da folha não pode fechá-la.
    document.querySelectorAll('.sv-folha-fundo').forEach(function (f) {
      f.addEventListener('click', function (e) { if (e.target === f) svPlFechar(f); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.sv-folha-fundo').forEach(function (f) { svPlFechar(f); });
      }
    });
    // Tipo de uso: seleção única (Limitado/Ilimitado) — mostra/esconde "Usos/mês".
    function svPlTipo(btn, id) {
      var grupo = btn.parentElement;
      Array.prototype.forEach.call(grupo.querySelectorAll('.pill-opcao'), function (b) { b.classList.remove('ativo'); });
      btn.classList.add('ativo');
      document.getElementById('tipo-' + id).value = btn.getAttribute('data-valor');
      var campoUsos = document.getElementById('campo-usos-' + id);
      if (campoUsos) campoUsos.style.display = btn.getAttribute('data-valor') === 'ilimitado' ? 'none' : '';
    }
    // Dias disponíveis: seleção múltipla (alterna cada dia).
    function svPlDia(btn, id) {
      btn.classList.toggle('ativo');
      var grupo = document.getElementById('dias-group-' + id);
      var dias = Array.prototype.filter.call(grupo.querySelectorAll('.pill-opcao'), function (b) {
        return b.classList.contains('ativo');
      }).map(function (b) { return b.getAttribute('data-dia'); });
      document.getElementById('dias-' + id).value = dias.join(',');
    }
  </script>
<% } %>
