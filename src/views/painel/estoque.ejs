<%
  // Nomes dos itens em falta para o bloco preto de reposição: a referência
  // resume em UMA linha (corta com reticências), então mostra os 3 primeiros
  // e conta o resto.
  var nomesBaixo = baixoEstoque.slice(0, 3).map(function (i) { return i.nome; }).join(', ');
  var restoBaixo = baixoEstoque.length - Math.min(3, baixoEstoque.length);
%>

<%/* Estoque no design SUAVE (pedido do dono, 2026-07-31): substitui as linhas
     sem cartão do Turno 6 (nome à esquerda, quantidade em 40px à direita)
     pelo HTML de referência — cartão de resumo, o bloco PRETO de reposição
     logo abaixo e a lista em cartões brancos com a caixinha cinza da
     quantidade na ponta direita.
     O pop-up virou FOLHA INFERIOR. Nada de função saiu: criar, editar,
     excluir, alerta de reposição e as categorias continuam.
     Estilos em public/css/sv-catalogo.css. */%>
<div class="sv-tela sv-cat-tela">
  <div class="sv-cat-topo sv-reveal">
    <div class="sv-cat-topo-linha">
      <h1 class="sv-cat-titulo">Estoque</h1>
      <button type="button" class="sv-cat-novo" onclick="abrirFolha('novo')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>Novo</span>
      </button>
    </div>
    <div class="sv-cat-dica">
      Toque em um item para editar · <a href="#" onclick="abrirFolha('categorias');return false;">Categorias</a>
    </div>
  </div>

  <div class="sv-cartao sv-cat-resumo sv-reveal">
    <%/* "Valor gasto" e não "valor em estoque" (como diz a referência): o
         model guarda o custo da compra, não um preço de venda por unidade —
         dizer "em estoque" sugeriria um valor de revenda que o app não tem. */%>
    <div class="sv-cat-resumo-rot">Valor gasto em compras</div>
    <div class="sv-cat-resumo-num"><%= fmtT6(resumo.valorGasto) %></div>
    <div class="sv-cat-resumo-selos">
      <span class="sv-cat-resumo-selo"><%= resumo.unidades %> unidade<%= resumo.unidades === 1 ? '' : 's' %></span>
      <span class="sv-cat-resumo-selo"><%= resumo.itens %> ite<%= resumo.itens === 1 ? 'm' : 'ns' %></span>
    </div>
  </div>

  <% if (baixoEstoque.length > 0) { %>
    <div class="sv-es-alerta sv-reveal">
      <span class="sv-es-alerta-ic">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 2.6 17.3A1.9 1.9 0 0 0 4.2 20h15.6a1.9 1.9 0 0 0 1.6-2.7L13.7 3.9a1.9 1.9 0 0 0-3.4 0z"/></svg>
      </span>
      <span class="sv-es-alerta-corpo">
        <span class="sv-es-alerta-tit"><%= baixoEstoque.length %> para repor</span>
        <span class="sv-es-alerta-sub"><%= nomesBaixo %><% if (restoBaixo > 0) { %> e mais <%= restoBaixo %><% } %></span>
      </span>
    </div>
  <% } %>

  <% if (itens.length === 0) { %>
    <div class="sv-cartao sv-cat-vazio sv-reveal">Nenhum item no estoque ainda.</div>
  <% } else { %>
    <div class="sv-cat-lista">
      <% itens.forEach(function (i) { var baixo = i.quantidade <= i.quantidadeMinima; %>
        <button type="button" class="sv-cat-item sv-es-item" onclick="abrirFolha(<%= i.id %>)">
          <span class="sv-es-corpo">
            <span class="sv-es-nome-linha">
              <span class="sv-es-nome"><%= i.nome %></span>
              <% if (baixo) { %><span class="sv-cat-selo">Repor</span><% } %>
            </span>
            <%/* A referência põe o preço aqui; no nosso model o único valor é
                 o CUSTO da compra inteira, que não faz sentido por linha —
                 no lugar dele vai a categoria, que é o que agrupa a lista. */%>
            <span class="sv-es-sub"><%= i.categoria ? i.categoria.nome : 'Sem categoria' %> · alerta em <%= i.quantidadeMinima %> un</span>
          </span>
          <span class="sv-es-qtd">
            <span class="sv-es-qtd-num"><%= i.quantidade %></span>
            <span class="sv-es-qtd-rot">un</span>
          </span>
        </button>
      <% }) %>
      <div class="sv-cat-fim"></div>
    </div>
  <% } %>
</div>

<!-- Folha: novo item de estoque -->
<div class="sv-folha-fundo" id="svf-novo" hidden onclick="if(event.target===this)fecharFolha(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-cat-folha-topo">
      <div class="sv-folha-titulo">Novo item</div>
      <button type="button" class="sv-cat-folha-x" onclick="fecharFolha(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <form method="POST" action="/painel/estoque">
      <div class="sv-campo">
        <label class="sv-campo-rot" for="nome-novo">Nome</label>
        <input class="sv-campo-input" id="nome-novo" name="nome" placeholder="Ex.: Lâmina descartável" required />
      </div>
      <div class="sv-campo">
        <label class="sv-campo-rot" for="categoriaId-novo">Categoria</label>
        <select class="sv-campo-input sv-cat-select" id="categoriaId-novo" name="categoriaId">
          <option value="">Sem categoria</option>
          <% categorias.forEach(function (c) { %>
            <option value="<%= c.id %>"><%= c.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="sv-cat-dupla">
        <div class="sv-campo">
          <label class="sv-campo-rot" for="quantidade-novo">Quantidade</label>
          <input class="sv-campo-input" id="quantidade-novo" name="quantidade" type="number" min="0" value="0" />
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="quantidadeMinima-novo">Alertar em</label>
          <input class="sv-campo-input" id="quantidadeMinima-novo" name="quantidadeMinima" type="number" min="0" value="0" />
        </div>
      </div>
      <div class="sv-campo">
        <label class="sv-campo-rot" for="valorGasto-novo">Valor gasto na compra (R$)</label>
        <input class="sv-campo-input" id="valorGasto-novo" name="valorGasto" type="number" step="0.01" min="0" placeholder="0,00" />
      </div>
      <button class="sv-btn sv-cat-btn" type="submit">Adicionar</button>
    </form>
  </div>
</div>

<!-- Folha de edição: uma por item -->
<% itens.forEach(function (i) { %>
  <div class="sv-folha-fundo" id="svf-<%= i.id %>" hidden onclick="if(event.target===this)fecharFolha(this)">
    <div class="sv-folha">
      <div class="sv-folha-puxador"></div>
      <div class="sv-cat-folha-topo">
        <div class="sv-folha-titulo"><%= i.nome %></div>
        <button type="button" class="sv-cat-folha-x" onclick="fecharFolha(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <form method="POST" action="/painel/estoque/<%= i.id %>">
        <div class="sv-campo">
          <label class="sv-campo-rot" for="nome-<%= i.id %>">Nome</label>
          <input class="sv-campo-input" id="nome-<%= i.id %>" name="nome" value="<%= i.nome %>" required />
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="categoriaId-<%= i.id %>">Categoria</label>
          <select class="sv-campo-input sv-cat-select" id="categoriaId-<%= i.id %>" name="categoriaId">
            <option value="">Sem categoria</option>
            <% categorias.forEach(function (c) { %>
              <option value="<%= c.id %>" <%= i.categoriaId === c.id ? 'selected' : '' %>><%= c.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="sv-cat-dupla">
          <div class="sv-campo">
            <label class="sv-campo-rot" for="quantidade-<%= i.id %>">Quantidade</label>
            <input class="sv-campo-input" id="quantidade-<%= i.id %>" name="quantidade" type="number" min="0" value="<%= i.quantidade %>" />
          </div>
          <div class="sv-campo">
            <label class="sv-campo-rot" for="quantidadeMinima-<%= i.id %>">Alertar em</label>
            <input class="sv-campo-input" id="quantidadeMinima-<%= i.id %>" name="quantidadeMinima" type="number" min="0" value="<%= i.quantidadeMinima %>" />
          </div>
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="valorGasto-<%= i.id %>">Valor gasto na compra (R$)</label>
          <input class="sv-campo-input" id="valorGasto-<%= i.id %>" name="valorGasto" type="number" step="0.01" min="0" value="<%= (i.valorGasto / 100).toFixed(2) %>" />
        </div>
        <button class="sv-btn sv-cat-btn" type="submit">Salvar alterações</button>
      </form>
      <div class="sv-cat-acoes">
        <form method="POST" action="/painel/estoque/<%= i.id %>/remover"
              onsubmit="return confirm('Excluir este item?')">
          <button class="sv-btn sv-cat-btn sv-cat-btn--sec" type="submit">Excluir item</button>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<!-- Folha: categorias de estoque -->
<div class="sv-folha-fundo" id="svf-categorias" hidden onclick="if(event.target===this)fecharFolha(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-cat-folha-topo">
      <div class="sv-folha-titulo">Categorias</div>
      <button type="button" class="sv-cat-folha-x" onclick="fecharFolha(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <p class="sv-cat-cats-sub">Remover uma categoria não apaga os itens — eles ficam "sem categoria".</p>
    <form method="POST" action="/painel/estoque/categorias" class="sv-cat-cat-form">
      <input class="sv-campo-input" name="nome" placeholder="Nova categoria" required />
      <button class="sv-cat-cat-btn" type="submit">Adicionar</button>
    </form>
    <% categorias.forEach(function (c) { %>
      <div class="sv-cat-cat-linha">
        <form method="POST" action="/painel/estoque/categorias/<%= c.id %>" class="sv-cat-cat-form">
          <input class="sv-campo-input" name="nome" value="<%= c.nome %>" aria-label="Nome da categoria" />
          <span class="sv-cat-cat-conta"><%= c._count.itens %></span>
          <button class="sv-cat-cat-btn" type="submit">Salvar</button>
        </form>
        <form method="POST" action="/painel/estoque/categorias/<%= c.id %>/remover" onsubmit="return confirm('Remover esta categoria?')">
          <button class="sv-cat-cat-x" type="submit" title="Remover categoria">×</button>
        </form>
      </div>
    <% }) %>
    <% if (categorias.length === 0) { %><p class="sv-cat-cats-sub">Nenhuma categoria.</p><% } %>
  </div>
</div>

<script>
  // A folha usa o atributo `hidden` (e não style.display) porque é assim que
  // o suave.css a esconde: `.sv-folha-fundo[hidden] { display:none }`.
  function abrirFolha(id) {
    var f = document.getElementById('svf-' + id);
    if (f) { f.hidden = false; document.body.classList.add('modal-aberto'); }
  }
  function fecharFolha(f) {
    if (f) { f.hidden = true; document.body.classList.remove('modal-aberto'); }
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.sv-folha-fundo').forEach(function (f) { f.hidden = true; });
      document.body.classList.remove('modal-aberto');
    }
  });
</script>
