<%/* Home no design TURNO 6 (pedido do dono, 2026-07-28): segue o HTML de
     referência que ele anexou — abre com o PRÓXIMO AGENDAMENTO em manchete,
     depois os números grandes e, no fim, as colunas do faturamento semanal.
     Sem cartão, sem canto redondo: a separação é por fio de 1px. */%>
<div class="t6-tela">

  <div class="t6-home-topo t6-reveal">
    <div class="t6-eyebrow"><%= saudacao %> · <%= dataLonga %></div>
    <div class="t6-home-titulo">PRÓXIMO<br>AGENDAMENTO</div>
  </div>

  <a href="/painel/agenda" class="t6-prox t6-reveal">
    <% if (proximoCorte) { %>
      <div class="t6-prox-linha">
        <div class="t6-prox-nome"><%= proximoCorte.cliente %></div>
        <div class="t6-prox-hora"><%= proximoCorte.hora %></div>
      </div>
      <div class="t6-prox-sub"><%= proximoCorte.servico %> · <%= proximoCorte.diaNum %> <%= proximoCorte.mesLabel %></div>
    <% } else { %>
      <div class="t6-prox-linha">
        <div class="t6-prox-nome">Nenhum agendamento</div>
      </div>
      <div class="t6-prox-sub">A agenda está livre a partir de agora</div>
    <% } %>
  </a>

  <% if (seguintesCortes.length) { %>
    <a href="/painel/agenda" class="t6-seguintes t6-reveal">
      <% seguintesCortes.forEach(function (nx) { %>
        <div class="t6-seguinte">
          <div class="t6-seguinte-quem"><%= nx.cliente %> · <%= nx.servico %></div>
          <div class="t6-seguinte-hora"><%= nx.hora %></div>
        </div>
      <% }) %>
    </a>
  <% } %>

  <div class="t6-home-nums">
    <div class="t6-nums-linha">
      <% if (ehAdmin) { %>
        <a href="/painel/caixa" class="t6-num-bloco t6-reveal">
          <div class="t6-num"><%= fmtT6(ganhoHoje) %></div>
          <div class="t6-num-label">Faturamento<br>hoje</div>
        </a>
        <div class="t6-nums-col">
          <a href="/painel/relatorios" class="t6-reveal">
            <div class="t6-num"><%= concluidosHoje %></div>
            <div class="t6-num-label">Cortes hoje</div>
          </a>
          <a href="/painel/relatorios" class="t6-reveal">
            <div class="t6-num"><%= fmtT6(ticketMedioHoje) %></div>
            <div class="t6-num-label">Ticket médio<br>por atendimento</div>
          </a>
        </div>
      <% } else { %>
        <%/* Funcionário não vê faturamento: o bloco escuro passa a ser o
             volume de atendimentos do dia. */%>
        <a href="/painel/agenda" class="t6-num-bloco t6-reveal">
          <div class="t6-num"><%= totalHoje %></div>
          <div class="t6-num-label">Agendamentos<br>hoje</div>
        </a>
        <div class="t6-nums-col">
          <div class="t6-reveal">
            <div class="t6-num"><%= concluidosHoje %></div>
            <div class="t6-num-label">Concluídos</div>
          </div>
          <div class="t6-reveal">
            <div class="t6-num"><%= restantesHoje %></div>
            <div class="t6-num-label">Restantes<br>para hoje</div>
          </div>
        </div>
      <% } %>
    </div>

    <a href="/painel/agenda" class="t6-ocupacao t6-reveal">
      <div class="t6-ocupacao-num"><%= produtividade %>%</div>
      <div class="t6-ocupacao-label">Ocupação da agenda hoje</div>
    </a>

    <% if (estoqueBaixo.tem) { %>
      <a href="/painel/estoque" class="t6-alerta-estoque t6-reveal">
        <div class="t6-alerta-corpo">
          <div class="t6-alerta-linha">
            <div class="t6-alerta-num"><%= estoqueBaixo.quantidade %></div>
            <div class="t6-alerta-titulo"><%= estoqueBaixo.titulo %></div>
          </div>
          <div class="t6-alerta-nomes"><%= estoqueBaixo.nomes %></div>
        </div>
        <svg class="t6-alerta-seta" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0E0E0E" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    <% } %>

    <% if (ehAdmin) { %>
      <div class="t6-semana t6-reveal">
        <div class="t6-semana-titulo">FATURAMENTO SEMANAL</div>
        <div class="t6-semana-total"><%= fmtT6(faturamentoSemanal) %></div>
        <div class="t6-semana-blocos">
          <% blocosSemana.forEach(function (bl) { %>
            <div class="t6-bloco" style="height:<%= bl.altura %>px;background:<%= bl.fundo %>;">
              <div class="t6-bloco-valor" style="color:<%= bl.texto %>;"><%= fmtT6(bl.valor) %></div>
              <div class="t6-bloco-label" style="color:<%= bl.apoio %>;"><%= bl.label %></div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>

</div>
