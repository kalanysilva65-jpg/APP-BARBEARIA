<%/* Home no design SUAVE (pedido do dono, 2026-07-31): substitui a composição
     editorial do Turno 6 (canto vivo, números de 80px) pelo HTML de referência
     que ele anexou — cartão escuro do próximo atendimento no topo, grade de
     atalhos, fila e, só então, os números do dia em cartões arredondados.
     A ordem é intencional: o que se faz AGORA vem antes do que se mede.
     Estilos em public/css/sv-home.css; o que é compartilhado, em suave.css. */%>
<%
  // O bloco de dinheiro é do admin. Para o funcionário a mesma moldura mostra
  // VOLUME de atendimentos (regra que já existia no Turno 6 e continua valendo:
  // funcionário não enxerga faturamento).
  var resumoHref = ehAdmin ? '/painel/caixa' : '/painel/agenda';
  var resumoRot = ehAdmin ? 'Faturamento hoje' : 'Atendimentos hoje';
  var resumoNum = ehAdmin ? fmtT6(ganhoHoje) : totalHoje;
  var ladrilhos = ehAdmin
    ? [
        { href: '/painel/relatorios', num: concluidosHoje, rot: 'Cortes hoje' },
        { href: '/painel/relatorios', num: fmtT6(ticketMedioHoje), rot: 'Ticket médio' },
      ]
    : [
        { href: '/painel/agenda', num: concluidosHoje, rot: 'Concluídos' },
        { href: '/painel/agenda', num: restantesHoje, rot: 'Restantes' },
      ];

  // 4º atalho: o funcionário não tem acesso a /painel/caixa (exigeAdmin), então
  // no lugar de "Lançar" ele recebe o Estoque, que usa no dia a dia.
  var atalhos = [
    { href: '/painel/agenda', rot: 'Agendar', icone: '<path d="M12 5v14M5 12h14"/>' },
    ehAdmin
      ? { href: '/painel/caixa', rot: 'Lançar', icone: '<path d="M12 19V5M5 12l7-7 7 7"/>' }
      : { href: '/painel/estoque', rot: 'Estoque', icone: '<path d="M20 12V8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v4M2 12h20v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/><path d="M12 12v8"/>' },
    { href: '/painel/clientes', rot: 'Clientes', icone: '<circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>' },
    { href: '/painel/produtos', rot: 'Produtos', icone: '<path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5z"/><path d="M4 8.5 12 13l8-4.5M12 13v7"/>' },
  ];
%>
<div class="sv-tela">

  <div class="sv-topo sv-reveal">
    <div class="sv-avatar">
      <% if (usuarioFotoUrl) { %>
        <img src="<%= usuarioFotoUrl %>" alt="" />
      <% } else { %>
        <%= iniciaisUsuario %>
      <% } %>
    </div>
    <div class="sv-topo-texto">
      <div class="sv-topo-saudacao"><%= saudacao %> · <%= dataLonga %></div>
      <div class="sv-topo-nome"><%= usuario.nome %></div>
    </div>
    <%/* O sino leva ao Estoque porque é o único aviso que a Home tem hoje —
         a bolinha só aparece quando existe item no limite. */%>
    <a href="/painel/estoque" class="sv-topo-btn" title="Estoque" aria-label="Estoque">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
      <% if (estoqueBaixo.tem) { %><span class="sv-topo-btn-ponto"></span><% } %>
    </a>
  </div>

  <a href="/painel/agenda" class="sv-cartao sv-cartao--escuro sv-hm-prox sv-reveal sv-hm-p2">
    <div class="sv-hm-prox-topo">
      <span class="sv-pilula"><span class="sv-pilula-ponto"></span>Próximo atendimento</span>
      <% if (proximoCorte) { %>
        <span class="sv-hm-prox-data"><%= proximoCorte.diaNum %> <%= proximoCorte.mesLabel %></span>
      <% } %>
    </div>
    <div class="sv-hm-prox-linha">
      <% if (proximoCorte) { %>
        <div class="sv-hm-prox-av"><%= proximoCorte.iniciais %></div>
        <div class="sv-hm-prox-corpo">
          <div class="sv-hm-prox-nome"><%= proximoCorte.cliente %></div>
          <div class="sv-hm-prox-serv"><%= proximoCorte.servico %></div>
        </div>
        <div class="sv-hm-prox-hora"><%= proximoCorte.hora %></div>
      <% } else { %>
        <%/* Sem avatar nem hora no vazio: um monograma "—" pareceria cliente. */%>
        <div class="sv-hm-prox-corpo">
          <div class="sv-hm-prox-nome">Nenhum agendamento</div>
          <div class="sv-hm-prox-serv">A agenda está livre a partir de agora</div>
        </div>
      <% } %>
    </div>
    <div class="sv-hm-prox-pe">
      <span class="sv-hm-prox-pe-rot">Ver agenda do dia</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </div>
  </a>

  <div class="sv-atalhos sv-reveal sv-hm-p3">
    <% atalhos.forEach(function (at) { %>
      <a href="<%= at.href %>" class="sv-atalho">
        <span class="sv-atalho-caixa">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- at.icone %></svg>
        </span>
        <span class="sv-atalho-rot"><%= at.rot %></span>
      </a>
    <% }) %>
  </div>

  <% if (seguintesCortes.length) { %>
    <div class="sv-hm-secao sv-reveal sv-hm-p4">
      <div class="sv-hm-secao-tit">Próximos na fila</div>
      <a href="/painel/agenda" class="sv-hm-secao-link">Ver todos</a>
    </div>
    <div class="sv-hm-fila">
      <% seguintesCortes.forEach(function (nx) { %>
        <a href="/painel/agenda" class="sv-hm-fila-item">
          <span class="sv-hm-fila-av"><%= nx.iniciais %></span>
          <span class="sv-hm-fila-corpo">
            <span class="sv-hm-fila-nome"><%= nx.cliente %></span>
            <span class="sv-hm-fila-serv"><%= nx.servico %></span>
          </span>
          <span class="sv-hm-fila-hora"><%= nx.hora %></span>
        </a>
      <% }) %>
    </div>
  <% } %>

  <div class="sv-hm-secao sv-hm-secao--resumo sv-reveal">
    <div class="sv-hm-secao-tit">Resumo de hoje</div>
    <% if (ehAdmin) { %>
      <a href="/painel/relatorios" class="sv-hm-secao-link">Relatórios</a>
    <% } %>
  </div>

  <a href="<%= resumoHref %>" class="sv-cartao sv-hm-resumo sv-reveal">
    <div class="sv-hm-resumo-rot"><%= resumoRot %></div>
    <div class="sv-hm-resumo-num" data-count><%= resumoNum %></div>
    <div class="sv-hm-barra">
      <div class="sv-hm-barra-cheio" data-fill style="width:<%= ocupacaoLargura %>%"></div>
    </div>
    <div class="sv-hm-resumo-pe">
      <span class="sv-hm-resumo-pe-rot">Ocupação da agenda</span>
      <span class="sv-hm-resumo-pe-val"><%= ocupacaoHoje %>%</span>
    </div>
  </a>

  <div class="sv-hm-ladrilhos">
    <% ladrilhos.forEach(function (ld) { %>
      <a href="<%= ld.href %>" class="sv-cartao sv-hm-ladrilho sv-reveal">
        <div class="sv-hm-ladrilho-num" data-count><%= ld.num %></div>
        <div class="sv-hm-ladrilho-rot"><%= ld.rot %></div>
      </a>
    <% }) %>
  </div>

  <% if (estoqueBaixo.tem) { %>
    <a href="/painel/estoque" class="sv-hm-alerta sv-reveal">
      <span class="sv-hm-alerta-ic">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 2.6 17.3A1.9 1.9 0 0 0 4.2 20h15.6a1.9 1.9 0 0 0 1.6-2.7L13.7 3.9a1.9 1.9 0 0 0-3.4 0z"/></svg>
      </span>
      <span class="sv-hm-alerta-corpo">
        <span class="sv-hm-alerta-tit"><%= estoqueBaixo.quantidade %> <%= estoqueBaixo.titulo %></span>
        <span class="sv-hm-alerta-sub"><%= estoqueBaixo.nomes %></span>
      </span>
      <svg class="sv-hm-alerta-seta" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </a>
  <% } %>

  <% if (ehAdmin) { %>
    <div class="sv-cartao sv-hm-semana sv-reveal">
      <div class="sv-hm-semana-topo">
        <div>
          <div class="sv-hm-semana-rot">Faturamento semanal</div>
          <div class="sv-hm-semana-total"><%= fmtT6(faturamentoSemanal) %></div>
        </div>
        <%/* "Esta semana" e não "7 dias": as colunas são segunda a domingo da
             semana corrente, não os últimos 7 dias corridos. */%>
        <div class="sv-hm-semana-selo">Esta semana</div>
      </div>
      <div class="sv-hm-graf">
        <% barrasSemana.forEach(function (bl) { %>
          <div class="sv-hm-col">
            <div class="sv-hm-col-caixa">
              <div class="sv-hm-col-barra <%= bl.hoje ? 'hoje' : '' %>" style="height:<%= bl.altura %>px"></div>
            </div>
            <div class="sv-hm-col-rot <%= bl.hoje ? 'hoje' : '' %>"><%= bl.label %></div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

</div>
