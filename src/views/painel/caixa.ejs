<%/* CAIXA no design TURNO 6 (pedido do dono, 2026-07-28): segue o HTML de
     referência. As abas Saldo/Transações e a carteira-cartão saíram — a tela
     agora é um EXTRATO corrido: saldo do período em manchete, o que ainda
     falta entrar num bloco preto e a lista de lançamentos com o saldo
     acumulado ao lado de cada faixa. Nada de cartão nem canto redondo: a
     separação é por fio de 1px. */%>

<div class="t6-cx-topo">
  <div class="t6-cx-titulo-linha">
    <div class="t6-cx-titulo">CAIXA</div>
    <button type="button" class="t6-btn-novo" onclick="abrirModal('novo')">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      <span>Lançar</span>
    </button>
  </div>

  <div class="t6-cx-periodo">
    <a class="t6-cx-per <%= periodoAtivo === 'hoje' ? 'ativo' : '' %>" href="/painel/caixa?inicio=<%= presetHoje.inicio %>&fim=<%= presetHoje.fim %>">Hoje</a>
    <a class="t6-cx-per <%= periodoAtivo === 'semana' ? 'ativo' : '' %>" href="/painel/caixa?inicio=<%= presetSemana.inicio %>&fim=<%= presetSemana.fim %>">Semana</a>
    <a class="t6-cx-per <%= periodoAtivo === 'mes' ? 'ativo' : '' %>" href="/painel/caixa?inicio=<%= presetMes.inicio %>&fim=<%= presetMes.fim %>">Mês</a>
    <%/* O período livre é um painel que abre AQUI mesmo (não mais um pop-up):
         na referência escolher datas faz parte do cabeçalho, não é diálogo. */%>
    <button type="button" class="t6-cx-per <%= periodoAtivo === 'custom' ? 'ativo' : '' %>" id="cx-per-custom" onclick="cxAlternarPeriodo()">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8h18M7 3v3M17 3v3M4 5h16v16H4z"/></svg>
      <span><%= periodoCustomLabel %></span>
    </button>
  </div>

  <div class="t6-cx-custom" id="cx-custom" hidden>
    <form method="GET" action="/painel/caixa">
      <div class="t6-cx-custom-datas">
        <div>
          <div class="t6-cx-rot">De</div>
          <input class="t6-cx-inp" id="cx-inicio" type="date" name="inicio" value="<%= inicioStr %>" />
        </div>
        <div>
          <div class="t6-cx-rot">Até</div>
          <input class="t6-cx-inp" id="cx-fim" type="date" name="fim" value="<%= fimStr %>" />
        </div>
      </div>
      <div class="t6-cx-atalhos" style="margin-top:14px;">
        <% atalhosPeriodo.forEach(function (a) { %>
          <button type="button" class="t6-cx-atalho" onclick="cxAtalho('<%= a.inicio %>','<%= a.fim %>')"><%= a.label %></button>
        <% }) %>
      </div>
      <button type="submit" class="t6-cx-aplicar" style="margin-top:14px;">Aplicar</button>
    </form>
  </div>
</div>

<div class="t6-cx-corpo">

  <div class="t6-cx-saldo t6-reveal">
    <div class="t6-eyebrow">Saldo <%= periodoLabelCurto %></div>
    <div class="t6-cx-saldo-num"><%= resumoPeriodo.saldo < 0 ? '−' : '' %><%= fmtT6(Math.abs(resumoPeriodo.saldo)) %></div>
    <div class="t6-cx-saldo-sub"><%= fmtBRL(resumoPeriodo.entrou) %> de entradas − <%= fmtBRL(resumoPeriodo.saiu) %> de saídas</div>
  </div>

  <%/* O que a agenda promete e o caixa ainda não viu. Leva pros relatórios,
       que é onde dá pra olhar o período inteiro. */%>
  <a href="/painel/relatorios" class="t6-cx-receber t6-reveal">
    <div>
      <div class="t6-cx-receber-num"><%= fmtT6(aReceber.valor) %></div>
      <div class="t6-cx-receber-sub">a receber · <%= aReceber.quantidade %> atendimento<%= aReceber.quantidade === 1 ? '' : 's' %> ainda aberto<%= aReceber.quantidade === 1 ? '' : 's' %></div>
    </div>
    <svg class="t6-cx-receber-seta" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FAFAFA" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </a>

  <div class="t6-cx-comp t6-reveal">
    <div class="t6-eyebrow">Composição do período</div>
    <div class="t6-cx-comp-grade">
      <div class="t6-cx-comp-item">
        <div class="t6-cx-comp-rot">Serviços</div>
        <div class="t6-cx-comp-val"><%= fmtT6(servicosValor) %></div>
      </div>
      <div class="t6-cx-comp-item">
        <div class="t6-cx-comp-rot">Produtos</div>
        <div class="t6-cx-comp-val"><%= fmtT6(produtosValor) %></div>
      </div>
      <div class="t6-cx-comp-item">
        <div class="t6-cx-comp-rot">Comissão</div>
        <div class="t6-cx-comp-val"><%= fmtT6(comissaoValor) %></div>
      </div>
      <div class="t6-cx-comp-item">
        <div class="t6-cx-comp-rot">Saídas</div>
        <div class="t6-cx-comp-val"><%= fmtT6(resumoPeriodo.saiu) %></div>
      </div>
    </div>
  </div>

  <%/* A animação de entrada fica no bloco, não em cada faixa: com 30 linhas
       subindo juntas o extrato inteiro tremia. */%>
  <div class="t6-cx-extrato t6-reveal">
    <div class="t6-eyebrow t6-cx-extrato-rot"><%= extratoLabel %></div>
    <% if (extrato.length === 0) { %>
      <div class="t6-vazio">Nenhum lançamento neste período.</div>
    <% } else { %>
      <% extrato.forEach(function (ex) { %>
        <div class="t6-cx-linha">
          <div class="t6-cx-linha-quando">
            <div class="t6-cx-hora"><%= ex.hora %></div>
            <div class="t6-cx-dia"><%= ex.diaLabel %></div>
          </div>
          <div class="t6-cx-linha-corpo">
            <div class="t6-cx-desc"><%= ex.descricao %></div>
            <% if (ex.sub) { %><div class="t6-cx-sub"><%= ex.sub %></div><% } %>
          </div>
          <div class="t6-cx-linha-valor">
            <div class="t6-cx-valor <%= ex.entrada ? '' : 't6-cx-valor--saida' %>"><%= ex.entrada ? '+' : '−' %><%= fmtBRL(ex.valor) %></div>
            <div class="t6-cx-saldo-corrido"><%= fmtBRL(ex.saldo) %></div>
          </div>
          <form method="POST" action="/painel/caixa/<%= ex.id %>/remover" onsubmit="return confirm('Excluir este lançamento?')">
            <input type="hidden" name="inicio" value="<%= inicioStr %>" />
            <input type="hidden" name="fim" value="<%= fimStr %>" />
            <button class="t6-cx-linha-x" title="Excluir lançamento">×</button>
          </form>
        </div>
      <% }) %>
      <div class="t6-cx-fim"></div>
      <% if (extratoRestantes > 0) { %>
        <div class="t6-cx-mais">+ <%= extratoRestantes %> lançamento<%= extratoRestantes === 1 ? '' : 's' %> anterior<%= extratoRestantes === 1 ? '' : 'es' %> neste período</div>
      <% } %>
    <% } %>
  </div>

  <%/* Configuração do caixa fica no fim, fora do caminho do dia a dia. */%>
  <div class="t6-cx-ajustes">
    <div class="t6-eyebrow">Ajustes do caixa</div>
    <button type="button" class="t6-cx-ajuste" onclick="abrirModal('detalhes')">
      <span>
        Formas de pagamento
        <span class="t6-cx-ajuste-sub">Como entrou o dinheiro do período</span>
      </span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
    <button type="button" class="t6-cx-ajuste" onclick="abrirModal('categorias')">
      <span>
        Categorias e automação
        <span class="t6-cx-ajuste-sub"><%= categorias.length %> categoria<%= categorias.length === 1 ? '' : 's' %> · entrada automática <%= autoLigado ? 'ligada' : 'desligada' %></span>
      </span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
  </div>

</div>

<!-- Pop-up: formas de pagamento do período -->
<div class="ag-overlay" id="agm-detalhes" onclick="if(event.target===this)fecharModal(this)">
  <div class="ag-modal-box t6-cx-modal">
    <div class="ag-modal-topo">
      <div class="t6-cx-modal-titulo">Formas de pagamento</div>
      <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
    </div>
    <div class="t6-cx-rot" style="margin-top:10px;"><%= nomePeriodoSel %> · <%= fmtBRL(resumoPeriodo.entrou) %></div>
    <% if (formasPagamento.length === 0) { %>
      <div class="t6-vazio">Nenhuma entrada com forma de pagamento registrada neste período.</div>
    <% } else { %>
      <div class="t6-cx-pag">
        <% formasPagamento.forEach(function (f) { %>
          <div class="t6-cx-pag-item">
            <span class="t6-cx-pag-nome"><%= f.label %></span>
            <span class="t6-cx-pag-valor"><%= fmtBRL(f.valorCentavos) %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%/* Pop-up: Novo lançamento. Entrada/Saída no topo é FILTRO das categorias —
     no app o tipo do lançamento vem da categoria, então dois campos separados
     poderiam se contradizer. */%>
<div class="ag-overlay" id="agm-novo" onclick="if(event.target===this)fecharModal(this)">
  <div class="ag-modal-box t6-cx-modal">
    <div class="ag-modal-topo">
      <div class="t6-cx-modal-titulo">Novo lançamento</div>
      <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
    </div>
    <% if (categorias.length === 0) { %>
      <div class="t6-vazio">Cadastre uma categoria pra poder lançar.</div>
    <% } else { %>
      <form method="POST" action="/painel/caixa">
        <input type="hidden" name="inicio" value="<%= inicioStr %>" />
        <input type="hidden" name="fim" value="<%= fimStr %>" />

        <div class="t6-cx-modal-campos">
          <div class="t6-cx-tipo">
            <button type="button" class="t6-cx-tipo-btn ativo" data-tipo="entrada" onclick="cxFiltrarCategorias('entrada')">Entrada</button>
            <button type="button" class="t6-cx-tipo-btn" data-tipo="saida" onclick="cxFiltrarCategorias('saida')">Saída</button>
          </div>

          <div>
            <div class="t6-cx-rot">Valor</div>
            <input class="t6-cx-inp t6-cx-inp--grande" id="valor-novo" name="valor" type="number" step="0.01" min="0" placeholder="0,00" required />
          </div>

          <div>
            <div class="t6-cx-rot">Descrição</div>
            <input class="t6-cx-inp" id="descricao-novo" name="descricao" placeholder="Ex.: corte do João" />
          </div>

          <div>
            <div class="t6-cx-rot">Categoria</div>
            <input type="hidden" name="categoriaId" id="categoriaId-novo" required />
            <div class="pill-group" id="cx-pills-categoria">
              <% categorias.forEach(function (c) { %>
                <button type="button" class="pill-opcao" data-tipo="<%= c.tipo %>" data-valor="<%= c.id %>" onclick="selecionarPill(this,'categoriaId-novo')"><%= c.nome %></button>
              <% }) %>
            </div>
          </div>

          <div>
            <div class="t6-cx-rot">Forma de pagamento (opcional)</div>
            <input type="hidden" name="formaPagamento" id="formaPagamento-novo" />
            <div class="pill-group">
              <% formasPagamentoOpcoes.forEach(function (f) { %>
                <button type="button" class="pill-opcao" data-valor="<%= f.valor %>" onclick="selecionarPill(this,'formaPagamento-novo')"><%= f.label %></button>
              <% }) %>
            </div>
          </div>

          <div>
            <div class="t6-cx-rot">Data</div>
            <input class="t6-cx-inp" id="data-novo" name="data" type="date" value="<%= hojeIso %>" />
          </div>

          <button class="t6-cx-enviar" type="submit">Lançar</button>
        </div>
      </form>
    <% } %>
  </div>
</div>

<!-- Pop-up: categorias de caixa + entrada automática -->
<div class="ag-overlay" id="agm-categorias" onclick="if(event.target===this)fecharModal(this)">
  <div class="ag-modal-box t6-cx-modal">
    <div class="ag-modal-topo">
      <div class="t6-cx-modal-titulo">Categorias de caixa</div>
      <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
    </div>
    <div class="t6-cx-ajuste-sub" style="margin-top:8px;">Cada categoria é de entrada ou saída. Remover não apaga lançamentos.</div>

    <form method="POST" action="/painel/caixa/categorias" class="t6-cx-cat-nova">
      <input name="nome" placeholder="Nova categoria" required />
      <select name="tipo">
        <option value="entrada">Entrada</option>
        <option value="saida">Saída</option>
      </select>
      <button class="btn btn-secundario">Adicionar</button>
    </form>

    <ul class="t6-cx-cat-lista">
      <% categorias.forEach(function (c) { %>
        <li class="t6-cx-cat-item">
          <form method="POST" action="/painel/caixa/categorias/<%= c.id %>">
            <input name="nome" value="<%= c.nome %>" />
            <select name="tipo">
              <option value="entrada" <%= c.tipo === 'entrada' ? 'selected' : '' %>>Entrada</option>
              <option value="saida" <%= c.tipo === 'saida' ? 'selected' : '' %>>Saída</option>
            </select>
            <span class="t6-cx-cat-n"><%= c._count.lancamentos %></span>
            <button class="btn btn-secundario">Salvar</button>
          </form>
          <form method="POST" action="/painel/caixa/categorias/<%= c.id %>/remover"
                onsubmit="return confirm('Remover esta categoria?')">
            <button class="t6-cx-cat-x" title="Remover categoria">×</button>
          </form>
        </li>
      <% }) %>
      <% if (categorias.length === 0) { %>
        <li class="t6-vazio">Nenhuma categoria.</li>
      <% } %>
    </ul>

    <form method="POST" action="/painel/caixa/config" class="t6-cx-auto">
      <input type="hidden" name="ligado" value="<%= autoLigado ? 'false' : 'true' %>" />
      <span class="t6-cx-auto-txt">Entrada automática ao concluir atendimento</span>
      <button class="btn btn-secundario"><%= autoLigado ? 'Desligar' : 'Ligar' %></button>
    </form>
  </div>
</div>

<script>
  function abrirModal(id) {
    var o = document.getElementById('agm-' + id);
    if (o) { o.style.display = 'flex'; document.body.classList.add('modal-aberto'); }
  }
  function fecharModal(o) {
    if (o) { o.style.display = 'none'; document.body.classList.remove('modal-aberto'); }
  }
  function selecionarPill(btn, inputId) {
    var grupo = btn.parentElement;
    Array.prototype.forEach.call(grupo.querySelectorAll('.pill-opcao'), function (b) { b.classList.remove('ativo'); });
    btn.classList.add('ativo');
    document.getElementById(inputId).value = btn.getAttribute('data-valor');
  }

  // Painel De/Até: enquanto está aberto o selo fica cinza escuro — só vira
  // preto quando o período for de fato aplicado (aí vem do servidor).
  function cxAlternarPeriodo() {
    var painel = document.getElementById('cx-custom');
    var selo = document.getElementById('cx-per-custom');
    painel.hidden = !painel.hidden;
    if (!selo.classList.contains('ativo')) selo.classList.toggle('abrindo', !painel.hidden);
  }
  function cxAtalho(inicio, fim) {
    document.getElementById('cx-inicio').value = inicio;
    document.getElementById('cx-fim').value = fim;
  }

  // Entrada/Saída no "Novo lançamento" só mostra as categorias daquele tipo;
  // trocar de lado limpa a escolha para não enviar uma categoria escondida.
  function cxFiltrarCategorias(tipo) {
    document.querySelectorAll('.t6-cx-tipo-btn').forEach(function (b) {
      b.classList.toggle('ativo', b.dataset.tipo === tipo);
    });
    var hidden = document.getElementById('categoriaId-novo');
    if (hidden) hidden.value = '';
    document.querySelectorAll('#cx-pills-categoria .pill-opcao').forEach(function (p) {
      p.hidden = p.dataset.tipo !== tipo;
      p.classList.remove('ativo');
    });
  }
  cxFiltrarCategorias('entrada');

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.ag-overlay').forEach(function (o) { o.style.display = 'none'; });
      document.body.classList.remove('modal-aberto');
    }
  });
</script>
