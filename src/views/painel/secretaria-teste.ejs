<%/* Secretária Cortavo — chat de TESTE (etapa 3.1). Reusa os estilos de sv-ia.css.
     Simula o cliente no WhatsApp; troca de modo recarrega e zera a conversa. */%>
<div class="sv-tela sv-ia">

  <div class="sv-ia-topo sv-reveal">
    <div>
      <div class="sv-titulo">Secretária</div>
      <div class="sv-ia-sub">Chat de teste · você é o cliente</div>
    </div>
    <a href="/painel" class="sv-ia-fechar" title="Início" aria-label="Voltar ao início">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </a>
  </div>

  <div class="sv-sec-modo sv-reveal" role="tablist" aria-label="Modo de agendamento">
    <a href="/painel/secretaria/teste?modo=cortavo" class="sv-sec-modo-btn <%= modo === 'cortavo' ? 'ativo' : '' %>" role="tab" aria-selected="<%= modo === 'cortavo' %>">Modo Cortavo</a>
    <a href="/painel/secretaria/teste?modo=terceiros" class="sv-sec-modo-btn <%= modo === 'terceiros' ? 'ativo' : '' %>" role="tab" aria-selected="<%= modo === 'terceiros' %>">Modo Terceiros</a>
  </div>

  <div class="sv-sec-aviso sv-reveal">
    <% if (modo === 'cortavo') { %>
      Agenda própria: a secretária lê horários reais e <strong>propõe</strong> o agendamento (grava de verdade na próxima etapa).
    <% } else { %>
      Outro app (ex.: AppBarber): a secretária responde tudo e faz <strong>handoff</strong> — manda o link ou anota o pedido pro barbeiro confirmar.
    <% } %>
  </div>

  <% if (!iaAtiva) { %>
    <div class="sv-cartao sv-ia-config sv-reveal">
      <div class="sv-ia-config-ic" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2.4l1.95 5.15L20.1 9.5l-5.15 1.95L13 16.6l-1.95-5.15L5.9 9.5l5.15-1.95z"/></svg>
      </div>
      <div class="sv-ia-config-tit">Secretária ainda não configurada</div>
      <div class="sv-ia-config-txt">Falta ligar a chave da IA no servidor (a mesma do Assistente). Assim que estiver ativa, você poderá testar a conversa aqui.</div>
    </div>
  <% } else { %>

    <div class="sv-ia-chat" id="sec-chat">
      <div class="sv-ia-intro sv-reveal" id="sec-intro">
        <p class="sv-ia-intro-txt">Escreva como se fosse um cliente no WhatsApp:</p>
        <div class="sv-ia-sugs">
          <button type="button" class="sv-ia-sug" data-q="Oi, quanto custa um corte?">💈 Quanto custa um corte?</button>
          <button type="button" class="sv-ia-sug" data-q="Tem horário amanhã de tarde?">🕒 Tem horário amanhã?</button>
          <button type="button" class="sv-ia-sug" data-q="Qual o endereço e horário de vocês?">📍 Endereço e horário</button>
          <button type="button" class="sv-ia-sug" data-q="Quero marcar um corte com barba pra sábado">✂️ Marcar corte + barba</button>
        </div>
      </div>
    </div>

    <form class="sv-ia-composer" id="sec-form" autocomplete="off">
      <input id="sec-input" class="sv-ia-input" type="text" placeholder="Escreva como cliente…" maxlength="1000" aria-label="Mensagem do cliente" />
      <button type="submit" class="sv-ia-enviar" id="sec-enviar" aria-label="Enviar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>
      </button>
    </form>

  <% } %>
</div>

<% if (iaAtiva) { %>
<script>
  (function () {
    var MODO = <%- JSON.stringify(modo) %>;
    var chat = document.getElementById('sec-chat');
    var intro = document.getElementById('sec-intro');
    var form = document.getElementById('sec-form');
    var input = document.getElementById('sec-input');
    var enviar = document.getElementById('sec-enviar');
    if (!chat || !form) return;

    var historico = [];
    var ocupado = false;

    function rolar() { window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }); }
    function bolha(papel, texto) {
      var el = document.createElement('div');
      el.className = 'sv-ia-msg sv-ia-msg--' + papel;
      el.textContent = texto;
      chat.appendChild(el);
      return el;
    }
    function digitando() {
      var el = document.createElement('div');
      el.className = 'sv-ia-msg sv-ia-msg--assistant sv-ia-digitando';
      el.innerHTML = '<span></span><span></span><span></span>';
      chat.appendChild(el);
      return el;
    }

    async function enviarMsg(texto) {
      texto = (texto || '').trim();
      if (!texto || ocupado) return;
      ocupado = true;
      if (intro) intro.style.display = 'none';
      bolha('user', texto);
      var histParaEnviar = historico.slice();
      historico.push({ papel: 'user', texto: texto });
      input.value = '';
      enviar.disabled = true;
      rolar();
      var pts = digitando();
      rolar();
      try {
        var r = await fetch('/painel/secretaria/teste/mensagem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mensagem: texto, historico: histParaEnviar, modo: MODO }),
        });
        var dados = await r.json().catch(function () { return {}; });
        pts.remove();
        if (r.ok && dados.resposta) {
          bolha('assistant', dados.resposta);
          historico.push({ papel: 'assistant', texto: dados.resposta });
        } else {
          bolha('assistant', dados.erro || 'Não consegui responder agora.').classList.add('sv-ia-erro');
        }
      } catch (e) {
        pts.remove();
        bolha('assistant', 'Falha de conexão. Tente de novo.').classList.add('sv-ia-erro');
      } finally {
        ocupado = false;
        enviar.disabled = false;
        rolar();
        input.focus();
      }
    }

    form.addEventListener('submit', function (e) { e.preventDefault(); enviarMsg(input.value); });
    document.querySelectorAll('.sv-ia-sug').forEach(function (b) {
      b.addEventListener('click', function () { enviarMsg(b.getAttribute('data-q')); });
    });
  })();
</script>
<% } %>
