        do faturamento vira lucro.
        <% if (breakEven !== null) { %>Ponto de equilíbrio: <%= breakEven %> atendimentos no ticket atual.<% } else { %>Sem atendimentos no período não dá pra calcular o ponto de equilíbrio.<% } %>
