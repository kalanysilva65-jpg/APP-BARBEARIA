<script>
  // Pop-ups: os mesmos nomes de sempre (`abrirModal`/`fecharModal`), porque
  // outras telas e o Esc global dependem deles. O que mudou é o mecanismo —
  // a folha inferior aparece/some pelo atributo `hidden` (o CSS compartilhado
  // já trata `.sv-folha-fundo[hidden]`), e não mais por `style.display`, senão
  // o display inline venceria a regra e a folha nunca fecharia.
  function abrirModal(id) {
    var o = document.getElementById('agm-' + id);
    if (o) { o.hidden = false; document.body.classList.add('modal-aberto'); }
  }
  function fecharModal(o) {
    if (o) { o.hidden = true; document.body.classList.remove('modal-aberto'); }
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.sv-folha-fundo').forEach(function (o) { o.hidden = true; });
      document.body.classList.remove('modal-aberto');
    }
  });

  // Painel de período personalizado (abre/fecha embaixo dos selos).
  function relCustomToggle() {
    var f = document.getElementById('rel-custom');
    if (f) f.hidden = !f.hidden;
  }
  // Atalho só PREENCHE as datas — o envio continua sendo o submit do form,
  // pra não disparar navegação em toque errado.
  function relAtalho(de, ate) {
    var a = document.getElementById('rel-de');
    var b = document.getElementById('rel-ate');
    if (a) a.value = de;
    if (b) b.value = ate;
  }

  // Sanfona das faixas de venda/gasto.
  function relSanfona(btn) {
    var item = btn.closest('.sv-rl-item');
    if (!item) return;
    var caixa = item.querySelector('.sv-rl-detalhe');
    if (!caixa) return;
    caixa.hidden = !caixa.hidden;
    btn.classList.toggle('aberto', !caixa.hidden);
    btn.setAttribute('aria-expanded', String(!caixa.hidden));
  }

  // Mapa da ocupação: Dia (curva do expediente) x Semana (dia × hora).
  function relMapa(qual) {
    var semana = document.getElementById('rel-mapa-semana');
    var dia = document.getElementById('rel-mapa-dia');
    if (semana) semana.hidden = qual !== 'semana';
    if (dia) dia.hidden = qual !== 'dia';
    document.querySelectorAll('.sv-rl-mapa-btn').forEach(function (b) {
      b.classList.toggle('sel', b.getAttribute('data-mapa') === qual);
    });
  }
</script>
