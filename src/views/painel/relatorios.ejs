              <span class="sv-rl-fill-val" style="color:<%= cs.text %>;"><%= fmtT6(cs.rest) %></span>
            </div>
            <div class="sv-rl-fill-linha">
              <span class="sv-rl-fill-rot"><%= cs.label %></span>
              <span class="sv-rl-fill-valor"><%= fmtBRL(cs.amount) %></span>
