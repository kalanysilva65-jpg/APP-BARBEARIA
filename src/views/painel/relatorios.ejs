    <div class="sv-rl-secao sv-rl-secao--cartao">
      <div class="sv-rl-secao-tit">Novos x recorrentes</div>
      <div class="sv-rl-fills">
        <div>
          <div class="sv-rl-fill" style="width:<%= clientesData.novosW %>;background:#191919;">
            <span class="sv-rl-fill-val" style="color:#E0E0E0;"><%= clientesData.novos %></span>
          </div>
          <div class="sv-rl-fill-rot">Novos · <%= clientesData.novosPct %>% · <%= fmtBRL(clientesData.receitaNovos) %></div>
