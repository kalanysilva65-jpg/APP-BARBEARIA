          </div>
          <div class="sv-rl-fill-rot sv-rl-fill-rot--apoio">Recorrentes · <%= clientesData.recorrentesPct %>% · <%= fmtBRL(clientesData.receitaRecorrentes) %></div>
        </div>
      </div>
    </div>

    <%/* Únicos x atendimentos e veio-1x x voltou (pedido do dono, 2026-09-03).
         Único = pessoa distinta; atendimentos = visitas (contam as repetidas).
         "Voltou" = 2+ atendimentos no período. */%>
    <div class="sv-rl-secao sv-rl-secao--cartao">
      <div class="sv-rl-secao-tit">Veio uma vez x voltou</div>
      <div class="sv-rl-fills">
        <div>
          <div class="sv-rl-fill" style="width:<%= clientesData.voltaramW %>;background:#191919;">
            <span class="sv-rl-fill-val" style="color:#E0E0E0;"><%= clientesData.voltaram %></span>
          </div>
          <div class="sv-rl-fill-rot">Voltou (2+) · <%= clientesData.voltaramPct %>%</div>
        </div>
        <div>
          <div class="sv-rl-fill" style="width:<%= clientesData.umaVezW %>;background:#9C9C9C;">
