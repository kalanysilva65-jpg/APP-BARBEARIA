          </div>
          <div class="sv-rl-fill-rot sv-rl-fill-rot--apoio">Só uma vez · <%= clientesData.umaVezPct %>%</div>
        </div>
      </div>
      <div class="sv-rl-folha-sub" style="margin-top:14px;"><strong><%= clientesData.unicos %></strong> clientes únicos · <strong><%= clientesData.visitas %></strong> atendimentos · <%= clientesData.mediaVisitas.toFixed(1).replace('.', ',') %> por cliente</div>
