          <div class="sv-rl-detalhe" hidden>
            <% gr.entries.forEach(function (ge) { %>
              <div class="sv-rl-detalhe-linha">
                <div>
                  <div class="sv-rl-detalhe-tit"><%= ge.desc %></div>
                  <div class="sv-rl-detalhe-sub"><%= ge.date %></div>
                </div>
                <div class="sv-rl-detalhe-val"><%= fmtBRL(ge.valor) %></div>
