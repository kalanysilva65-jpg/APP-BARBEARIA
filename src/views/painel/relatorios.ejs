<%/* Relatórios no design SUAVE (pedido do dono, 2026-07-31): substitui a capa
     editorial do Turno 6 (faixas sangrando, números de 80px) pelo HTML de
     referência que ele anexou — tela de fundo BRANCO, topo fixo com o filtro de
     período, cartão escuro do faturamento e, abaixo, ladrilhos cinzas e dois
     cartões de gráfico. Nada foi cortado: o detalhe de cada número continua
     existindo, só que agora em FOLHA INFERIOR (sobe de baixo) em vez de folha
     de página inteira. Estilos em public/css/sv-relatorios.css. */%>
<%
  // A ordem dos blocos vem da referência e é intencional: primeiro o dinheiro
  // que entrou, depois as médias que explicam esse dinheiro, e só então os
  // gráficos de composição. O que exige leitura fica por último.
  var ladrilhos = [
    { modal: 'ticket', num: fmtT6(ticketMedio), rot: 'ticket médio', neg: false },
    { modal: 'ocupacao', num: ocupacaoPct + '%', rot: 'agenda ocupada', neg: false },
    { modal: 'lucro', num: fmtT6(lucro), rot: 'lucro estimado', neg: lucro < 0 },
    { modal: 'gastos', num: fmtT6(gastos), rot: 'gastos', neg: false },
  ];
%>
<div class="sv-tela sv-rl">

  <div class="sv-rl-topo">
    <div class="sv-rl-topo-linha">
      <h1 class="sv-rl-titulo">Relatórios</h1>
      <div class="sv-rl-acoes">
        <%/* Exportar continua sendo o print do navegador: não existe geração
             de PDF no servidor, e é o que dá pra oferecer sem back-end novo. */%>
        <button type="button" class="sv-rl-icone" onclick="window.print()" aria-label="Exportar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 19h16"/></svg>
        </button>
        <a href="/painel" class="sv-rl-icone" aria-label="Fechar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </a>
      </div>
    </div>

    <div class="sv-rl-periodos sv-rolagem">
      <a class="sv-rl-per <%= periodo === 'hoje' ? 'sel' : '' %>" href="/painel/relatorios?periodo=hoje">Hoje</a>
      <a class="sv-rl-per <%= periodo === 'semana' ? 'sel' : '' %>" href="/painel/relatorios?periodo=semana">Semana</a>
      <a class="sv-rl-per <%= periodo === 'mes' ? 'sel' : '' %>" href="/painel/relatorios?periodo=mes">Mês</a>
      <a class="sv-rl-per <%= periodo === 'ano' ? 'sel' : '' %>" href="/painel/relatorios?periodo=ano">Ano</a>
      <button type="button" class="sv-rl-per <%= periodo === 'custom' ? 'sel' : '' %>" onclick="relCustomToggle()" aria-controls="rel-custom">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8h18M7 3v3M17 3v3M4 5h16v16H4z"/></svg>
        <span><%= periodo === 'custom' ? relPeriodLabel : 'Período' %></span>
      </button>
    </div>

    <%/* O período personalizado abre AQUI, embaixo dos selos, em vez de numa
         folha: é um form GET normal, então o filtro continua sendo um link
         que dá pra guardar/compartilhar. */%>
    <form id="rel-custom" class="sv-rl-custom" method="GET" action="/painel/relatorios" <%= periodo === 'custom' ? '' : 'hidden' %>>
      <input type="hidden" name="periodo" value="custom" />
      <div class="sv-rl-custom-datas">
        <div class="sv-rl-custom-campo">
          <label class="sv-rl-custom-rot" for="rel-de">De</label>
          <input id="rel-de" class="sv-rl-custom-input" type="date" name="de" value="<%= deStr %>" required />
        </div>
        <div class="sv-rl-custom-campo">
          <label class="sv-rl-custom-rot" for="rel-ate">Até</label>
          <input id="rel-ate" class="sv-rl-custom-input" type="date" name="ate" value="<%= ateStr %>" required />
        </div>
      </div>
      <div class="sv-rl-atalhos">
        <% relCustomShortcuts.forEach(function (sh) { %>
          <button type="button" class="sv-rl-atalho" onclick="relAtalho('<%= sh.de %>','<%= sh.ate %>')"><%= sh.label %></button>
        <% }) %>
      </div>
      <button type="submit" class="sv-rl-custom-ok">Aplicar período</button>
    </form>
  </div>

  <div class="sv-rl-corpo sv-rolagem">

    <%/* 1. Faturamento — o número que abre a tela, com o recorte
         serviços / produtos / atendimentos dentro do próprio cartão. */%>
    <button type="button" class="sv-rl-fat sv-reveal" onclick="abrirModal('fat')">
      <span class="sv-rl-fat-rot">
        Faturamento do período
        <% if (variacaoFaturamento !== null) { %> · <%= variacaoFaturamento >= 0 ? '+' : '' %><%= variacaoFaturamento %>% vs anterior<% } %>
      </span>
      <span class="sv-rl-fat-num"><%= fmtT6(faturamento) %></span>
      <span class="sv-rl-tri">
        <span class="sv-rl-tri-cel">
          <span class="sv-rl-tri-num"><%= fmtT6(servicosValor) %></span>
          <span class="sv-rl-tri-lab">serviços</span>
        </span>
        <span class="sv-rl-tri-cel">
          <span class="sv-rl-tri-num"><%= fmtT6(produtosValor) %></span>
          <span class="sv-rl-tri-lab">produtos</span>
        </span>
        <span class="sv-rl-tri-cel">
          <span class="sv-rl-tri-num"><%= atendimentos %></span>
          <span class="sv-rl-tri-lab">atend.</span>
        </span>
      </span>
    </button>

    <%/* 2. Os quatro ladrilhos cinzas, dois a dois. */%>
    <% for (var i = 0; i < ladrilhos.length; i += 2) { %>
      <div class="sv-rl-par">
        <% ladrilhos.slice(i, i + 2).forEach(function (ld) { %>
          <button type="button" class="sv-rl-meia sv-reveal <%= i === 0 ? 'sv-rl-p2' : 'sv-rl-p3' %>" onclick="abrirModal('<%= ld.modal %>')">
            <span class="sv-rl-meia-num <%= ld.neg ? 'sv-rl-neg' : '' %>"><%= ld.num %></span>
            <span class="sv-rl-meia-lab"><%= ld.rot %></span>
          </button>
        <% }) %>
      </div>
    <% } %>

    <%/* 3. Serviços mais vendidos — barra fina por serviço, o % à direita. */%>
    <button type="button" class="sv-rl-cartao sv-reveal sv-rl-p4" onclick="abrirModal('produtos')">
      <span class="sv-rl-cartao-topo">
        <span class="sv-rl-cartao-tit">Serviços mais vendidos</span>
        <svg class="sv-rl-cartao-seta" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </span>
      <% if (topServices.length) { %>
        <span class="sv-rl-svcs">
          <% topServices.forEach(function (sv) { %>
            <span>
              <span class="sv-rl-svc-linha">
                <span class="sv-rl-svc-nome"><%= sv.name %></span>
                <span class="sv-rl-svc-pct"><%= sv.pct %>%</span>
              </span>
              <span class="sv-rl-svc-trilho">
                <span class="sv-rl-svc-cheio" style="width:<%= sv.w %>;"></span>
              </span>
            </span>
          <% }) %>
        </span>
      <% } else { %>
        <span class="sv-rl-pag-vazio">Nenhum serviço concluído neste período.</span>
      <% } %>
    </button>

    <%/* 4. Formas de pagamento — barra única repartida pelo peso de cada uma. */%>
    <button type="button" class="sv-rl-cartao sv-reveal" onclick="abrirModal('pagamentos')">
      <span class="sv-rl-cartao-topo">
        <span class="sv-rl-cartao-tit">Formas de pagamento</span>
        <svg class="sv-rl-cartao-seta" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </span>
      <% if (formasPagamento.length) { %>
        <span class="sv-rl-pag-stack">
          <%/* Piso de 8 no flex: uma forma com 2% do total viraria um risco
               invisível e o selo dela ficaria órfão na legenda. */%>
          <% formasPagamento.forEach(function (f) { %>
            <span class="sv-rl-pag-col" style="flex:<%= Math.max(8, f.pct) %>;background:<%= f.cor %>;"></span>
          <% }) %>
        </span>
        <span class="sv-rl-pag-legenda">
          <% formasPagamento.forEach(function (f) { %>
            <span class="sv-rl-pag-selo">
              <span class="sv-rl-pag-ponto" style="background:<%= f.cor %>;"></span>
              <span class="sv-rl-pag-txt"><%= f.label %> <%= f.pct %>%</span>
            </span>
          <% }) %>
        </span>
      <% } else { %>
        <span class="sv-rl-pag-vazio">Nenhum recebimento com forma de pagamento registrada.</span>
      <% } %>
    </button>

    <%/* 5. Clientes novos — bloco escuro, frase inteira. */%>
    <button type="button" class="sv-rl-clientes sv-reveal" onclick="abrirModal('clientes')">
      <span>
        <span class="sv-rl-clientes-num"><%= clientesNovos %></span>
        <span class="sv-rl-clientes-txt">clientes novos no período, contra <%= clientesRecorrentes %> que já eram da casa.</span>
      </span>
      <svg class="sv-rl-clientes-seta" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </button>

    <div class="sv-rl-fim"></div>
  </div>
</div>


<%/* ======================= FOLHA · FATURAMENTO ======================= */%>
<div class="sv-folha-fundo sv-rl-pagina" id="agm-fat" hidden onclick="if(event.target===this)fecharModal(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-rl-folha-topo">
      <div>
        <div class="sv-folha-titulo">Faturamento</div>
        <div class="sv-rl-folha-sub"><%= relPeriodLabel %></div>
      </div>
      <button type="button" class="sv-rl-folha-x" onclick="fecharModal(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <div class="sv-rl-hero">
      <div class="sv-rl-hero-num" data-count><%= fmtT6(faturamento) %></div>
      <div class="sv-rl-hero-txt">Entradas do caixa no período<br><%= fmtBRL(servicosValor) %> em serviços · <%= fmtBRL(produtosValor) %> em produtos</div>
    </div>

    <div class="sv-rl-secao">
      <div class="sv-rl-eyebrow">O que foi vendido</div>
      <% if (relVendasRows.length === 0) { %>
        <div class="sv-vazio">Nenhuma venda registrada neste período.</div>
      <% } %>
      <% relVendasRows.forEach(function (vr) { %>
        <div class="sv-rl-item" data-anim="svcIn">
          <div class="sv-rl-item-num" data-count><%= fmtT6(vr.valor) %></div>
          <div class="sv-rl-item-baixo">
            <div class="sv-rl-item-txt"><%= vr.name %><br><%= vr.kind %> · <%= vr.qtyLabel %></div>
            <button type="button" class="sv-rl-seta" onclick="relSanfona(this)" aria-expanded="false" aria-label="Ver detalhe">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
          <div class="sv-rl-detalhe" hidden>
            <% vr.entries.forEach(function (ev) { %>
              <div class="sv-rl-detalhe-linha">
                <div>
                  <div class="sv-rl-detalhe-tit"><%= ev.when %></div>
                  <div class="sv-rl-detalhe-sub"><%= ev.who %></div>
                </div>
                <div class="sv-rl-detalhe-val"><%= fmtBRL(ev.valor) %></div>
              </div>
            <% }) %>
            <% if (vr.more) { %><div class="sv-rl-detalhe-mais"><%= vr.more %></div><% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (barberPerf.length) { %>
      <div class="sv-rl-secao sv-rl-secao--cartao">
        <div class="sv-rl-eyebrow">Por barbeiro</div>
        <% barberPerf.forEach(function (bp) { %>
          <div class="sv-rl-barb">
            <div class="sv-rl-barb-linha">
              <div class="sv-rl-barb-nome"><%= bp.name %></div>
              <div class="sv-rl-barb-num"><%= fmtT6(bp.valor) %></div>
            </div>
            <div class="sv-rl-barra"><div class="sv-rl-barra-cheia" style="width:<%= bp.pct %>%;"></div></div>
            <div class="sv-rl-barb-sub"><%= bp.qtd %> atendimentos · ticket <%= fmtBRL(bp.ticket) %></div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (slotHistory.length) { %>
      <div class="sv-rl-secao sv-rl-secao--cartao">
        <div class="sv-rl-eyebrow">Últimos atendimentos</div>
        <% slotHistory.forEach(function (sh) { %>
          <div class="sv-rl-hist">
            <div class="sv-rl-hist-quando">
              <div class="sv-rl-hist-hora"><%= sh.time %></div>
              <div class="sv-rl-hist-dia"><%= sh.day %></div>
            </div>
            <div class="sv-rl-hist-corpo">
              <div class="sv-rl-hist-cliente"><%= sh.client %></div>
              <div class="sv-rl-hist-sub"><%= sh.service %> · <%= sh.barber %></div>
            </div>
            <div class="sv-rl-hist-val"><%= fmtT6(sh.valor) %></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>


<%/* ======================= FOLHA · MAIS VENDIDOS ======================= */%>
<div class="sv-folha-fundo sv-rl-pagina" id="agm-produtos" hidden onclick="if(event.target===this)fecharModal(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-rl-folha-topo">
      <div>
        <div class="sv-folha-titulo">Mais vendidos</div>
        <div class="sv-rl-folha-sub"><%= relPeriodLabel %></div>
      </div>
      <button type="button" class="sv-rl-folha-x" onclick="fecharModal(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <div class="sv-rl-secao sv-rl-secao--cartao">
      <div class="sv-rl-eyebrow">Serviços</div>
      <% topServices.forEach(function (sv) { %>
        <div class="sv-rl-rank">
          <div class="sv-rl-rank-qtd"><%= sv.qtd %></div>
          <div class="sv-rl-rank-corpo">
            <div class="sv-rl-rank-nome"><%= sv.name %></div>
            <div class="sv-rl-rank-val"><%= fmtBRL(sv.valor) %> · <%= sv.pct %>% dos serviços</div>
          </div>
        </div>
      <% }) %>
      <% if (!topServices.length) { %><div class="sv-vazio">Nenhum serviço no período.</div><% } %>
    </div>

    <div class="sv-rl-secao sv-rl-secao--cartao">
      <div class="sv-rl-eyebrow">Produtos</div>
      <% relProdutosRows.forEach(function (pr) { %>
        <div class="sv-rl-rank">
          <div class="sv-rl-rank-qtd"><%= pr.qty %></div>
          <div class="sv-rl-rank-corpo">
            <div class="sv-rl-rank-nome"><%= pr.name %></div>
            <div class="sv-rl-rank-val"><%= fmtBRL(pr.valor) %></div>
          </div>
        </div>
      <% }) %>
      <% if (!relProdutosRows.length) { %><div class="sv-vazio">Nenhum produto vendido no período.</div><% } %>

      <div class="sv-rl-total">
        <div class="sv-rl-total-rot">Total em produtos · <%= relProdutosTotalQty %> un</div>
        <div class="sv-rl-total-val"><%= fmtT6(produtosValorTotal) %></div>
      </div>
    </div>
  </div>
</div>


<%/* ======================= FOLHA · TICKET MÉDIO ======================= */%>
<div class="sv-folha-fundo sv-rl-pagina" id="agm-ticket" hidden onclick="if(event.target===this)fecharModal(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-rl-folha-topo">
      <div>
        <div class="sv-folha-titulo">Ticket médio</div>
        <div class="sv-rl-folha-sub"><%= relPeriodLabel %></div>
      </div>
      <button type="button" class="sv-rl-folha-x" onclick="fecharModal(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <div class="sv-rl-hero">
      <div class="sv-rl-hero-num" data-count><%= fmtT6(ticketMedio) %></div>
      <div class="sv-rl-hero-txt">Média por atendimento no período<br><%= fmtBRL(faturamento) %> em <%= atendimentos %> atendimentos<% if (variacaoTicket !== null) { %> · <%= variacaoTicket >= 0 ? '+' : '' %><%= variacaoTicket %>% vs anterior<% } %></div>
    </div>

    <%/* Ticket por atendimento x por cliente (pedido do dono, 2026-09-03): o
         "por cliente" divide o mesmo faturamento pelos clientes distintos, então
         sobe quando a mesma pessoa volta mais de uma vez no período. */%>
    <div class="sv-rl-secao sv-rl-secao--cartao">
      <div class="sv-rl-secao-tit">Por atendimento x por cliente</div>
      <div class="sv-rl-fills">
        <div>
          <div class="sv-rl-fill" style="width:<%= ticketPorTipo.atendW %>;background:#393939;">
            <span class="sv-rl-fill-val" style="color:#E0E0E0;"><%= fmtT6(ticketPorTipo.atendimento) %></span>
          </div>
          <div class="sv-rl-fill-rot">Por atendimento · <%= atendimentos %> atend.</div>
        </div>
        <div>
          <div class="sv-rl-fill" style="width:<%= ticketPorTipo.clienteW %>;background:#9C9C9C;">
            <span class="sv-rl-fill-val" style="color:#191919;"><%= fmtT6(ticketPorTipo.cliente) %></span>
          </div>
          <div class="sv-rl-fill-rot sv-rl-fill-rot--apoio">Por cliente · <%= clientesData.unicos %> únicos</div>
        </div>
      </div>
    </div>

    <div class="sv-rl-secao sv-rl-secao--cartao">
      <div class="sv-rl-secao-tit">Com produto x só serviço</div>
      <div class="sv-rl-fills">
        <div>
          <div class="sv-rl-fill" style="width:<%= ticketData.comW %>;background:#393939;">
            <span class="sv-rl-fill-val" style="color:#E0E0E0;"><%= fmtT6(ticketData.com) %></span>
          </div>
          <div class="sv-rl-fill-rot">Com produto · <%= ticketData.comQtd %> atendimentos</div>
        </div>
        <div>
          <div class="sv-rl-fill" style="width:<%= ticketData.semW %>;background:#9C9C9C;">
            <span class="sv-rl-fill-val" style="color:#191919;"><%= fmtT6(ticketData.sem) %></span>
          </div>
          <div class="sv-rl-fill-rot sv-rl-fill-rot--apoio">Só serviço · <%= ticketData.semQtd %> atendimentos</div>
        </div>
      </div>
    </div>

    <div class="sv-rl-bloco sv-rl-bloco--escuro">
      <div class="sv-rl-bloco-num"><%= ticketData.comPct %>%</div>
      <div class="sv-rl-bloco-txt">dos atendimentos levaram algum produto — e cada um deles rendeu <%= fmtT6(ticketData.delta) %> a mais. Subir essa taxa é o caminho mais curto para aumentar o ticket.</div>
    </div>

    <% if (barberPerf.length) { %>
      <div class="sv-rl-secao sv-rl-secao--cartao">
        <div class="sv-rl-eyebrow">Por barbeiro</div>
        <% barberPerf.forEach(function (bp) { %>
          <div class="sv-rl-dupla">
            <div class="sv-rl-dupla-esq">
              <div class="sv-rl-dupla-nome"><%= bp.name %></div>
              <div class="sv-rl-dupla-sub"><%= bp.qtd %> atendimentos · <%= fmtBRL(bp.valor) %></div>
            </div>
            <div class="sv-rl-dupla-num"><%= fmtT6(bp.ticket) %></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>


<%/* ======================= FOLHA · OCUPAÇÃO ======================= */%>
<div class="sv-folha-fundo sv-rl-pagina" id="agm-ocupacao" hidden onclick="if(event.target===this)fecharModal(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-rl-folha-topo">
      <div>
        <div class="sv-folha-titulo">Ocupação</div>
        <div class="sv-rl-folha-sub"><%= relPeriodLabel %></div>
      </div>
      <button type="button" class="sv-rl-folha-x" onclick="fecharModal(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <div class="sv-rl-ocup-topo">
      <div class="sv-rl-hero-num" data-count><%= ocupData.pct %>%</div>
      <div class="sv-rl-ocup-lado"><%= ocupData.sub %><br><%= ocupData.livres %></div>
    </div>

    <div class="sv-rl-secao sv-rl-secao--cartao">
      <div class="sv-rl-mapa-topo">
        <div class="sv-rl-secao-tit">Mapa</div>
        <%/* Duas leituras do MESMO período: "Dia" soma as horas de todos os dias
             (a curva do expediente) e "Semana" cruza dia × hora (onde a agenda
             enche). Alternar é só client-side — os dados já vieram. */%>
        <div class="sv-rl-mapa-abas">
          <button type="button" class="sv-rl-mapa-btn sel" data-mapa="dia" onclick="relMapa('dia')">Dia</button>
          <button type="button" class="sv-rl-mapa-btn" data-mapa="semana" onclick="relMapa('semana')">Semana</button>
        </div>
      </div>

      <div class="sv-rl-mapa" id="rel-mapa-dia">
        <div class="sv-rl-slots">
          <% ocupSlots.forEach(function (sl) { %>
            <div class="sv-rl-slot">
              <div class="sv-rl-slot-hora" style="color:<%= sl.hourColor %>;"><%= sl.hour %></div>
              <div class="sv-rl-slot-trilho"><div class="sv-rl-slot-cheio" style="width:<%= sl.w %>;background:<%= sl.bg %>;"></div></div>
              <div class="sv-rl-slot-num" style="color:<%= sl.labelColor %>;"><%= sl.label %></div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="sv-rl-mapa" id="rel-mapa-semana" hidden>
        <div class="sv-rl-grid-dias">
          <% ocupGrid.days.forEach(function (d) { %><div class="sv-rl-grid-dia"><%= d %></div><% }) %>
        </div>
        <div class="sv-rl-grid-linhas">
          <% ocupGrid.rows.forEach(function (row) { %>
            <div class="sv-rl-grid-linha">
              <div class="sv-rl-grid-hora"><%= row.hour %></div>
              <% row.cells.forEach(function (c) { %><div class="sv-rl-grid-cel" style="background:<%= c.bg %>;"></div><% }) %>
            </div>
          <% }) %>
        </div>
        <div class="sv-rl-legenda-mapa">
          <span class="sv-rl-legenda-item"><span class="sv-rl-swatch" style="background:#191919;"></span>Lotado</span>
          <span class="sv-rl-legenda-item"><span class="sv-rl-swatch" style="background:#393939;"></span>Cheio</span>
          <span class="sv-rl-legenda-item"><span class="sv-rl-swatch" style="background:#9C9C9C;"></span>Vago</span>
          <span class="sv-rl-legenda-item"><span class="sv-rl-swatch" style="background:#EBEBEB;"></span>Vazio</span>
        </div>
      </div>
    </div>

    <div class="sv-rl-bloco sv-rl-bloco--escuro">
      <div class="sv-rl-bloco-rot">Onde agir</div>
      <% if (ocupInsight.temDados) { %>
        <div class="sv-rl-bloco-frase">Pico às <%= ocupInsight.peak %></div>
        <% if (ocupInsight.temBuraco) { %>
          <div class="sv-rl-bloco-frase sv-rl-bloco-frase--fraca">Buracos às <%= ocupInsight.gap %></div>
        <% } %>
        <div class="sv-rl-bloco-txt">Puxar clientes para os horários vagos vale mais que abrir novos horários no pico.</div>
      <% } else { %>
        <div class="sv-rl-bloco-frase">Sem movimento</div>
        <div class="sv-rl-bloco-txt">Ainda não há atendimentos suficientes neste período para apontar pico e buraco.</div>
      <% } %>
    </div>

    <% if (ocupPorBarbeiro.length) { %>
      <div class="sv-rl-secao sv-rl-secao--cartao">
        <div class="sv-rl-eyebrow">Por barbeiro</div>
        <% ocupPorBarbeiro.forEach(function (ob) { %>
          <div class="sv-rl-barb">
            <div class="sv-rl-barb-linha">
              <div class="sv-rl-barb-nome"><%= ob.name %></div>
              <div class="sv-rl-barb-num"><%= ob.pct %>%</div>
            </div>
            <div class="sv-rl-barra"><div class="sv-rl-barra-cheia" style="width:<%= ob.w %>;"></div></div>
            <div class="sv-rl-barb-sub"><%= ob.sub %></div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="sv-rl-secao">
      <div class="sv-rl-secao-tit">Por dia da semana</div>
    </div>
    <div class="sv-rl-colunas sv-rolagem">
      <% ocupWeekBars.forEach(function (wb) { %>
        <div class="sv-rl-coluna" style="height:<%= wb.h %>px;background:<%= wb.bg %>;">
          <div class="sv-rl-coluna-num" style="color:<%= wb.text %>;"><%= wb.value %></div>
          <div class="sv-rl-coluna-lab" style="color:<%= wb.muted %>;"><%= wb.label %></div>
        </div>
      <% }) %>
    </div>
  </div>
</div>


<%/* ======================= FOLHA · PAGAMENTOS ======================= */%>
<div class="sv-folha-fundo sv-rl-pagina" id="agm-pagamentos" hidden onclick="if(event.target===this)fecharModal(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-rl-folha-topo">
      <div>
        <div class="sv-folha-titulo">Pagamentos</div>
        <div class="sv-rl-folha-sub"><%= relPeriodLabel %></div>
      </div>
      <button type="button" class="sv-rl-folha-x" onclick="fecharModal(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <div class="sv-rl-hero">
      <div class="sv-rl-hero-num" data-count><%= fmtT6(pagData.total) %></div>
      <div class="sv-rl-hero-txt">Recebido no período<br><%= pagData.transacoes %> transações em <%= formasPagamento.length %> formas de pagamento</div>
    </div>

    <% if (formasPagamento.length) { %>
      <div class="sv-rl-donut-linha">
        <div class="sv-rl-donut">
          <svg width="148" height="148" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="42" fill="none" stroke="#EBEBEB" stroke-width="14"></circle>
            <% pagDonut.forEach(function (dn) { %>
              <circle cx="50" cy="50" r="42" fill="none" stroke="<%= dn.color %>" stroke-width="14" stroke-dasharray="<%= dn.dash %>" stroke-dashoffset="<%= dn.offset %>"></circle>
            <% }) %>
          </svg>
          <div class="sv-rl-donut-centro">
            <div class="sv-rl-donut-pct"><%= pagData.maiorPct %>%</div>
            <div class="sv-rl-donut-nome"><%= pagData.maiorNome %></div>
          </div>
        </div>
        <div class="sv-rl-legenda">
          <% formasPagamento.forEach(function (f) { %>
            <div class="sv-rl-leg">
              <span class="sv-rl-leg-cor" style="background:<%= f.cor %>;"></span>
              <span class="sv-rl-leg-corpo">
                <span class="sv-rl-leg-nome"><%= f.label %></span>
                <span class="sv-rl-leg-val"><%= fmtBRL(f.valor) %></span>
              </span>
              <span class="sv-rl-leg-pct"><%= f.pct %>%</span>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="sv-rl-secao">
        <div class="sv-rl-eyebrow">Forma por forma</div>
        <% formasPagamento.forEach(function (f) { %>
          <div class="sv-rl-item" data-anim="svcIn">
            <div class="sv-rl-item-num" data-count><%= fmtT6(f.valor) %></div>
            <div class="sv-rl-item-txt sv-rl-item-txt--solto"><%= f.label %> · <%= f.pct %>%<br><%= f.qtd %> recebimentos · ticket <%= fmtBRL(f.ticket) %></div>
          </div>
        <% }) %>
      </div>

      <div class="sv-rl-secao sv-rl-secao--cartao">
        <div class="sv-rl-secao-tit">Quando o dinheiro cai</div>
        <div class="sv-rl-fills">
          <div>
            <div class="sv-rl-fill" style="width:<%= pagData.naHoraW %>;background:#191919;">
              <span class="sv-rl-fill-val" style="color:#E0E0E0;"><%= fmtT6(pagData.naHoraValor) %></span>
            </div>
            <div class="sv-rl-fill-rot">Na hora · Pix e dinheiro · <%= pagData.naHoraPct %>%</div>
          </div>
          <div>
            <div class="sv-rl-fill" style="width:<%= pagData.depoisW %>;background:#9C9C9C;">
              <span class="sv-rl-fill-val" style="color:#191919;"><%= fmtT6(pagData.depoisValor) %></span>
            </div>
            <div class="sv-rl-fill-rot sv-rl-fill-rot--apoio">Depois · cartão, no prazo da maquininha · <%= pagData.depoisPct %>%</div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="sv-vazio">Nenhum recebimento com forma de pagamento registrada neste período.</div>
    <% } %>
  </div>
</div>


