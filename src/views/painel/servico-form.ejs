<a href="/painel/servicos" class="link-voltar mb-16">← Voltar</a>

<div class="card">
  <form method="POST" enctype="multipart/form-data" class="form"
        action="<%= servico ? '/painel/servicos/' + servico.id : '/painel/servicos' %>">

    <div class="campo">
      <label for="nome">Nome</label>
      <input id="nome" name="nome" value="<%= servico ? servico.nome : '' %>" required autofocus />
    </div>

    <div class="campo">
      <label for="descricao">Descrição <span class="texto-sutil">(opcional)</span></label>
      <input id="descricao" name="descricao" maxlength="80"
             placeholder="Ex.: Corte tradicional com finalização."
             value="<%= servico && servico.descricao ? servico.descricao : '' %>" />
      <span class="texto-sutil">Aparece embaixo do nome no agendamento do cliente.</span>
    </div>

    <div class="grid-2">
      <div class="campo">
        <label for="valor">Valor (R$)</label>
        <input id="valor" name="valor" type="number" step="0.01" min="0"
               value="<%= servico ? (servico.valor / 100).toFixed(2) : '' %>" required />
      </div>
      <div class="campo">
        <label for="duracaoMin">Duração (min)</label>
        <input id="duracaoMin" name="duracaoMin" type="number" min="0"
               value="<%= servico ? servico.duracaoMin : 0 %>" />
      </div>
    </div>
    <div class="campo">
      <label class="check">
        <input type="checkbox" name="ehProduto" id="ehProduto" <%= servico && servico.ehProduto ? 'checked' : '' %> onchange="toggleComissaoProduto()" />
        É um produto
      </label>
      <span class="texto-sutil">
        Produto: usa a % de comissão definida abaixo, não ocupa horário (deixe a duração em 0).
        Serviço: usa a % de comissão do barbeiro.
      </span>
    </div>

    <div class="campo" id="campo-encaixe" style="display:<%= servico && servico.ehProduto ? 'none' : 'block' %>">
      <label class="check">
        <input type="checkbox" name="ehEncaixe" id="ehEncaixe" <%= servico && servico.ehEncaixe ? 'checked' : '' %> />
        É um encaixe
      </label>
      <span class="texto-sutil">
        Encaixe: quando o cliente marca JUNTO com outro serviço, não soma tempo — cabe
        dentro do tempo do outro. Marcado sozinho, conta a própria duração.
        Ex.: sobrancelha ou pézinho durante o corte.
      </span>
    </div>

    <div class="campo" id="campo-comissao-produto" style="display:<%= servico && servico.ehProduto ? 'block' : 'none' %>">
      <label for="comissaoPercentual">Comissão do produto (%)</label>
      <input id="comissaoPercentual" name="comissaoPercentual" type="number" min="0" max="100" step="0.1"
             value="<%= servico ? servico.comissaoPercentual : 10 %>" />
    </div>
    <script>
      function toggleComissaoProduto() {
        var ehProd = document.getElementById('ehProduto').checked;
        document.getElementById('campo-comissao-produto').style.display = ehProd ? 'block' : 'none';
        var enc = document.getElementById('campo-encaixe');
        if (enc) enc.style.display = ehProd ? 'none' : 'block';
      }
    </script>

    <div class="campo">
      <label for="categoriaId">Categoria</label>
      <select id="categoriaId" name="categoriaId">
        <option value="">Sem categoria</option>
        <% categorias.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= servico && servico.categoriaId === c.id ? 'selected' : '' %>><%= c.nome %></option>
        <% }) %>
      </select>
    </div>

    <div class="campo">
      <label for="foto">Foto</label>
      <% if (servico && servico.fotoUrl) { %>
        <div class="preview-foto"><img src="<%= servico.fotoUrl %>" alt="Foto atual" /></div>
      <% } %>
      <input id="foto" name="foto" type="file" accept="image/*" />
      <span class="texto-sutil">
        JPG, PNG ou WEBP, até 4 MB.<%= servico && servico.fotoUrl ? ' Enviar uma nova substitui a atual.' : '' %>
      </span>
    </div>

    <%/* Receita de consumo de estoque (2026-09-03): baixa automática ao concluir
         o atendimento. Serve tanto pra "produto vendido baixa a si mesmo" quanto
         pra "serviço gasta insumos". Cada item de estoque tem um campo de
         quantidade; 0/vazio = não consome. */%>
    <div class="campo">
      <label>Consome do estoque</label>
      <span class="texto-sutil">
        Baixa sozinho quando o atendimento é concluído — sem trabalho a mais.
        Produto vendido: 1 do próprio item. Serviço: os insumos que gasta (lâmina, creme…).
        Deixe 0 no que não consome.
      </span>
      <% if (!estoqueItens || !estoqueItens.length) { %>
        <p class="texto-sutil" style="margin-top:8px;">Nenhum item de estoque cadastrado ainda — cadastre em <strong>Estoque</strong> para usar aqui.</p>
      <% } else { %>
        <div style="display:flex;flex-direction:column;gap:8px;margin-top:10px;">
          <% estoqueItens.forEach(function (e) { %>
            <label style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
              <span><%= e.nome %></span>
              <input type="number" name="insumo_<%= e.id %>" min="0" step="1" inputmode="numeric"
                     value="<%= insumosMap && insumosMap[e.id] ? insumosMap[e.id] : '' %>" placeholder="0"
                     style="width:82px;padding:8px 10px;border:1px solid var(--cor-borda,#e0e0e0);border-radius:8px;font:inherit;text-align:center;" />
            </label>
          <% }) %>
        </div>
      <% } %>
    </div>

    <button class="btn btn-primario btn-bloco" type="submit">
      <%= servico ? 'Salvar alterações' : 'Criar serviço' %>
    </button>
  </form>
</div>

<% if (servico) { %>
  <div class="flex gap-8 mt-16">
    <form method="POST" action="/painel/servicos/<%= servico.id %>/toggle" class="inline">
      <button class="btn btn-secundario btn-sm"><%= servico.ativo ? 'Desativar' : 'Ativar' %></button>
    </form>
    <form method="POST" action="/painel/servicos/<%= servico.id %>/remover" class="inline"
          onsubmit="return confirm('Excluir este item?')">
      <button class="btn btn-perigo btn-sm">Excluir</button>
    </form>
  </div>
<% } %>
