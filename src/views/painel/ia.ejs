<%/* Assistente Cortavo (IA de consulta). Estilos em public/css/sv-ia.css.
     Conversa stateless: o histórico vive no cliente e vai junto em cada POST. */%>
<div class="sv-tela sv-ia">

  <div class="sv-ia-topo sv-reveal">
    <div>
      <div class="sv-titulo">Assistente</div>
      <div class="sv-ia-sub">Pergunte sobre seus números</div>
    </div>
    <a href="/painel" class="sv-ia-fechar" title="Início" aria-label="Voltar ao início">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </a>
  </div>

  <% if (!iaAtiva) { %>
    <div class="sv-cartao sv-ia-config sv-reveal">
      <div class="sv-ia-config-ic" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2.4l1.95 5.15L20.1 9.5l-5.15 1.95L13 16.6l-1.95-5.15L5.9 9.5l5.15-1.95z"/><path d="M18.4 13.8l.95 2.55 2.55.95-2.55.95-.95 2.55-.95-2.55-2.55-.95 2.55-.95z"/></svg>
      </div>
      <div class="sv-ia-config-tit">Assistente ainda não configurado</div>
      <div class="sv-ia-config-txt">Falta ligar a chave da IA no servidor. Assim que estiver ativa, você poderá perguntar aqui sobre faturamento, agenda e clientes.</div>
    </div>
  <% } else { %>

    <div class="sv-ia-chat" id="ia-chat">
      <div class="sv-ia-intro sv-reveal" id="ia-intro">
        <div class="sv-ia-intro-oi">Oi, <%= primeiroNome %> 👋</div>
        <p class="sv-ia-intro-txt">Posso te ajudar a entender o movimento da barbearia. Pergunte algo ou comece por aqui:</p>
        <div class="sv-ia-sugs">
          <button type="button" class="sv-ia-sug" data-q="Como está o faturamento deste mês?">📈 Faturamento do mês</button>
          <button type="button" class="sv-ia-sug" data-q="Como está a agenda de amanhã?">🗓️ Agenda de amanhã</button>
          <button type="button" class="sv-ia-sug" data-q="Quais são meus melhores clientes?">⭐ Melhores clientes</button>
          <button type="button" class="sv-ia-sug" data-q="Quais horários do dia são mais fracos?">🕒 Horários fracos</button>
        </div>
      </div>
    </div>

    <form class="sv-ia-composer" id="ia-form" autocomplete="off">
      <input id="ia-input" class="sv-ia-input" type="text" name="mensagem" placeholder="Pergunte alguma coisa…" maxlength="1000" aria-label="Sua pergunta" />
      <%/* Microfone (voz→texto no aparelho, sem custo). Nasce escondido; o JS só
           mostra se o navegador tiver a Web Speech API. */%>
      <button type="button" class="sv-ia-mic" id="ia-mic" aria-label="Falar" hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg>
      </button>
      <button type="submit" class="sv-ia-enviar" id="ia-enviar" aria-label="Enviar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>
      </button>
    </form>

  <% } %>
</div>

<% if (iaAtiva) { %>
<script>
  (function () {
    var chat = document.getElementById('ia-chat');
    var intro = document.getElementById('ia-intro');
    var form = document.getElementById('ia-form');
    var input = document.getElementById('ia-input');
    var enviar = document.getElementById('ia-enviar');
    if (!chat || !form) return;

    var historico = []; // [{papel:'user'|'assistant', texto}]
    var ocupado = false;

    function rolar() {
      window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    }

    // Sempre via textContent (nunca innerHTML) — resposta da IA é texto, e assim
    // não há risco de injeção. white-space:pre-wrap preserva quebras e bullets.
    function bolha(papel, texto) {
      var el = document.createElement('div');
      el.className = 'sv-ia-msg sv-ia-msg--' + papel;
      el.textContent = texto;
      chat.appendChild(el);
      return el;
    }

    function digitando() {
      var el = document.createElement('div');
      el.className = 'sv-ia-msg sv-ia-msg--assistant sv-ia-digitando';
      el.innerHTML = '<span></span><span></span><span></span>';
      chat.appendChild(el);
      return el;
    }

    async function enviarPergunta(texto) {
      texto = (texto || '').trim();
      if (!texto || ocupado) return;
      ocupado = true;
      if (intro) intro.style.display = 'none';

      bolha('user', texto);
      var histParaEnviar = historico.slice(); // antes de adicionar a nova
      historico.push({ papel: 'user', texto: texto });
      input.value = '';
      enviar.disabled = true;
      rolar();

      var pts = digitando();
      rolar();

      try {
        var r = await fetch('/painel/ia/mensagem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mensagem: texto, historico: histParaEnviar }),
        });
        var dados = await r.json().catch(function () { return {}; });
        pts.remove();
        if (r.ok && dados.resposta) {
          bolha('assistant', dados.resposta);
          historico.push({ papel: 'assistant', texto: dados.resposta });
        } else {
          var msg = bolha('assistant', dados.erro || 'Não consegui responder agora.');
          msg.classList.add('sv-ia-erro');
        }
      } catch (e) {
        pts.remove();
        var m = bolha('assistant', 'Falha de conexão. Tente de novo.');
        m.classList.add('sv-ia-erro');
      } finally {
        ocupado = false;
        enviar.disabled = false;
        rolar();
        input.focus();
      }
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      enviarPergunta(input.value);
    });

    document.querySelectorAll('.sv-ia-sug').forEach(function (b) {
      b.addEventListener('click', function () { enviarPergunta(b.getAttribute('data-q')); });
    });

    // --- Busca por voz (Web Speech API — transcrição no aparelho, sem custo) ---
    // Some o botão em quem não suporta (ex.: WKWebView do iOS). No app iOS, voz
    // confiável virá do plugin nativo junto do próximo rebuild.
    var mic = document.getElementById('ia-mic');
    var Recog = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (mic && Recog) {
      mic.hidden = false;
      var rec = null;
      var ouvindo = false;
      function pararEscuta() { ouvindo = false; mic.classList.remove('gravando'); }
      mic.addEventListener('click', function () {
        if (ouvindo) { try { rec && rec.stop(); } catch (e) {} return; }
        rec = new Recog();
        rec.lang = 'pt-BR';
        rec.interimResults = true;
        rec.continuous = false;
        var base = input.value ? input.value + ' ' : '';
        rec.onstart = function () { ouvindo = true; mic.classList.add('gravando'); input.focus(); };
        rec.onerror = pararEscuta;
        rec.onend = pararEscuta;
        rec.onresult = function (ev) {
          var txt = '';
          for (var i = 0; i < ev.results.length; i++) txt += ev.results[i][0].transcript;
          input.value = base + txt; // enche o campo; o usuário revisa e envia
        };
        try { rec.start(); } catch (e) { pararEscuta(); }
      });
    }
  })();
</script>
<% } %>
