<%
  function _iniciais(nome) {
    var p = String(nome).trim().split(/\s+/);
    return p.length > 1 ? (p[0][0] + p[p.length - 1][0]).toUpperCase() : p[0].slice(0, 2).toUpperCase();
  }
  function _rotuloStatus(s) {
    return { concluido: 'Concluído', agendado: 'Agendado', cancelado: 'Cancelado' }[s] || s;
  }
%>

<%
  var qsBarbeiro = ehAdmin ? '&barbeiro=' + barbeiroSelecionado : '';
%>

<%/* Cabeçalho no design TURNO 6 (2026-07-28): título grande + botão "Novo"
     preto, e o dia selecionado GRANDE com o mês num selo — o dia seguinte
     aparece em cinza ao lado e avança a data ao ser tocado. A tira de dias do
     mês inteiro saiu: na referência a troca de dia é pelo dia seguinte / pelo
     selo do mês (que abre o pop-up de escolher mês/ano). */%>
<div class="t6-agenda-topo">
  <div class="t6-agenda-titulo-linha">
    <div class="t6-agenda-titulo">AGENDA</div>
    <button type="button" class="t6-btn-novo" onclick="abrirModal('novo')">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      <span>Novo</span>
    </button>
  </div>

  <div class="t6-agenda-dica">
    <%= dataExtenso %><% if (ehAdmin) { %> · <a href="#" onclick="abrirModal('bloqueio');return false;">Bloquear horário</a><% } %>
  </div>

  <div class="t6-agenda-dias">
    <div class="t6-agenda-dia-col">
      <div class="t6-agenda-dia-num"><%= diaNum %></div>
      <%/* O selo do mês abre o pop-up de mês/ano (o mesmo de antes). */%>
      <button type="button" class="t6-agenda-mes" onclick="abrirModal('mes')"><%= mesLabel %></button>
    </div>
    <a href="/painel/agenda?data=<%= dataNext %><%= qsBarbeiro %>" class="t6-agenda-dia-prox" title="Próximo dia"><%= proxDiaNum %></a>
  </div>

  <% if (ehAdmin) { %>
    <div class="t6-agenda-barbeiros">
      <a href="/painel/agenda?data=<%= dataStr %>&barbeiro=todos" class="t6-chip <%= barbeiroSelecionado === 'todos' ? 'sel' : '' %>">Todos</a>
      <% barbeiros.forEach(function (b) { %>
        <a href="/painel/agenda?data=<%= dataStr %>&barbeiro=<%= b.id %>" class="t6-chip <%= barbeiroSelecionado === String(b.id) ? 'sel' : '' %>"><%= b.nome.split(' ')[0] %></a>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Pop-up: escolher mês (ano navegável + grade dos 12 meses) -->
<div class="ag-overlay" id="agm-mes" onclick="if(event.target===this)fecharModal(this)">
  <div class="ag-modal-box">
    <div class="ag-modal-topo">
      <div class="ag-modal-nome">Escolher mês</div>
      <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
    </div>
    <div class="ag2-ano-linha">
      <a href="/painel/agenda?data=<%= dataStr %><%= qsBarbeiro %>&anoPicker=<%= anoPicker - 1 %>" class="ag2-ano-seta" aria-label="Ano anterior">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      <span class="ag2-ano-num"><%= anoPicker %></span>
      <a href="/painel/agenda?data=<%= dataStr %><%= qsBarbeiro %>&anoPicker=<%= anoPicker + 1 %>" class="ag2-ano-seta" aria-label="Próximo ano">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </div>
    <div class="ag2-mes-grid">
      <% mesesPicker.forEach(function (m) { %>
        <a href="/painel/agenda?data=<%= m.iso %><%= qsBarbeiro %>" class="ag2-mes-opcao <%= m.atual ? 'sel' : '' %>"><%= m.nome %></a>
      <% }) %>
    </div>
  </div>
</div>

<%/* O botão flutuante "+" saiu no Turno 6 (2026-07-28): o cabeçalho já tem o
     botão "Novo" preto e o atalho de bloquear horário, então o FAB virava um
     terceiro jeito de fazer a mesma coisa — e a referência não tem nada
     flutuando sobre a lista. */%>

<% if (ehAdmin) { %>
  <div class="ag-overlay" id="agm-bloqueio" onclick="if(event.target===this)fecharModal(this)">
    <div class="ag-modal-box">
      <div class="ag-modal-topo">
        <div class="ag-modal-nome">Bloquear horário</div>
        <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
      </div>
      <form method="POST" action="/painel/agenda/bloqueios" class="form mt-16">
        <input type="hidden" name="data" value="<%= dataStr %>" />
        <input type="hidden" name="barbeiro" value="<%= barbeiroSelecionado %>" />
        <div class="grid-2">
          <div class="campo">
            <label for="bloq-barbeiro">Barbeiro</label>
            <select id="bloq-barbeiro" name="barbeiroId" required>
              <% barbeiros.forEach(function (b) { %>
                <option value="<%= b.id %>" <%= barbeiroSelecionado === String(b.id) ? 'selected' : '' %>><%= b.nome %></option>
              <% }) %>
            </select>
          </div>
          <div class="campo">
            <label for="bloq-motivo">Motivo (opcional)</label>
            <input id="bloq-motivo" name="motivo" placeholder="Almoço, folga…" />
          </div>
        </div>
        <div class="grid-2">
          <div class="campo">
            <label for="bloq-ini">Início</label>
            <input id="bloq-ini" type="time" name="horaInicio" required />
          </div>
          <div class="campo">
            <label for="bloq-fim">Fim</label>
            <input id="bloq-fim" type="time" name="horaFim" required />
          </div>
        </div>
        <div class="modal-acoes">
          <button type="button" class="modal-cancelar" onclick="fecharModal(this.closest('.ag-overlay'))">Cancelar</button>
          <button class="btn btn-primario">Bloquear</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<%/* "Novo agendamento" — FOLHA de página inteira (Turno 6, 2026-07-28): na
     referência não é diálogo, é uma página branca que entra deslizando e
     volta pelo quadrado cinza. Os campos são rótulo miúdo + valor grande
     separados por fio, e o rodapé é o cartão preto de confirmação.
     As pílulas de serviço/horário/barbeiro ficam (o app precisa delas pra
     checar disponibilidade — a referência tinha só texto livre). */%>
<div class="ag-overlay t6-folha" id="agm-novo">
  <div class="ag-modal-box">
    <button class="t6-folha-voltar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Voltar">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>

    <form method="POST" action="/painel/agenda/novo" id="form-novo-agendamento">
      <input type="hidden" name="data" value="<%= dataStr %>" />

      <div class="t6-folha-titulo">Novo<br>agendamento</div>

      <div style="margin-top:22px;">
        <div class="t6-campo autocomplete">
          <div class="t6-campo-rot">Cliente</div>
          <input class="t6-campo-input" id="cliente_nome-novo" name="cliente_nome" autocomplete="off" placeholder="Nome do cliente" required />
          <div id="sugestoes-cliente-novo" class="sugestoes"></div>
        </div>

        <div class="t6-campo">
          <div class="t6-campo-rot">Telefone</div>
          <input class="t6-campo-input" id="cliente_telefone-novo" name="cliente_telefone" inputmode="tel" placeholder="(51) 99999-9999" required />
        </div>

        <div class="t6-campo">
          <div class="t6-campo-rot">Serviço</div>
          <input type="hidden" name="servicoId" id="servicoId-novo" required />
          <div class="pill-group" id="pills-servico">
            <% servicos.forEach(function (s) { %>
              <button type="button" class="pill-opcao" data-id="<%= s.id %>" data-duracao="<%= s.duracaoMin %>"><%= s.nome %></button>
            <% }) %>
          </div>
        </div>

        <% if (ehAdmin) { %>
          <div class="t6-campo">
            <div class="t6-campo-rot">Barbeiro</div>
            <input type="hidden" name="barbeiroId" id="barbeiroId-novo" required value="<%= barbeiroSelecionado !== 'todos' ? barbeiroSelecionado : '' %>" />
            <div class="pill-group" id="pills-barbeiro">
              <% barbeiros.forEach(function (b) { %>
                <button type="button" class="pill-opcao <%= barbeiroSelecionado === String(b.id) ? 'ativo' : '' %>" data-id="<%= b.id %>"><%= b.nome %></button>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <input type="hidden" name="barbeiroId" id="barbeiroId-novo" value="<%= usuario.id %>" />
        <% } %>

        <div class="t6-campo">
          <div class="t6-campo-rot">Horário disponível <%= dataStr === hojeIso ? 'hoje' : '' %></div>
          <input type="hidden" name="hora" id="hora-novo" required />
          <div class="pill-group" id="pills-horario">
            <span class="texto-sutil"><%= ehAdmin ? 'Selecione o barbeiro.' : 'Carregando horários…' %></span>
          </div>
        </div>
      </div>

      <div class="t6-confirma-rot">Confirmar agendamento</div>
      <div class="t6-confirma">
        <div class="t6-confirma-barbeiro" id="resumo-barbeiro"><%= ehAdmin ? '' : usuario.nome %></div>
        <div class="t6-confirma-cliente" id="resumo-cliente">—</div>
        <div class="t6-confirma-servico" id="resumo-servico">Escolha o serviço</div>
        <div class="t6-confirma-hora" id="resumo-hora">--:--</div>
        <button class="t6-confirma-btn" type="submit">Agendar</button>
      </div>
    </form>
  </div>
</div>

<script>
  <%/* Espelha o que já foi preenchido no cartão preto de confirmação — na
       referência esse cartão mostra barbeiro/cliente/serviço/hora antes de
       agendar. */%>
  (function () {
    var form = document.getElementById('form-novo-agendamento');
    if (!form) return;
    var nome = document.getElementById('cliente_nome-novo');
    var resumo = {
      cliente: document.getElementById('resumo-cliente'),
      servico: document.getElementById('resumo-servico'),
      hora: document.getElementById('resumo-hora'),
      barbeiro: document.getElementById('resumo-barbeiro'),
    };
    function textoAtivo(grupoId) {
      var a = document.querySelector('#' + grupoId + ' .pill-opcao.ativo');
      return a ? a.textContent.trim() : '';
    }
    function atualizar() {
      resumo.cliente.textContent = (nome && nome.value.trim()) || '—';
      resumo.servico.textContent = textoAtivo('pills-servico') || 'Escolha o serviço';
      resumo.hora.textContent = textoAtivo('pills-horario') || '--:--';
      if (resumo.barbeiro && document.getElementById('pills-barbeiro')) {
        resumo.barbeiro.textContent = textoAtivo('pills-barbeiro');
      }
    }
    if (nome) nome.addEventListener('input', atualizar);
    form.addEventListener('click', function (e) {
      if (e.target.closest('.pill-opcao')) setTimeout(atualizar, 0);
    });
    atualizar();
  })();
</script>

<script>
  (function () {
    var clientes = <%- JSON.stringify(clientes) %>;
    var inputNome = document.getElementById('cliente_nome-novo');
    var inputTel = document.getElementById('cliente_telefone-novo');
    var box = document.getElementById('sugestoes-cliente-novo');

    function fmtTel(d) {
      d = (d || '').replace(/\D/g, '');
      if (d.length === 11) return '(' + d.slice(0, 2) + ') ' + d.slice(2, 7) + '-' + d.slice(7);
      if (d.length === 10) return '(' + d.slice(0, 2) + ') ' + d.slice(2, 6) + '-' + d.slice(6);
      return d;
    }
    function escapar(t) {
      return String(t).replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
      });
    }
    function fechar() { box.innerHTML = ''; box.style.display = 'none'; }
    function buscar(q) {
      q = q.trim().toLowerCase();
      if (!q) return [];
      var qDig = q.replace(/\D/g, '');
      return clientes.filter(function (c) {
        var nomeOk = c.nome.toLowerCase().indexOf(q) !== -1;
        var telOk = qDig && c.telefone.indexOf(qDig) !== -1;
        return nomeOk || telOk;
      }).slice(0, 8);
    }
    function render(lista) {
      if (!lista.length) { fechar(); return; }
      box.innerHTML = lista.map(function (c) {
        return '<button type="button" class="sugestao" data-nome="' + escapar(c.nome) +
          '" data-tel="' + c.telefone + '"><strong>' + escapar(c.nome) +
          '</strong><span>' + fmtTel(c.telefone) + '</span></button>';
      }).join('');
      box.style.display = 'block';
      Array.prototype.forEach.call(box.querySelectorAll('.sugestao'), function (btn) {
        btn.addEventListener('click', function () {
          inputNome.value = btn.getAttribute('data-nome');
          inputTel.value = fmtTel(btn.getAttribute('data-tel'));
          fechar();
          inputTel.focus();
        });
      });
    }
    inputNome.addEventListener('input', function () { render(buscar(inputNome.value)); });
    inputNome.addEventListener('focus', function () { render(buscar(inputNome.value)); });
    document.addEventListener('click', function (e) {
      if (!box.contains(e.target) && e.target !== inputNome) fechar();
    });
  })();
</script>

<script>
  // Pop-up "Novo agendamento": seleção por pílulas (serviço/barbeiro) em vez de
  // <select>, e o grid de horários é buscado do servidor sempre que o serviço
  // ou o barbeiro mudam (a duração do serviço afeta quais horários cabem).
  (function () {
    var form = document.getElementById('form-novo-agendamento');
    if (!form) return;
    var dataStr = '<%= dataStr %>';
    var servicoInput = document.getElementById('servicoId-novo');
    var barbeiroInput = document.getElementById('barbeiroId-novo');
    var horaInput = document.getElementById('hora-novo');
    var pillsHorario = document.getElementById('pills-horario');

    function ligarGrupo(containerId, hiddenInput, aoMudar) {
      var container = document.getElementById(containerId);
      if (!container) return;
      container.addEventListener('click', function (e) {
        var btn = e.target.closest('.pill-opcao');
        if (!btn || btn.classList.contains('indisponivel')) return;
        Array.prototype.forEach.call(container.querySelectorAll('.pill-opcao'), function (b) {
          b.classList.remove('ativo');
        });
        btn.classList.add('ativo');
        hiddenInput.value = btn.getAttribute('data-id');
        if (aoMudar) aoMudar();
      });
    }

    function buscarHorarios() {
      horaInput.value = '';
      if (!barbeiroInput || !barbeiroInput.value) {
        pillsHorario.innerHTML = '<span class="texto-sutil">Selecione o barbeiro.</span>';
        return;
      }
      // O serviço é opcional aqui: sem ele, mostra o grid com a duração
      // mínima (o servidor usa 0 = intervalo padrão); ao escolher o
      // serviço, o grid é refeito considerando a duração real dele.
      var qs = new URLSearchParams({ barbeiroId: barbeiroInput.value, data: dataStr, servicoId: servicoInput.value || '' });
      fetch('/painel/agenda/horarios?' + qs.toString())
        .then(function (r) { return r.json(); })
        .then(function (json) {
          var horarios = json.horarios || [];
          if (!horarios.length) {
            pillsHorario.innerHTML = '<span class="texto-sutil">Sem horários livres nesse dia.</span>';
            return;
          }
          pillsHorario.innerHTML = horarios.map(function (h) {
            return '<button type="button" class="pill-opcao' + (h.livre ? '' : ' indisponivel') + '" data-hora="' + h.hora + '">' + h.hora + '</button>';
          }).join('');
        })
        .catch(function () {
          pillsHorario.innerHTML = '<span class="texto-sutil">Não foi possível carregar os horários.</span>';
        });
    }

    pillsHorario.addEventListener('click', function (e) {
      var btn = e.target.closest('.pill-opcao');
      if (!btn || btn.classList.contains('indisponivel')) return;
      Array.prototype.forEach.call(pillsHorario.querySelectorAll('.pill-opcao'), function (b) {
        b.classList.remove('ativo');
      });
      btn.classList.add('ativo');
      horaInput.value = btn.getAttribute('data-hora');
    });

    ligarGrupo('pills-servico', servicoInput, buscarHorarios);
    if (barbeiroInput) ligarGrupo('pills-barbeiro', barbeiroInput, buscarHorarios);

    // Se já há um barbeiro pré-selecionado (funcionário, ou admin filtrando um
    // barbeiro específico na Agenda), já carrega os horários ao abrir.
    if (barbeiroInput && barbeiroInput.value) buscarHorarios();
  })();
</script>

<script>
  function abrirModal(id) {
    var o = document.getElementById('agm-' + id);
    if (o) { o.style.display = 'flex'; document.body.classList.add('modal-aberto'); }
  }
  function fecharModal(o) {
    if (o) { o.style.display = 'none'; document.body.classList.remove('modal-aberto'); }
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.ag-overlay').forEach(function (o) { o.style.display = 'none'; });
      document.body.classList.remove('modal-aberto');
    }
  });

  <%/* A tira de dias rolável e o carrossel com efeito de roleta saíram no
       Turno 6 (2026-07-28): a referência troca de dia pelo número do dia
       seguinte / pelo selo do mês, e a lista é de faixas empilhadas. Os
       scripts que centralizavam a tira e aplicavam scale/opacity nos cards
       foram removidos junto — não havia mais elemento nenhum pra eles. */%>
</script>

<div class="t6-agenda-lista">
<% if (agendamentos.length === 0 && bloqueios.length === 0) { %>
  <div class="t6-vazio">Nada agendado para esta data.</div>
<% } else { %>
  <%
    function _min(hhmm) { var p = String(hhmm).split(':'); return (+p[0]) * 60 + (+p[1]); }
    var eventos = [];
    agendamentos.forEach(function (ag) { eventos.push({ tipo: 'ag', ag: ag, ini: _min(ag.horaInicio) }); });
    bloqueios.forEach(function (bl) { eventos.push({ tipo: 'bloq', bl: bl, ini: _min(bl.horaInicio) }); });
    eventos.sort(function (a, b) { return a.ini - b.ini; });
  %>

  <%/* Turno 6 (2026-07-28): o carrossel vertical com scroll-snap saiu — na
       referência os atendimentos são faixas empilhadas separadas por fio, e o
       da vez sai invertido. Tocar numa faixa abre o pop-up de detalhe (que já
       existia em "Mais opções") — é lá que estão concluir, pagamento, itens e
       excluir, então nada de função se perdeu com o fim da expansão inline. */%>
  <div>
    <% eventos.forEach(function (e, i) { %>
      <% if (e.tipo === 'ag') { var ag = e.ag; %>
        <%
          var servicosLabel = ag.itens.map(function (it) { return it.servico.nome; }).join(' + ') || 'Atendimento';
          var formas = [['pix', 'Pix'], ['credito', 'Crédito'], ['debito', 'Débito'], ['dinheiro', 'Dinheiro']];
        %>
        <button type="button" onclick="abrirModal(<%= ag.id %>)" class="t6-linha <%= ag.id === proximoId ? 't6-linha--agora' : '' %> <%= ag.status === 'concluido' ? 't6-linha--feito' : '' %>">
          <span class="t6-linha-corpo">
            <span class="t6-linha-marca">
              <span class="t6-linha-ponto"></span>
              <% if (ag.status === 'concluido') { %>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" opacity="0.55" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <% } %>
            </span>
            <span class="t6-linha-cliente"><%= ag.clienteNome %></span>
            <span class="t6-linha-sub"><%= servicosLabel %><% if (mostrarBarbeiroNoCard) { %> · <%= ag.usuario.nome.split(' ')[0] %><% } %> · <%= fmtT6(ag.valorTotal) %></span>
          </span>
          <span class="t6-linha-hora"><%= ag.horaInicio %></span>
        </button>
      <% } else { var bl = e.bl; %>
        <div class="t6-linha t6-linha--bloqueio">
          <div class="t6-linha-corpo">
            <div class="t6-linha-marca"><span class="t6-linha-ponto"></span></div>
            <div class="t6-linha-cliente"><%= bl.motivo || 'Bloqueado' %></div>
            <div class="t6-linha-sub"><%= bl.horaInicio %>–<%= bl.horaFim %><% if (mostrarBarbeiroNoCard) { %> · <%= bl.usuario.nome.split(' ')[0] %><% } %></div>
          </div>
          <% if (ehAdmin) { %>
            <form method="POST" action="/painel/agenda/bloqueios/<%= bl.id %>/remover" onsubmit="return confirm('Remover este bloqueio?')">
              <input type="hidden" name="retornoData" value="<%= dataStr %>" />
              <input type="hidden" name="retornoBarbeiro" value="<%= barbeiroSelecionado %>" />
              <button title="Remover bloqueio" type="submit" class="t6-linha-x">×</button>
            </form>
          <% } %>
        </div>
      <% } %>
    <% }) %>
  </div>


  <% agendamentos.forEach(function (ag) { %>
    <%/* Detalhe do atendimento — FOLHA de página inteira (Turno 6, 2026-07-28):
         nome do cliente em manchete, os dados em campos separados por fio e o
         bloco preto do total sangrando até as bordas, com "Concluir
         atendimento" dentro dele. Itens e as ações destrutivas ficam abaixo. */%>
    <% var svcLabel = ag.itens.map(function (it) { return it.servico.nome; }).join(' + ') || 'Atendimento'; %>
    <div class="ag-overlay t6-folha" id="agm-<%= ag.id %>">
      <div class="ag-modal-box">
        <button class="t6-folha-voltar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Voltar">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>

        <div class="t6-folha-topo">
          <div class="t6-folha-cliente"><%= ag.clienteNome %></div>
          <div class="t6-folha-hora"><%= ag.horaInicio %></div>
        </div>

        <div style="margin-top:22px;">
          <div class="t6-campo">
            <div class="t6-campo-rot">Data e horário</div>
            <%/* Curto de propósito ("28 jul · 23:15"): a 30px, a data por
                 extenso não cabe na linha e é cortada por reticências. */%>
            <div class="t6-campo-val"><%= diaNum %> <%= mesLabel.toLowerCase().slice(0, 3) %> · <%= ag.horaInicio %></div>
          </div>
          <div class="t6-campo">
            <div class="t6-campo-rot">Serviço</div>
            <div class="t6-campo-val t6-campo-val--md"><%= svcLabel %></div>
          </div>
          <div class="t6-campo">
            <div class="t6-campo-rot">Barbeiro</div>
            <div class="t6-campo-val t6-campo-val--sm"><%= ag.usuario.nome %></div>
          </div>
          <div class="t6-campo">
            <div class="t6-campo-rot">Contato</div>
            <div class="t6-campo-val t6-campo-val--sm"><%= fmtTelefone(ag.clienteTelefone) %></div>
          </div>
        </div>

        <div class="t6-total">
          <div class="t6-total-linha">
            <div style="min-width:0;">
              <div class="t6-total-rot">Total a receber</div>
              <div class="t6-total-num"><%= fmtT6(ag.valorTotal) %></div>
            </div>
            <div class="t6-total-lado"><%= svcLabel %><br><%= ag.usuario.nome.split(' ')[0] %></div>
          </div>

          <% if (ag.status !== 'concluido') { %>
            <form method="POST" action="/painel/agenda/<%= ag.id %>/status">
              <input type="hidden" name="retornoData" value="<%= dataStr %>" />
              <input type="hidden" name="retornoBarbeiro" value="<%= barbeiroSelecionado %>" />
              <input type="hidden" name="status" value="concluido" />
              <button type="submit" class="t6-cta-claro">Concluir atendimento</button>
            </form>
          <% } else { %>
            <form method="POST" action="/painel/agenda/<%= ag.id %>/status">
              <input type="hidden" name="retornoData" value="<%= dataStr %>" />
              <input type="hidden" name="retornoBarbeiro" value="<%= barbeiroSelecionado %>" />
              <input type="hidden" name="status" value="agendado" />
              <button type="submit" class="t6-cta-vazado">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>Concluído · toque para reabrir</span>
              </button>
            </form>
          <% } %>
        </div>

        <div style="margin-top:20px;">
          <div class="t6-campo-rot">Itens</div>
          <ul class="itens">
            <% ag.itens.forEach(function (it) { %>
              <li>
                <span><%= it.servico.nome %><%= it.quantidade > 1 ? ' ×' + it.quantidade : '' %></span>
                <span class="itens-direita">
                  <span><%= fmtT6(it.valorUnitario * it.quantidade) %></span>
                  <form method="POST" action="/painel/agenda/itens/<%= it.id %>/remover" class="inline">
                    <input type="hidden" name="retornoData" value="<%= dataStr %>" />
                    <input type="hidden" name="retornoBarbeiro" value="<%= barbeiroSelecionado %>" />
                    <button class="btn-x" title="Remover item">×</button>
                  </form>
                </span>
              </li>
            <% }) %>
            <% if (ag.itens.length === 0) { %>
              <li><span class="texto-sutil">Sem itens.</span></li>
            <% } %>
          </ul>

          <form method="POST" action="/painel/agenda/<%= ag.id %>/itens" class="form-add-item">
            <input type="hidden" name="retornoData" value="<%= dataStr %>" />
            <input type="hidden" name="retornoBarbeiro" value="<%= barbeiroSelecionado %>" />
            <select name="servicoId" required>
              <option value="">Adicionar corte/produto…</option>
              <% servicos.forEach(function (s) { %>
                <option value="<%= s.id %>"><%= s.nome %> — <%= fmtT6(s.valor) %></option>
              <% }) %>
            </select>
            <input type="number" name="quantidade" value="1" min="1" class="input-qtd" title="Quantidade" />
            <button class="btn btn-secundario btn-sm">Adicionar</button>
          </form>

          <div class="agendamento-acoes">
            <% if (ag.status !== 'cancelado') { %>
              <form method="POST" action="/painel/agenda/<%= ag.id %>/status" class="inline">
                <input type="hidden" name="retornoData" value="<%= dataStr %>" />
                <input type="hidden" name="retornoBarbeiro" value="<%= barbeiroSelecionado %>" />
                <input type="hidden" name="status" value="cancelado" />
                <button class="btn btn-perigo btn-sm">Cancelar</button>
              </form>
            <% } %>
            <form method="POST" action="/painel/agenda/<%= ag.id %>/excluir" class="inline"
                  onsubmit="return confirm('Excluir este agendamento? Esta ação não pode ser desfeita.')">
              <input type="hidden" name="retornoData" value="<%= dataStr %>" />
              <input type="hidden" name="retornoBarbeiro" value="<%= barbeiroSelecionado %>" />
              <button class="btn btn-perigo btn-sm">Excluir</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
<% } %>
</div>
