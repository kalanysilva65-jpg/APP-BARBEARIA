<%/* Produtos no design SUAVE (pedido do dono, 2026-07-31): substitui as faixas
     sangradas do Turno 6 (foto de 112px encostada na borda, quatro tons de
     cinza alternados) pelo HTML de referência — cartão de resumo com o
     "vendido no mês" em 38px e, abaixo, um cartão branco por produto com a
     foto quadrada de 60px à esquerda e a seta à direita.
     O pop-up virou FOLHA INFERIOR. Nada de função saiu: criar, editar,
     ativar/desativar, excluir, foto, comissão e categorias continuam.

     O mockup mostra "{preço} · {N} em estoque" na segunda linha, mas o model
     Servico NÃO tem contagem (só Estoque, que são insumos internos, tem). No
     lugar da quantidade fica a categoria; o número de vendas do mês ocupa a
     terceira linha, como na referência.
     Estilos em public/css/sv-catalogo.css. */%>
<div class="sv-tela sv-cat-tela">
  <div class="sv-cat-topo sv-reveal">
    <div class="sv-cat-topo-linha">
      <h1 class="sv-cat-titulo">Produtos</h1>
      <button type="button" class="sv-cat-novo" onclick="abrirFolha('novo')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>Novo</span>
      </button>
    </div>
    <div class="sv-cat-dica">
      Toque em um produto para editar · <a href="#" onclick="abrirFolha('categorias');return false;">Categorias</a>
    </div>
  </div>

  <div class="sv-cartao sv-cat-resumo sv-reveal">
    <div class="sv-cat-resumo-rot">Vendido no mês</div>
    <%/* fmtT6 (sem centavos) só aqui, porque é o número de resumo. Na lista e
         na folha o preço sai com centavos. */%>
    <div class="sv-cat-resumo-num"><%= fmtT6(resumoMes.receita) %></div>
    <div class="sv-cat-resumo-selos">
      <span class="sv-cat-resumo-selo"><%= resumoMes.unidades %> un</span>
      <span class="sv-cat-resumo-selo"><%= resumoMes.itens %> produto<%= resumoMes.itens === 1 ? '' : 's' %></span>
    </div>
    <% if (resumoMes.topNome) { %>
      <div class="sv-cat-resumo-pe"><%= resumoMes.topNome %> lidera com <%= resumoMes.topQtd %> un</div>
    <% } %>
  </div>

  <% if (produtos.length === 0) { %>
    <div class="sv-cartao sv-cat-vazio sv-reveal">Nenhum produto cadastrado ainda.</div>
  <% } else { %>
    <div class="sv-cat-lista">
      <% produtos.forEach(function (p) { %>
        <button type="button" class="sv-cat-item sv-pr-item <%= p.ativo ? '' : 'sv-cat-item--inativo' %>" onclick="abrirFolha(<%= p.id %>)">
          <span class="sv-pr-foto">
            <% if (p.fotoUrl) { %>
              <img src="<%= p.fotoUrl %>" alt="Foto de <%= p.nome %>" />
            <% } else { %>
              Foto
            <% } %>
          </span>
          <span class="sv-pr-corpo">
            <span class="sv-pr-nome-linha">
              <span class="sv-pr-nome"><%= p.nome %></span>
              <% if (!p.ativo) { %><span class="sv-cat-selo sv-cat-selo--claro">Inativo</span><% } %>
            </span>
            <%/* fmtBRL e não fmtT6: é o preço de tabela, arredondar induziria
                 o dono a cobrar errado. */%>
            <span class="sv-pr-sub"><%= fmtBRL(p.valor) %> · <%= p.categoria ? p.categoria.nome : 'Sem categoria' %></span>
            <span class="sv-pr-venda"><b><%= p.vendidosMes %></b> vendidos · <%= fmtT6(p.receitaMes) %></span>
          </span>
          <svg class="sv-pr-seta" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      <% }) %>
      <div class="sv-cat-fim"></div>
    </div>
  <% } %>
</div>

<!-- Folha: novo produto (ehProduto vai fixo via campo oculto — aqui já
     sabemos que é produto, sem precisar de toggle). -->
<div class="sv-folha-fundo" id="svf-novo" hidden onclick="if(event.target===this)fecharFolha(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-cat-folha-topo">
      <div class="sv-folha-titulo">Novo produto</div>
      <button type="button" class="sv-cat-folha-x" onclick="fecharFolha(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <form method="POST" enctype="multipart/form-data" action="/painel/servicos">
      <input type="hidden" name="ehProduto" value="on" />
      <div class="sv-campo">
        <label class="sv-campo-rot" for="nome-novo">Nome</label>
        <input class="sv-campo-input" id="nome-novo" name="nome" placeholder="Ex.: Pomada modeladora" required />
      </div>
      <div class="sv-cat-dupla">
        <div class="sv-campo">
          <label class="sv-campo-rot" for="valor-novo">Preço (R$)</label>
          <input class="sv-campo-input" id="valor-novo" name="valor" type="number" step="0.01" min="0" placeholder="45,00" required />
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="comissaoPercentual-novo">Comissão (%)</label>
          <input class="sv-campo-input" id="comissaoPercentual-novo" name="comissaoPercentual" type="number" min="0" max="100" step="0.1" value="10" />
        </div>
      </div>
      <div class="sv-campo">
        <label class="sv-campo-rot" for="categoriaId-novo">Categoria</label>
        <select class="sv-campo-input sv-cat-select" id="categoriaId-novo" name="categoriaId">
          <option value="">Sem categoria</option>
          <% categorias.forEach(function (c) { %>
            <option value="<%= c.id %>"><%= c.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="sv-campo">
        <label class="sv-campo-rot" for="foto-novo">Foto</label>
        <input class="sv-campo-input sv-cat-arquivo" id="foto-novo" name="foto" type="file" accept="image/*" />
        <span class="sv-cat-ajuda">JPG, PNG ou WEBP, até 4 MB.</span>
      </div>
      <%- include('_consumo-estoque', { estoqueItens: estoqueItens, mapa: {} }) %>
      <button class="sv-btn sv-cat-btn" type="submit">Adicionar</button>
    </form>
  </div>
</div>

<!-- Folha de edição: uma por produto -->
<% produtos.forEach(function (p) { %>
  <div class="sv-folha-fundo" id="svf-<%= p.id %>" hidden onclick="if(event.target===this)fecharFolha(this)">
    <div class="sv-folha">
      <div class="sv-folha-puxador"></div>
      <div class="sv-cat-folha-topo">
        <div class="sv-folha-titulo"><%= p.nome %></div>
        <button type="button" class="sv-cat-folha-x" onclick="fecharFolha(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <form method="POST" enctype="multipart/form-data" action="/painel/servicos/<%= p.id %>">
        <input type="hidden" name="ehProduto" value="on" />
        <div class="sv-campo">
          <label class="sv-campo-rot" for="nome-<%= p.id %>">Nome</label>
          <input class="sv-campo-input" id="nome-<%= p.id %>" name="nome" value="<%= p.nome %>" required />
        </div>
        <div class="sv-cat-dupla">
          <div class="sv-campo">
            <label class="sv-campo-rot" for="valor-<%= p.id %>">Preço (R$)</label>
            <input class="sv-campo-input" id="valor-<%= p.id %>" name="valor" type="number" step="0.01" min="0" value="<%= (p.valor / 100).toFixed(2) %>" required />
          </div>
          <div class="sv-campo">
            <label class="sv-campo-rot" for="comissaoPercentual-<%= p.id %>">Comissão (%)</label>
            <input class="sv-campo-input" id="comissaoPercentual-<%= p.id %>" name="comissaoPercentual" type="number" min="0" max="100" step="0.1" value="<%= p.comissaoPercentual %>" />
          </div>
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="categoriaId-<%= p.id %>">Categoria</label>
          <select class="sv-campo-input sv-cat-select" id="categoriaId-<%= p.id %>" name="categoriaId">
            <option value="">Sem categoria</option>
            <% categorias.forEach(function (c) { %>
              <option value="<%= c.id %>" <%= p.categoriaId === c.id ? 'selected' : '' %>><%= c.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="foto-<%= p.id %>">Foto</label>
          <% if (p.fotoUrl) { %>
            <div class="sv-cat-foto"><img src="<%= p.fotoUrl %>" alt="Foto de <%= p.nome %>" /></div>
          <% } %>
          <input class="sv-campo-input sv-cat-arquivo" id="foto-<%= p.id %>" name="foto" type="file" accept="image/*" />
          <span class="sv-cat-ajuda">JPG, PNG ou WEBP, até 4 MB.<%= p.fotoUrl ? ' Enviar uma nova substitui a atual.' : '' %></span>
        </div>
        <%- include('_consumo-estoque', { estoqueItens: estoqueItens, mapa: (insumosPorServico && insumosPorServico[p.id]) || {} }) %>
        <button class="sv-btn sv-cat-btn" type="submit">Salvar alterações</button>
      </form>
      <%/* Mesma nota da referência, no mesmo lugar: o que o produto girou no
           mês, separado do formulário por um fio. */%>
      <div class="sv-cat-nota">
        <%= p.vendidosMes %> unidade<%= p.vendidosMes === 1 ? '' : 's' %> vendida<%= p.vendidosMes === 1 ? '' : 's' %> no mês · <%= fmtBRL(p.receitaMes) %>
      </div>
      <div class="sv-cat-acoes">
        <form method="POST" action="/painel/servicos/<%= p.id %>/toggle">
          <button class="sv-btn sv-cat-btn sv-cat-btn--sec" type="submit"><%= p.ativo ? 'Desativar' : 'Ativar' %></button>
        </form>
        <form method="POST" action="/painel/servicos/<%= p.id %>/remover"
              onsubmit="return confirm('Excluir este produto?')">
          <button class="sv-btn sv-cat-btn sv-cat-btn--sec" type="submit">Excluir produto</button>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<!-- Folha: categorias (compartilhadas com Serviços) -->
<div class="sv-folha-fundo" id="svf-categorias" hidden onclick="if(event.target===this)fecharFolha(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-cat-folha-topo">
      <div class="sv-folha-titulo">Categorias</div>
      <button type="button" class="sv-cat-folha-x" onclick="fecharFolha(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <p class="sv-cat-cats-sub">Remover uma categoria não apaga os itens — eles ficam "sem categoria".</p>
    <form method="POST" action="/painel/servicos/categorias" class="sv-cat-cat-form">
      <input type="hidden" name="retorno" value="produtos" />
      <input class="sv-campo-input" name="nome" placeholder="Nova categoria" required />
      <button class="sv-cat-cat-btn" type="submit">Adicionar</button>
    </form>
    <% categorias.forEach(function (c) { %>
      <div class="sv-cat-cat-linha">
        <form method="POST" action="/painel/servicos/categorias/<%= c.id %>" class="sv-cat-cat-form">
          <input type="hidden" name="retorno" value="produtos" />
          <input class="sv-campo-input" name="nome" value="<%= c.nome %>" aria-label="Nome da categoria" />
          <span class="sv-cat-cat-conta"><%= c._count.servicos %></span>
          <button class="sv-cat-cat-btn" type="submit">Salvar</button>
        </form>
        <form method="POST" action="/painel/servicos/categorias/<%= c.id %>/remover?retorno=produtos" onsubmit="return confirm('Remover esta categoria?')">
          <button class="sv-cat-cat-x" type="submit" title="Remover categoria">×</button>
        </form>
      </div>
    <% }) %>
    <% if (categorias.length === 0) { %><p class="sv-cat-cats-sub">Nenhuma categoria.</p><% } %>
  </div>
</div>

<script>
  // A folha usa o atributo `hidden` (e não style.display) porque é assim que
  // o suave.css a esconde: `.sv-folha-fundo[hidden] { display:none }`.
  function abrirFolha(id) {
    var f = document.getElementById('svf-' + id);
    if (f) { f.hidden = false; document.body.classList.add('modal-aberto'); }
  }
  function fecharFolha(f) {
    if (f) { f.hidden = true; document.body.classList.remove('modal-aberto'); }
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.sv-folha-fundo').forEach(function (f) { f.hidden = true; });
      document.body.classList.remove('modal-aberto');
    }
  });
</script>
