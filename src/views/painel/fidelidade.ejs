<%
  var nomeBarbearia = (typeof barbeariaAtual !== 'undefined' && barbeariaAtual) ? barbeariaAtual.nome : 'Barbearia';
%>

<!-- Cabeçalho: título + subtítulo centralizados (igual Planos) e "+" sem
     círculo (abre "Novo cupom", escurece atrás) — é assim no HTML original. -->
<div class="ag2-topo">
  <div class="ag2-marca-linha">
    <span class="ag2-avatar-deco"></span>
    <span class="ag2-marca ag2-marca--escura"><%= nomeBarbearia %></span>
    <button type="button" class="ag2-add" onclick="abrirModal('novo')" aria-label="Novo cupom">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
    </button>
  </div>
  <div class="ag2-titulo">Fidelidade</div>
  <div class="ag2-subtitulo">Selos, cupons e clientes mais fiéis</div>

  <div class="fid-stats">
    <div class="fid-stat">
      <div class="fid-stat-num"><%= fidClientesFieisCount %></div>
      <div class="fid-stat-label">Clientes fiéis</div>
    </div>
    <div class="fid-stat">
      <div class="fid-stat-num"><%= fidCuponsAtivosCount %></div>
      <div class="fid-stat-label">Cupons ativos</div>
    </div>
    <div class="fid-stat">
      <div class="fid-stat-num"><%= fidResgatesMes %></div>
      <div class="fid-stat-label">Resgates/mês</div>
    </div>
  </div>
</div>

<div class="ag2-corpo">
  <div class="fid-secao-titulo">CUPONS E PROMOÇÕES</div>
  <% if (cupons.length === 0) { %>
    <div class="ag2-vazio">Nenhum cupom cadastrado ainda.</div>
  <% } else { %>
    <div class="fid-lista">
      <% cupons.forEach(function (cp) { %>
        <div class="fid-cupom-card <%= !cp.ativo ? 'fid-cupom-card--inativo' : '' %>">
          <div>
            <div class="fid-cupom-nome"><%= cp.nome %></div>
            <% if (cp.descricao) { %><div class="fid-cupom-desc"><%= cp.descricao %></div><% } %>
            <div class="fid-cupom-validade">Válido até <%= fmtData(cp.validade) %></div>
          </div>
          <div class="fid-cupom-acoes">
            <span class="fid-cupom-desconto"><%= cp.desconto %></span>
            <form method="POST" action="/painel/fidelidade/cupons/<%= cp.id %>/remover" onsubmit="return confirm('Remover este cupom?')">
              <button type="submit" class="fid-cupom-remover">Remover</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="fid-secao-titulo fid-secao-titulo--espacada">RANKING DE CLIENTES FIÉIS</div>
  <% if (fidRanking.length === 0) { %>
    <div class="ag2-vazio">Nenhum cliente com selos ainda.</div>
  <% } else { %>
    <div class="fid-lista">
      <% fidRanking.forEach(function (fc) { %>
        <div class="fid-rank-card">
          <span class="fid-rank-num"><%= fc.rank %></span>
          <span class="fid-rank-avatar"><%= fc.initials %></span>
          <span class="fid-rank-info">
            <span class="fid-rank-nome"><%= fc.name %></span>
            <span class="fid-rank-selos"><%= fc.loyalty %> selo<%= fc.loyalty === 1 ? '' : 's' %> acumulado<%= fc.loyalty === 1 ? '' : 's' %></span>
          </span>
          <form method="POST" action="/painel/fidelidade/clientes/<%= fc.id %>/resgatar" class="inline" onsubmit="return confirm('Resgatar ' + <%- JSON.stringify(fc.loyalty) %> + ' selo(s) de ' + <%- JSON.stringify(fc.name) %> + '?')">
            <button type="submit" class="fid-rank-resgatar">Resgatar</button>
          </form>
          <form method="POST" action="/painel/fidelidade/clientes/<%= fc.id %>/selo" class="inline">
            <button type="submit" class="fid-rank-add" aria-label="Adicionar selo">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Pop-up: novo cupom (escurece atrás, igual Serviços/Planos). -->
<div class="ag-overlay" id="agm-novo" onclick="if(event.target===this)fecharModal(this)">
  <div class="ag-modal-box">
    <div class="ag-modal-topo">
      <div class="ag-modal-nome">Novo cupom</div>
      <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
    </div>
    <form method="POST" action="/painel/fidelidade/cupons" class="form mt-16">
      <div class="campo">
        <label for="cupom-nome">Nome do cupom</label>
        <input id="cupom-nome" name="nome" required />
      </div>
      <div class="campo">
        <label for="cupom-desc">Descrição <span class="texto-sutil">(opcional)</span></label>
        <input id="cupom-desc" name="descricao" />
      </div>
      <div class="campo">
        <label for="cupom-desconto">Desconto <span class="texto-sutil">(ex.: 20% ou R$15)</span></label>
        <input id="cupom-desconto" name="desconto" placeholder="20%" required />
      </div>
      <div class="campo">
        <label for="cupom-validade">Válido até</label>
        <input id="cupom-validade" name="validade" type="date" value="<%= hojeIso %>" required />
      </div>
      <div class="modal-acoes">
        <button type="button" class="modal-cancelar" onclick="fecharModal(this.closest('.ag-overlay'))">Cancelar</button>
        <button class="btn btn-primario" type="submit">Adicionar</button>
      </div>
    </form>
  </div>
</div>

<script>
  function abrirModal(id) {
    var o = document.getElementById('agm-' + id);
    if (o) { o.style.display = 'flex'; document.body.classList.add('modal-aberto'); }
  }
  function fecharModal(o) {
    if (o) { o.style.display = 'none'; document.body.classList.remove('modal-aberto'); }
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.ag-overlay').forEach(function (o) { o.style.display = 'none'; });
      document.body.classList.remove('modal-aberto');
    }
  });
</script>
