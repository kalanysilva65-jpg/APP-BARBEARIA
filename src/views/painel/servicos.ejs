<%/* Serviços no design TURNO 6 (pedido do dono, 2026-07-28): segue o HTML de
     referência — título em caixa alta, botão "Novo" preto e a lista sem
     cartão nenhum: cada serviço é um bloco separado por fio, com duração e
     preço nas pontas e o NOME centralizado em manchete de 34px.
     A grade de 2 colunas (`.sv-grid`/`.sv-tile`) saiu junto com o tema
     escuro; nada de função se perdeu — editar, ativar/desativar, excluir e
     as categorias continuam, agora em pop-up. */%>
<div class="t6-cat-tela">
  <div class="t6-cat-topo">
    <div class="t6-cat-titulo-linha">
      <div class="t6-cat-titulo">SERVIÇOS</div>
      <button type="button" class="t6-btn-novo" onclick="abrirModal('novo')">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>Novo</span>
      </button>
    </div>
    <%/* As categorias não existem na referência; em vez de virarem um bloco
         solto no fim da lista, viram um atalho aqui na dica. */%>
    <div class="t6-cat-dica">
      Toque em um serviço para editar · <a href="#" onclick="abrirModal('categorias');return false;">Categorias</a>
    </div>
  </div>

  <div class="t6-sv-lista">
    <% if (servicos.length === 0) { %>
      <div class="t6-vazio">Nenhum serviço cadastrado ainda.</div>
    <% } else { %>
      <% servicos.forEach(function (s) { %>
        <button type="button" class="t6-sv-card <%= s.ativo ? '' : 't6-sv-card--inativo' %>" onclick="abrirModal(<%= s.id %>)">
          <span class="t6-sv-card-topo">
            <span class="t6-sv-dur"><%= s.duracaoMin ? s.duracaoMin + ' min' : 'Sem horário' %></span>
            <%/* fmtBRL e não fmtT6 aqui: numa tabela de preços, "R$39,90"
                 arredondado para "R$40" faria o dono cobrar errado. */%>
            <span class="t6-sv-preco"><%= fmtBRL(s.valor) %></span>
          </span>
          <span class="t6-sv-nome"><%= s.nome %></span>
          <span class="t6-sv-label"><%= s.categoria ? s.categoria.nome : 'Sem categoria' %><% if (s.descricao) { %> · <%= s.descricao %><% } %></span>
          <% if (!s.ativo) { %>
            <span class="t6-sv-selo-linha"><span class="t6-cat-selo">Inativo</span></span>
          <% } %>
        </button>
      <% }) %>
      <div class="t6-cat-fim"></div>
    <% } %>
  </div>
</div>

<!-- Pop-up: novo serviço (sem o toggle "é produto" — Produtos é outra tela;
     sem comissão de produto, que não se aplica a serviço). -->
<div class="ag-overlay" id="agm-novo" onclick="if(event.target===this)fecharModal(this)">
  <div class="ag-modal-box">
    <div class="ag-modal-topo">
      <div class="t6-cat-dlg-titulo">Novo serviço</div>
      <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
    </div>
    <form method="POST" enctype="multipart/form-data" action="/painel/servicos" style="margin-top:16px;">
      <div class="t6-cat-campo">
        <label class="t6-cat-rot" for="nome-novo">Nome</label>
        <input class="t6-cat-input" id="nome-novo" name="nome" placeholder="Ex.: Corte simples" required />
      </div>
      <div class="t6-cat-dupla">
        <div class="t6-cat-campo">
          <label class="t6-cat-rot" for="valor-novo">Preço (R$)</label>
          <input class="t6-cat-input" id="valor-novo" name="valor" type="number" step="0.01" min="0" placeholder="35,00" required />
        </div>
        <div class="t6-cat-campo">
          <label class="t6-cat-rot" for="duracaoMin-novo">Duração (min)</label>
          <input class="t6-cat-input" id="duracaoMin-novo" name="duracaoMin" type="number" min="0" value="30" />
        </div>
      </div>
      <div class="t6-cat-campo">
        <label class="t6-cat-rot" for="categoriaId-novo">Categoria</label>
        <select class="t6-cat-input" id="categoriaId-novo" name="categoriaId">
          <option value="">Sem categoria</option>
          <% categorias.forEach(function (c) { %>
            <option value="<%= c.id %>"><%= c.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="t6-cat-campo">
        <label class="t6-cat-rot" for="descricao-novo">Descrição</label>
        <textarea class="t6-cat-input" id="descricao-novo" name="descricao" rows="2" maxlength="80" placeholder="O que está incluso"></textarea>
      </div>
      <div class="t6-cat-campo">
        <label class="t6-cat-rot" for="foto-novo">Foto</label>
        <input class="t6-cat-input" id="foto-novo" name="foto" type="file" accept="image/*" />
        <span class="t6-cat-ajuda">JPG, PNG ou WEBP, até 4 MB.</span>
      </div>
      <button class="t6-cat-btn" type="submit">Adicionar</button>
    </form>
  </div>
</div>

<!-- Pop-up de edição: um por serviço -->
<% servicos.forEach(function (s) { %>
  <div class="ag-overlay" id="agm-<%= s.id %>" onclick="if(event.target===this)fecharModal(this)">
    <div class="ag-modal-box">
      <div class="ag-modal-topo">
        <div class="t6-cat-dlg-titulo"><%= s.nome %></div>
        <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
      </div>
      <form method="POST" enctype="multipart/form-data" action="/painel/servicos/<%= s.id %>" style="margin-top:16px;">
        <div class="t6-cat-campo">
          <label class="t6-cat-rot" for="nome-<%= s.id %>">Nome</label>
          <input class="t6-cat-input" id="nome-<%= s.id %>" name="nome" value="<%= s.nome %>" required />
        </div>
        <div class="t6-cat-dupla">
          <div class="t6-cat-campo">
            <label class="t6-cat-rot" for="valor-<%= s.id %>">Preço (R$)</label>
            <input class="t6-cat-input" id="valor-<%= s.id %>" name="valor" type="number" step="0.01" min="0" value="<%= (s.valor / 100).toFixed(2) %>" required />
          </div>
          <div class="t6-cat-campo">
            <label class="t6-cat-rot" for="duracaoMin-<%= s.id %>">Duração (min)</label>
            <input class="t6-cat-input" id="duracaoMin-<%= s.id %>" name="duracaoMin" type="number" min="0" value="<%= s.duracaoMin %>" />
          </div>
        </div>
        <div class="t6-cat-campo">
          <label class="t6-cat-rot" for="categoriaId-<%= s.id %>">Categoria</label>
          <select class="t6-cat-input" id="categoriaId-<%= s.id %>" name="categoriaId">
            <option value="">Sem categoria</option>
            <% categorias.forEach(function (c) { %>
              <option value="<%= c.id %>" <%= s.categoriaId === c.id ? 'selected' : '' %>><%= c.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="t6-cat-campo">
          <label class="t6-cat-rot" for="descricao-<%= s.id %>">Descrição</label>
          <textarea class="t6-cat-input" id="descricao-<%= s.id %>" name="descricao" rows="2" maxlength="80"><%= s.descricao || '' %></textarea>
        </div>
        <div class="t6-cat-campo">
          <label class="t6-cat-rot" for="foto-<%= s.id %>">Foto</label>
          <% if (s.fotoUrl) { %>
            <div class="t6-cat-foto"><img src="<%= s.fotoUrl %>" alt="Foto de <%= s.nome %>" /></div>
          <% } %>
          <input class="t6-cat-input" id="foto-<%= s.id %>" name="foto" type="file" accept="image/*" />
          <span class="t6-cat-ajuda">JPG, PNG ou WEBP, até 4 MB.<%= s.fotoUrl ? ' Enviar uma nova substitui a atual.' : '' %></span>
        </div>
        <button class="t6-cat-btn" type="submit">Salvar alterações</button>
      </form>
      <div class="t6-cat-acoes">
        <form method="POST" action="/painel/servicos/<%= s.id %>/toggle">
          <button class="t6-cat-btn t6-cat-btn--vazado" type="submit"><%= s.ativo ? 'Desativar' : 'Ativar' %></button>
        </form>
        <form method="POST" action="/painel/servicos/<%= s.id %>/remover"
              onsubmit="return confirm('Excluir este serviço?')">
          <button class="t6-cat-btn t6-cat-btn--vazado" type="submit">Excluir serviço</button>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<!-- Pop-up: categorias (compartilhadas com Produtos) -->
<div class="ag-overlay" id="agm-categorias" onclick="if(event.target===this)fecharModal(this)">
  <div class="ag-modal-box">
    <div class="ag-modal-topo">
      <div class="t6-cat-dlg-titulo">Categorias</div>
      <button class="ag-modal-fechar" type="button" onclick="fecharModal(this.closest('.ag-overlay'))" aria-label="Fechar">×</button>
    </div>
    <p class="t6-cat-cats-sub">Remover uma categoria não apaga os itens — eles ficam "sem categoria".</p>
    <form method="POST" action="/painel/servicos/categorias" class="t6-cat-cat-form">
      <input type="hidden" name="retorno" value="servicos" />
      <input class="t6-cat-input" name="nome" placeholder="Nova categoria" required />
      <button class="t6-cat-cat-btn" type="submit">Adicionar</button>
    </form>
    <% categorias.forEach(function (c) { %>
      <div class="t6-cat-cat-linha">
        <form method="POST" action="/painel/servicos/categorias/<%= c.id %>" class="t6-cat-cat-form">
          <input type="hidden" name="retorno" value="servicos" />
          <input class="t6-cat-input" name="nome" value="<%= c.nome %>" aria-label="Nome da categoria" />
          <span class="t6-cat-cat-conta"><%= c._count.servicos %></span>
          <button class="t6-cat-cat-btn" type="submit">Salvar</button>
        </form>
        <form method="POST" action="/painel/servicos/categorias/<%= c.id %>/remover?retorno=servicos" onsubmit="return confirm('Remover esta categoria?')">
          <button class="t6-cat-cat-x" type="submit" title="Remover categoria">×</button>
        </form>
      </div>
    <% }) %>
    <% if (categorias.length === 0) { %><p class="t6-cat-cats-sub">Nenhuma categoria.</p><% } %>
  </div>
</div>

<script>
  function abrirModal(id) {
    var o = document.getElementById('agm-' + id);
    if (o) { o.style.display = 'flex'; document.body.classList.add('modal-aberto'); }
  }
  function fecharModal(o) {
    if (o) { o.style.display = 'none'; document.body.classList.remove('modal-aberto'); }
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.ag-overlay').forEach(function (o) { o.style.display = 'none'; });
      document.body.classList.remove('modal-aberto');
    }
  });
</script>
