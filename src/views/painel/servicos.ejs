<%/* Serviços no design SUAVE (pedido do dono, 2026-07-31): substitui a lista
     editorial do Turno 6 (nome em manchete de 34px, separação por fio) pelo
     HTML de referência que ele anexou — título de 26px com o botão-pílula
     "Novo" ao lado e, abaixo, um cartão branco arredondado por serviço com
     ladrilho do ícone à esquerda e o preço à direita.
     A outra troca é o pop-up: no Turno 6 era um diálogo centrado, aqui é
     FOLHA INFERIOR (sobe de baixo). Nada de função saiu: criar, editar,
     ativar/desativar, excluir, foto, descrição e as categorias continuam.
     Estilos em public/css/sv-catalogo.css. */%>
<div class="sv-tela sv-cat-tela">
  <div class="sv-cat-topo sv-reveal">
    <div class="sv-cat-topo-linha">
      <h1 class="sv-cat-titulo">Serviços</h1>
      <button type="button" class="sv-cat-novo" onclick="abrirFolha('novo')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>Novo</span>
      </button>
    </div>
    <%/* As categorias não existem na referência; em vez de virarem um bloco
         solto no fim da lista, viram um atalho aqui na dica. */%>
    <div class="sv-cat-dica">
      Toque em um serviço para editar · <a href="#" onclick="abrirFolha('categorias');return false;">Categorias</a>
    </div>
  </div>

  <% if (servicos.length === 0) { %>
    <div class="sv-cartao sv-cat-vazio sv-reveal">Nenhum serviço cadastrado ainda.</div>
  <% } else { %>
    <div class="sv-cat-lista">
      <% servicos.forEach(function (s) { %>
        <button type="button" class="sv-cat-item sv-sv-item <%= s.ativo ? '' : 'sv-cat-item--inativo' %>" onclick="abrirFolha(<%= s.id %>)">
          <%/* O ladrilho mostra a foto quando existe — é o único lugar do
               painel onde o dono confere o que o cliente vê no agendamento. */%>
          <span class="sv-sv-ic">
            <% if (s.fotoUrl) { %>
              <img src="<%= s.fotoUrl %>" alt="" />
            <% } else { %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2.6"/><circle cx="6" cy="18" r="2.6"/><path d="M20 4 8.6 16.5M20 20 8.6 7.5"/></svg>
            <% } %>
          </span>
          <span class="sv-sv-corpo">
            <span class="sv-sv-nome-linha">
              <span class="sv-sv-nome"><%= s.nome %></span>
              <% if (!s.ativo) { %><span class="sv-cat-selo sv-cat-selo--claro">Inativo</span><% } %>
            </span>
            <%/* Duração · categoria vêm da referência; a descrição entra no
                 fim da MESMA linha (corta com reticências) para não sumir da
                 lista como sumiria num cartão de duas linhas. */%>
            <span class="sv-sv-sub"><%= s.duracaoMin ? s.duracaoMin + ' min' : 'Sem horário' %> · <%= s.categoria ? s.categoria.nome : 'Sem categoria' %><% if (s.descricao) { %> · <%= s.descricao %><% } %></span>
          </span>
          <%/* fmtBRL e não fmtT6: numa tabela de preços, "R$39,90"
               arredondado para "R$40" faria o dono cobrar errado. */%>
          <span class="sv-sv-preco"><%= fmtBRL(s.valor) %></span>
        </button>
      <% }) %>
      <div class="sv-cat-fim"></div>
    </div>
  <% } %>
</div>

<!-- Folha: novo serviço (sem o toggle "é produto" — Produtos é outra tela;
     sem comissão de produto, que não se aplica a serviço). -->
<div class="sv-folha-fundo" id="svf-novo" hidden onclick="if(event.target===this)fecharFolha(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-cat-folha-topo">
      <div class="sv-folha-titulo">Novo serviço</div>
      <button type="button" class="sv-cat-folha-x" onclick="fecharFolha(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <form method="POST" enctype="multipart/form-data" action="/painel/servicos">
      <div class="sv-campo">
        <label class="sv-campo-rot" for="nome-novo">Nome</label>
        <input class="sv-campo-input" id="nome-novo" name="nome" placeholder="Ex.: Corte simples" required />
      </div>
      <div class="sv-cat-dupla">
        <div class="sv-campo">
          <label class="sv-campo-rot" for="valor-novo">Preço (R$)</label>
          <input class="sv-campo-input" id="valor-novo" name="valor" type="number" step="0.01" min="0" placeholder="35,00" required />
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="duracaoMin-novo">Duração (min)</label>
          <input class="sv-campo-input" id="duracaoMin-novo" name="duracaoMin" type="number" min="0" value="30" />
        </div>
      </div>
      <div class="sv-campo">
        <label class="sv-campo-rot" for="categoriaId-novo">Categoria</label>
        <select class="sv-campo-input sv-cat-select" id="categoriaId-novo" name="categoriaId">
          <option value="">Sem categoria</option>
          <% categorias.forEach(function (c) { %>
            <option value="<%= c.id %>"><%= c.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="sv-campo">
        <label class="sv-campo-rot" for="descricao-novo">Descrição</label>
        <textarea class="sv-campo-input" id="descricao-novo" name="descricao" rows="2" maxlength="80" placeholder="O que está incluso"></textarea>
      </div>
      <div class="sv-campo">
        <label class="sv-campo-rot" for="foto-novo">Foto</label>
        <input class="sv-campo-input sv-cat-arquivo" id="foto-novo" name="foto" type="file" accept="image/*" />
        <span class="sv-cat-ajuda">JPG, PNG ou WEBP, até 4 MB.</span>
      </div>
      <button class="sv-btn sv-cat-btn" type="submit">Adicionar</button>
    </form>
  </div>
</div>

<!-- Folha de edição: uma por serviço -->
<% servicos.forEach(function (s) { %>
  <div class="sv-folha-fundo" id="svf-<%= s.id %>" hidden onclick="if(event.target===this)fecharFolha(this)">
    <div class="sv-folha">
      <div class="sv-folha-puxador"></div>
      <div class="sv-cat-folha-topo">
        <div class="sv-folha-titulo"><%= s.nome %></div>
        <button type="button" class="sv-cat-folha-x" onclick="fecharFolha(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <form method="POST" enctype="multipart/form-data" action="/painel/servicos/<%= s.id %>">
        <div class="sv-campo">
          <label class="sv-campo-rot" for="nome-<%= s.id %>">Nome</label>
          <input class="sv-campo-input" id="nome-<%= s.id %>" name="nome" value="<%= s.nome %>" required />
        </div>
        <div class="sv-cat-dupla">
          <div class="sv-campo">
            <label class="sv-campo-rot" for="valor-<%= s.id %>">Preço (R$)</label>
            <input class="sv-campo-input" id="valor-<%= s.id %>" name="valor" type="number" step="0.01" min="0" value="<%= (s.valor / 100).toFixed(2) %>" required />
          </div>
          <div class="sv-campo">
            <label class="sv-campo-rot" for="duracaoMin-<%= s.id %>">Duração (min)</label>
            <input class="sv-campo-input" id="duracaoMin-<%= s.id %>" name="duracaoMin" type="number" min="0" value="<%= s.duracaoMin %>" />
          </div>
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="categoriaId-<%= s.id %>">Categoria</label>
          <select class="sv-campo-input sv-cat-select" id="categoriaId-<%= s.id %>" name="categoriaId">
            <option value="">Sem categoria</option>
            <% categorias.forEach(function (c) { %>
              <option value="<%= c.id %>" <%= s.categoriaId === c.id ? 'selected' : '' %>><%= c.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="descricao-<%= s.id %>">Descrição</label>
          <textarea class="sv-campo-input" id="descricao-<%= s.id %>" name="descricao" rows="2" maxlength="80"><%= s.descricao || '' %></textarea>
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="foto-<%= s.id %>">Foto</label>
          <% if (s.fotoUrl) { %>
            <div class="sv-cat-foto"><img src="<%= s.fotoUrl %>" alt="Foto de <%= s.nome %>" /></div>
          <% } %>
          <input class="sv-campo-input sv-cat-arquivo" id="foto-<%= s.id %>" name="foto" type="file" accept="image/*" />
          <span class="sv-cat-ajuda">JPG, PNG ou WEBP, até 4 MB.<%= s.fotoUrl ? ' Enviar uma nova substitui a atual.' : '' %></span>
        </div>
        <button class="sv-btn sv-cat-btn" type="submit">Salvar alterações</button>
      </form>
      <div class="sv-cat-acoes">
        <form method="POST" action="/painel/servicos/<%= s.id %>/toggle">
          <button class="sv-btn sv-cat-btn sv-cat-btn--sec" type="submit"><%= s.ativo ? 'Desativar' : 'Ativar' %></button>
        </form>
        <form method="POST" action="/painel/servicos/<%= s.id %>/remover"
              onsubmit="return confirm('Excluir este serviço?')">
          <button class="sv-btn sv-cat-btn sv-cat-btn--sec" type="submit">Excluir serviço</button>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<!-- Folha: categorias (compartilhadas com Produtos) -->
<div class="sv-folha-fundo" id="svf-categorias" hidden onclick="if(event.target===this)fecharFolha(this)">
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-cat-folha-topo">
      <div class="sv-folha-titulo">Categorias</div>
      <button type="button" class="sv-cat-folha-x" onclick="fecharFolha(this.closest('.sv-folha-fundo'))" aria-label="Fechar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <p class="sv-cat-cats-sub">Remover uma categoria não apaga os itens — eles ficam "sem categoria".</p>
    <form method="POST" action="/painel/servicos/categorias" class="sv-cat-cat-form">
      <input type="hidden" name="retorno" value="servicos" />
      <input class="sv-campo-input" name="nome" placeholder="Nova categoria" required />
      <button class="sv-cat-cat-btn" type="submit">Adicionar</button>
    </form>
    <% categorias.forEach(function (c) { %>
      <div class="sv-cat-cat-linha">
        <form method="POST" action="/painel/servicos/categorias/<%= c.id %>" class="sv-cat-cat-form">
          <input type="hidden" name="retorno" value="servicos" />
          <input class="sv-campo-input" name="nome" value="<%= c.nome %>" aria-label="Nome da categoria" />
          <span class="sv-cat-cat-conta"><%= c._count.servicos %></span>
          <button class="sv-cat-cat-btn" type="submit">Salvar</button>
        </form>
        <form method="POST" action="/painel/servicos/categorias/<%= c.id %>/remover?retorno=servicos" onsubmit="return confirm('Remover esta categoria?')">
          <button class="sv-cat-cat-x" type="submit" title="Remover categoria">×</button>
        </form>
      </div>
    <% }) %>
    <% if (categorias.length === 0) { %><p class="sv-cat-cats-sub">Nenhuma categoria.</p><% } %>
  </div>
</div>

<script>
  // A folha usa o atributo `hidden` (e não style.display) porque é assim que
  // o suave.css a esconde: `.sv-folha-fundo[hidden] { display:none }`.
  function abrirFolha(id) {
    var f = document.getElementById('svf-' + id);
    if (f) { f.hidden = false; document.body.classList.add('modal-aberto'); }
  }
  function fecharFolha(f) {
    if (f) { f.hidden = true; document.body.classList.remove('modal-aberto'); }
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.sv-folha-fundo').forEach(function (f) { f.hidden = true; });
      document.body.classList.remove('modal-aberto');
    }
  });
</script>
