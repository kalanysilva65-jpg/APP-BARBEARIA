<%/* Lista de conversas (partial). Usado na página e no endpoint /fragmento (auto-
     atualização). Auto-contido: define seu próprio `inic`. Sem sv-reveal quando
     vem do polling (`polling`), pra não re-animar a cada atualização. */%>
<%
  function inic(nome) { var p = (nome || '?').trim().split(/\s+/); return ((p[0] || '?')[0] + (p[1] ? p[1][0] : '')).toUpperCase(); }
%>
<% if (!conversas || conversas.length === 0) { %>
  <div class="sv-cartao sv-cv-vazio<%= typeof polling !== 'undefined' && polling ? '' : ' sv-reveal' %>">Nenhuma conversa ainda. Quando o WhatsApp estiver ligado, as mensagens dos clientes aparecem aqui.</div>
<% } else { %>
  <div class="sv-cv-lista<%= typeof polling !== 'undefined' && polling ? '' : ' sv-reveal' %>">
    <% conversas.forEach(function (c) { %>
      <a href="/painel/conversas?id=<%= c.id %>" class="sv-cv-item" data-nome="<%= (c.nome || '').toLowerCase() %>">
        <span class="sv-cv-av"><%= inic(c.nome) %></span>
        <span class="sv-cv-corpo">
          <span class="sv-cv-l1"><span class="sv-cv-nome"><%= c.nome %></span><span class="sv-cv-hora"><%= c.hora %></span></span>
          <span class="sv-cv-l2">
            <span class="sv-cv-previa"><%= c.previa %></span>
            <% if (c.naoLidas > 0) { %><span class="sv-cv-badge"><%= c.naoLidas %></span><% } %>
          </span>
          <% if (!c.iaAtiva) { %><span class="sv-cv-taghum">você assumiu</span><% } %>
        </span>
      </a>
    <% }) %>
  </div>
<% } %>
