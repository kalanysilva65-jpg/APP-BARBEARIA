<%/* Seção "Consome do estoque" dos pop-ups de serviço e produto (2026-09-03).
     Recebe:
       estoqueItens : lista de itens de estoque (id, nome)
       mapa         : { estoqueId: quantidade } da receita atual (vazio = novo)
     O marcador `insumos_form` diz ao controller que a seção veio no POST (sem
     ele o salvarInsumos não mexe na receita, pra não apagar sem querer). */%>
<% if (estoqueItens && estoqueItens.length) { %>
  <input type="hidden" name="insumos_form" value="1" />
  <div class="sv-campo">
    <div class="sv-campo-rot">Consome do estoque</div>
    <div class="sv-consumo-dica">Baixa sozinho quando o atendimento é concluído. Deixe 0 no que não consome.</div>
    <div class="sv-consumo-lista">
      <% estoqueItens.forEach(function (e) { %>
        <label class="sv-consumo-linha">
          <span class="sv-consumo-nome"><%= e.nome %></span>
          <input class="sv-campo-input sv-consumo-inp" type="number" name="insumo_<%= e.id %>" min="0" step="1" inputmode="numeric"
                 value="<%= mapa && mapa[e.id] ? mapa[e.id] : '' %>" placeholder="0" />
        </label>
      <% }) %>
    </div>
  </div>
<% } %>
