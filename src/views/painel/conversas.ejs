<%/* Caixa de entrada. Lista (com busca + auto-atualização) OU conversa aberta
     (com separadores de data + auto-atualização). Estilos em sv-conversas.css. */%>
<%
  function inic(nome) { var p = (nome || '?').trim().split(/\s+/); return ((p[0] || '?')[0] + (p[1] ? p[1][0] : '')).toUpperCase(); }
%>
<div class="sv-tela sv-cv">

<% if (!aberta) { %>
  <%/* ---------------- LISTA ---------------- */%>
  <div class="sv-cv-topo sv-reveal">
    <div>
      <div class="sv-titulo">Conversas</div>
      <div class="sv-cv-sub">Caixa de entrada do WhatsApp</div>
    </div>
    <a href="/painel" class="sv-cv-fechar" title="Início" aria-label="Voltar ao início">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </a>
  </div>

  <% if (!iaAtiva) { %>
    <div class="sv-cv-avisoia sv-reveal">Respostas automáticas <strong>desligadas</strong> (falta a chave da IA). Você ainda pode responder manualmente.</div>
  <% } else if (tetoAtingido) { %>
    <div class="sv-cv-avisoteto sv-reveal">⚠️ <strong>Teto de IA do mês atingido</strong> — respostas automáticas pausadas para conter custo. Vocês podem responder na mão; reinicia no próximo mês.</div>
  <% } %>

  <% if (conversas.length > 0) { %>
    <div class="sv-cv-busca sv-reveal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
      <input id="cv-busca" type="search" placeholder="Buscar conversa…" aria-label="Buscar conversa" autocomplete="off" />
    </div>
  <% } %>

  <div id="cv-lista"><%- include('_conversas-lista', { conversas: conversas }) %></div>
  <div class="sv-cv-vazio-busca" id="cv-vazio-busca" hidden>Nenhuma conversa encontrada.</div>

  <% if (ehAdmin) { %>
    <details class="sv-cv-simular sv-reveal">
      <summary>Simular mensagem de cliente (teste)</summary>
      <form method="POST" action="/painel/conversas/simular">
        <input name="telefone" placeholder="Telefone (ex.: 11999998888)" required />
        <input name="nome" placeholder="Nome do cliente (opcional)" />
        <input name="texto" placeholder="Mensagem do cliente" required />
        <button type="submit">Enviar como cliente</button>
      </form>
      <div class="sv-cv-simular-hint">Só para testar a caixa de entrada antes de ligar o WhatsApp. A IA responde se estiver configurada.</div>
    </details>
  <% } %>

  <script>
    (function () {
      // BUSCA (no cliente): filtra os itens pelo nome.
      var busca = document.getElementById('cv-busca');
      var vazioBusca = document.getElementById('cv-vazio-busca');
      function filtrar() {
        if (!busca) return;
        var q = busca.value.trim().toLowerCase();
        var itens = document.querySelectorAll('#cv-lista .sv-cv-item');
        var visiveis = 0;
        itens.forEach(function (it) {
          var ok = !q || (it.getAttribute('data-nome') || '').indexOf(q) !== -1;
          it.hidden = !ok;
          if (ok) visiveis++;
        });
        if (vazioBusca) vazioBusca.hidden = !(q && visiveis === 0);
      }
      if (busca) busca.addEventListener('input', filtrar);

      // AUTO-ATUALIZAÇÃO da lista: troca só o miolo quando muda, e re-aplica a busca.
      var lista = document.getElementById('cv-lista');
      var ultimoHtml = lista ? lista.innerHTML : '';
      async function atualizarLista() {
        if (!lista || document.hidden) return;
        try {
          var r = await fetch('/painel/conversas/fragmento', { headers: { 'X-Requested-With': 'fetch' } });
          if (!r.ok || r.redirected) return; // sessão expirou -> não injeta o /login na lista
          var html = await r.text();
          if (html.trim() && html !== ultimoHtml) {
            lista.innerHTML = html;
            ultimoHtml = html;
            filtrar();
          }
        } catch (e) {}
      }
      setInterval(atualizarLista, 8000);
    })();
  </script>

<% } else { %>
  <%/* ---------------- CONVERSA ABERTA ---------------- */%>
  <div class="sv-cv-thtopo sv-reveal">
    <a href="/painel/conversas" class="sv-cv-voltar" aria-label="Voltar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    </a>
    <span class="sv-cv-thav"><%= inic(aberta.conversa.nome) %></span>
    <div class="sv-cv-thid">
      <div class="sv-cv-thnome"><%= aberta.conversa.nome %></div>
      <div class="sv-cv-thtel"><%= aberta.conversa.telefone %></div>
    </div>
    <form method="POST" action="/painel/conversas/<%= aberta.conversa.id %>/ia" class="sv-cv-assumir">
      <input type="hidden" name="ativa" value="<%= aberta.conversa.iaAtiva ? '0' : '1' %>" />
      <button type="submit" class="<%= aberta.conversa.iaAtiva ? '' : 'devolver' %>">
        <%= aberta.conversa.iaAtiva ? 'Assumir' : 'Devolver à IA' %>
      </button>
    </form>
  </div>

  <div class="sv-cv-status <%= aberta.conversa.iaAtiva ? 'ia' : 'humano' %>">
    <span><% if (aberta.conversa.iaAtiva) { %>🤖 IA respondendo automaticamente<% } else { %>✋ Você assumiu — IA pausada nesta conversa<% } %></span>
    <form method="POST" action="/painel/conversas/<%= aberta.conversa.id %>/excluir" class="sv-cv-excluir" onsubmit="return confirm('Excluir esta conversa e todas as mensagens? Isso apaga os dados do cliente e não dá para desfazer.')">
      <button type="submit">Excluir</button>
    </form>
  </div>

  <div class="sv-cv-thread" id="cv-thread" data-id="<%= aberta.conversa.id %>">
    <% aberta.mensagens.forEach(function (m) { %>
      <% if (m.sep) { %><div class="cv-sep"><span><%= m.sep %></span></div><% } %>
      <div class="cv-msg cv-msg--<%= m.autor === 'cliente' ? 'in' : 'out' %>" data-id="<%= m.id %>" data-dia="<%= m.dia %>">
        <span class="cv-msg-txt"><%= m.texto %></span>
        <span class="cv-msg-meta"><% if (m.autor === 'ia') { %>IA · <% } else if (m.autor === 'humano') { %>Você · <% } %><%= m.hora %></span>
      </div>
    <% }) %>
  </div>

  <form class="sv-cv-composer" method="POST" action="/painel/conversas/<%= aberta.conversa.id %>/responder" autocomplete="off">
    <input class="sv-cv-input" name="texto" placeholder="Responder…" maxlength="2000" required aria-label="Sua resposta" />
    <button type="submit" class="sv-cv-enviar" aria-label="Enviar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>
    </button>
  </form>

  <script>
    (function () {
      var thread = document.getElementById('cv-thread');
      if (!thread) return;
      var convId = thread.getAttribute('data-id');
      function irAoFim() { window.scrollTo(0, document.body.scrollHeight); }
      irAoFim();

      function ultimoId() {
        var msgs = thread.querySelectorAll('.cv-msg');
        return msgs.length ? Number(msgs[msgs.length - 1].getAttribute('data-id')) : 0;
      }
      function ultimoDia() {
        var msgs = thread.querySelectorAll('.cv-msg');
        return msgs.length ? msgs[msgs.length - 1].getAttribute('data-dia') : '';
      }
      function addSep(label) {
        var s = document.createElement('div');
        s.className = 'cv-sep';
        var span = document.createElement('span');
        span.textContent = label;
        s.appendChild(span);
        thread.appendChild(s);
      }
      function addMsg(m) {
        var el = document.createElement('div');
        el.className = 'cv-msg cv-msg--' + (m.autor === 'cliente' ? 'in' : 'out');
        el.setAttribute('data-id', m.id);
        el.setAttribute('data-dia', m.dia);
        var txt = document.createElement('span');
        txt.className = 'cv-msg-txt';
        txt.textContent = m.texto;
        el.appendChild(txt);
        var meta = document.createElement('span');
        meta.className = 'cv-msg-meta';
        meta.textContent = (m.autor === 'ia' ? 'IA · ' : (m.autor === 'humano' ? 'Você · ' : '')) + m.hora;
        el.appendChild(meta);
        thread.appendChild(el);
      }
      async function atualizar() {
        if (document.hidden) return;
        try {
          var r = await fetch('/painel/conversas/' + convId + '/novas?apos=' + ultimoId(), { headers: { 'X-Requested-With': 'fetch' } });
          if (!r.ok || r.redirected) return;
          var d = await r.json();
          if (!d.mensagens || !d.mensagens.length) return;
          var perto = (window.innerHeight + window.scrollY) >= document.body.scrollHeight - 160;
          var dia = ultimoDia();
          d.mensagens.forEach(function (m) {
            if (m.dia !== dia) { addSep(m.diaLabel); dia = m.dia; }
            addMsg(m);
          });
          if (perto) irAoFim();
        } catch (e) {}
      }
      setInterval(atualizar, 4000);
    })();
  </script>
<% } %>

</div>
