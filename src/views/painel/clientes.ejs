<%/* Clientes no design SUAVE (pedido do dono, 2026-07-31): sai a composição
     editorial do Turno 6 (faixas separadas por fio, número gigante no topo) e
     entra o desenho da referência — cabeçalho FIXO com título, busca em
     pílula e filtros roláveis; abaixo, o resumo em três ladrilhos e a carteira
     em cartões arredondados com avatar.
     O pop-up deste design é FOLHA INFERIOR: tanto o "Novo cliente" (que era
     diálogo centrado) quanto o detalhe (que era folha de página inteira)
     agora sobem de baixo. Estilos em public/css/sv-clientes-equipe.css. */%>
<div class="sv-tela sv-cl-tela">

  <div class="sv-cl-topo sv-reveal">
    <div class="sv-cl-topo-linha">
      <div class="sv-titulo">Clientes</div>
      <button type="button" class="sv-btn sv-cl-novo" onclick="clAbrirFolha('novo')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>Novo</span>
      </button>
    </div>

    <div class="sv-cl-busca">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" class="sv-cl-busca-input" id="cl-busca-input" placeholder="Buscar cliente" oninput="clFiltrar()" />
    </div>

    <div class="sv-cl-filtros sv-rolagem" id="cl-filtros">
      <button type="button" class="sv-cl-filtro sel" data-filtro="todos" onclick="clSelecionarFiltro(this)">Todos</button>
      <button type="button" class="sv-cl-filtro" data-filtro="sumidos" onclick="clSelecionarFiltro(this)">Sumidos</button>
      <button type="button" class="sv-cl-filtro" data-filtro="aniversariantes" onclick="clSelecionarFiltro(this)">Aniversariantes</button>
    </div>
  </div>

  <div class="sv-cl-corpo sv-rolagem">
    <%/* Os três ladrilhos espelham exatamente os três filtros do topo. */%>
    <div class="sv-cl-tiles sv-reveal">
      <div class="sv-cl-tile">
        <div class="sv-cl-tile-num"><%= resumo.total %></div>
        <div class="sv-cl-tile-rot">na base</div>
      </div>
      <div class="sv-cl-tile">
        <div class="sv-cl-tile-num"><%= resumo.sumidos %></div>
        <div class="sv-cl-tile-rot">sumidos +30d</div>
      </div>
      <div class="sv-cl-tile">
        <div class="sv-cl-tile-num"><%= resumo.aniversariantes %></div>
        <div class="sv-cl-tile-rot">aniversário</div>
      </div>
    </div>

    <% if (clientes.length === 0) { %>
      <div class="sv-vazio">Nenhum cliente cadastrado ainda.</div>
    <% } else { %>
      <div class="sv-cl-lista" id="cl-lista">
        <% clientes.forEach(function (c) { %>
          <button type="button" class="sv-cl-item" onclick="clAbrirFolha(<%= c.id %>)"
                  data-nome="<%= c.nome.toLowerCase() %>"
                  data-tel="<%= c.telefone %>"
                  data-sumido="<%= c.stats.sumido ? '1' : '0' %>"
                  data-aniv="<%= c.aniversarianteMes ? '1' : '0' %>">
            <span class="sv-cl-av"><%= c.iniciais %></span>
            <span class="sv-cl-item-corpo">
              <span class="sv-cl-nome-linha">
                <span class="sv-cl-nome"><%= c.nome %></span>
                <% if (c.stats.sumido) { %><span class="sv-cl-selo">sumido</span><% } %>
                <% if (c.aniversarianteMes) { %><span class="sv-cl-selo sv-cl-selo--aniv">aniver.</span><% } %>
              </span>
              <span class="sv-cl-sub"><%= c.stats.servicoFavorito || 'sem histórico' %> · <%= c.stats.ultimaVisitaLabel %></span>
            </span>
            <span class="sv-cl-lado">
              <span class="sv-cl-gasto"><%= fmtT6(c.stats.totalGasto) %></span>
              <span class="sv-cl-selos"><%= c.selosFidelidade %> selos</span>
            </span>
          </button>
        <% }) %>
      </div>
      <div class="sv-vazio" id="cl-sem-resultado" hidden>Nenhum cliente com esse filtro.</div>
    <% } %>
  </div>
</div>

<%/* Novo cliente — folha inferior. */%>
<div class="sv-folha-fundo" id="cl-folha-novo" hidden>
  <div class="sv-folha">
    <div class="sv-folha-puxador"></div>
    <div class="sv-folha-titulo">Novo cliente</div>
    <form method="POST" action="/painel/clientes">
      <div class="sv-campo">
        <label class="sv-campo-rot" for="cl-novo-nome">Nome</label>
        <input class="sv-campo-input" id="cl-novo-nome" name="nome" placeholder="Nome completo" required />
      </div>
      <div class="sv-campo">
        <label class="sv-campo-rot" for="cl-novo-tel">Telefone</label>
        <input class="sv-campo-input" id="cl-novo-tel" name="telefone" inputmode="tel" placeholder="(51) 99999-9999" required />
      </div>
      <div class="sv-campo">
        <label class="sv-campo-rot" for="cl-novo-nascimento">Data de nascimento</label>
        <input class="sv-campo-input" id="cl-novo-nascimento" name="dataNascimento" type="date" />
      </div>
      <button type="submit" class="sv-btn sv-cl-btn-bloco">Cadastrar</button>
    </form>
  </div>
</div>

<%/* Detalhe do cliente — uma folha por cliente. A referência resolve isso com
     três campos e os números no rodapé; aqui cabe também histórico, planos e
     exclusão, então os números sobem para logo abaixo do nome (é o que se olha
     primeiro) e o resto desce em seções. */%>
<% clientes.forEach(function (c) { %>
  <div class="sv-folha-fundo" id="cl-folha-<%= c.id %>" hidden>
    <div class="sv-folha">
      <div class="sv-folha-puxador"></div>
      <div class="sv-folha-titulo"><%= c.nome %></div>
      <div class="sv-cl-folha-sub"><%= fmtTelefone(c.telefone) %> · última visita <%= c.stats.ultimaVisitaLabel %></div>

      <div class="sv-cl-tres">
        <div class="sv-cl-tres-cel">
          <div class="sv-cl-tres-num"><%= fmtT6(c.stats.totalGasto) %></div>
          <div class="sv-cl-tres-rot">total gasto</div>
        </div>
        <div class="sv-cl-tres-cel">
          <div class="sv-cl-tres-num"><%= c.stats.visitas %></div>
          <div class="sv-cl-tres-rot">visitas</div>
        </div>
        <div class="sv-cl-tres-cel">
          <div class="sv-cl-tres-num"><%= c.stats.frequenciaDias !== null ? c.stats.frequenciaDias + 'd' : '—' %></div>
          <div class="sv-cl-tres-rot">frequência</div>
        </div>
      </div>

      <form method="POST" action="/painel/clientes/<%= c.id %>">
        <div class="sv-campo">
          <label class="sv-campo-rot" for="cl-tel-<%= c.id %>">Telefone</label>
          <input class="sv-campo-input" id="cl-tel-<%= c.id %>" name="telefone" inputmode="tel" value="<%= fmtTelefone(c.telefone) %>" required />
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="cl-nasc-<%= c.id %>">Data de nascimento</label>
          <input class="sv-campo-input" id="cl-nasc-<%= c.id %>" name="dataNascimento" type="date" value="<%= c.nascimentoIso %>" />
        </div>
        <div class="sv-campo">
          <label class="sv-campo-rot" for="cl-obs-<%= c.id %>">Observações</label>
          <input class="sv-campo-input" id="cl-obs-<%= c.id %>" name="observacoes" placeholder="Adicionar observação" value="<%= c.observacoes || '' %>" />
        </div>
        <%/* Serviço e barbeiro preferidos saem do histórico, não são cadastro:
             mesma caixa dos campos, mas sem input. */%>
        <div class="sv-campo">
          <div class="sv-campo-rot">Serviço preferido · barbeiro</div>
          <div class="sv-cl-campo-val"><%= c.stats.servicoFavorito || '—' %> · <%= c.stats.barbeiroFavorito || '—' %></div>
        </div>
        <button type="submit" class="sv-btn sv-cl-btn-bloco">Salvar</button>
      </form>

      <% if (c.agendamentos.length > 0) { %>
        <div class="sv-cl-secao">
          <div class="sv-cl-secao-rot">Histórico</div>
          <% c.agendamentos.slice(0, 8).forEach(function (ag) { %>
            <div class="sv-cl-hist-linha">
              <span><%= fmtData(ag.data) %> · <%= ag.itens.length ? ag.itens.map(function (it) { return it.servico.nome; }).join(', ') : '—' %></span>
              <span class="sv-cl-hist-valor"><%= fmtT6(ag.valorTotal) %></span>
            </div>
          <% }) %>
        </div>
      <% } %>

      <div class="sv-cl-secao">
        <div class="sv-cl-secao-rot">Plano</div>
        <% c.assinaturas.forEach(function (a) { %>
          <div class="sv-cl-plano-linha">
            <span>
              <%= a.plano.nome %>
              <span class="sv-cl-plano-estado <%= a.vigente ? 'vig' : '' %>"><%= a.vigente ? 'ativo' : 'inativo' %></span>
            </span>
            <form method="POST" action="/painel/clientes/planos/<%= a.id %>/remover" onsubmit="return confirm('Remover este plano do cliente?')">
              <button type="submit" class="sv-cl-plano-x" title="Remover" aria-label="Remover plano">×</button>
            </form>
          </div>
        <% }) %>
        <% if (c.assinaturas.length === 0 && planosDisponiveis.length === 0) { %>
          <div class="sv-cl-hist-linha"><span>Nenhum plano.</span></div>
        <% } %>
        <% if (planosDisponiveis.length > 0) { %>
          <form method="POST" action="/painel/clientes/<%= c.id %>/planos" class="sv-cl-add-plano">
            <select class="sv-cl-select" name="planoId" required>
              <option value="">Adicionar plano…</option>
              <% planosDisponiveis.forEach(function (p) { %>
                <option value="<%= p.id %>"><%= p.nome %> — <%= fmtBRL(p.valor) %></option>
              <% }) %>
            </select>
            <input type="hidden" name="dataInicio" value="<%= hojeIso %>" />
            <button type="submit" class="sv-btn sv-cl-add-btn">Adicionar</button>
          </form>
        <% } %>
      </div>

      <div class="sv-cl-acoes">
        <form method="POST" action="/painel/clientes/<%= c.id %>/remover" onsubmit="return confirm('Excluir este cliente?')">
          <button type="submit" class="sv-cl-excluir">Excluir cliente</button>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<script>
  // Folha inferior: `hidden` liga/desliga. Tirar o `hidden` recria o elemento
  // na tela, e é isso que faz a animação de subida rodar de novo a cada
  // abertura (uma folha só escondida por opacidade não reanimaria).
  function clAbrirFolha(id) {
    var f = document.getElementById('cl-folha-' + id);
    if (f) f.hidden = false;
  }
  function clFecharFolhas() {
    Array.prototype.forEach.call(document.querySelectorAll('.sv-folha-fundo'), function (f) { f.hidden = true; });
  }
  // Só o fundo fecha — clique DENTRO da folha não deve fechá-la.
  Array.prototype.forEach.call(document.querySelectorAll('.sv-folha-fundo'), function (f) {
    f.addEventListener('click', function (e) { if (e.target === f) f.hidden = true; });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') clFecharFolhas();
  });

  // Busca e filtro trabalham JUNTOS sobre a mesma lista (os dois ficam
  // visíveis no topo ao mesmo tempo), por isso um recalcula o outro em vez de
  // cada um esconder os cartões por conta própria.
  var clFiltro = 'todos';
  function clSelecionarFiltro(btn) {
    Array.prototype.forEach.call(document.querySelectorAll('#cl-filtros .sv-cl-filtro'), function (b) {
      b.classList.toggle('sel', b === btn);
    });
    clFiltro = btn.getAttribute('data-filtro');
    clFiltrar();
  }
  function clFiltrar() {
    var lista = document.getElementById('cl-lista');
    if (!lista) return;
    var campo = document.getElementById('cl-busca-input');
    var t = (campo ? campo.value : '').trim().toLowerCase();
    var tDigitos = t.replace(/\D/g, '');
    var visiveis = 0;
    Array.prototype.forEach.call(lista.querySelectorAll('.sv-cl-item'), function (item) {
      var casaBusca = !t
        || item.dataset.nome.indexOf(t) !== -1
        || (tDigitos && item.dataset.tel.indexOf(tDigitos) !== -1);
      var casaFiltro = clFiltro === 'todos'
        || (clFiltro === 'sumidos' && item.dataset.sumido === '1')
        || (clFiltro === 'aniversariantes' && item.dataset.aniv === '1');
      var mostra = casaBusca && casaFiltro;
      item.style.display = mostra ? '' : 'none';
      if (mostra) visiveis++;
    });
    var vazio = document.getElementById('cl-sem-resultado');
    if (vazio) vazio.hidden = visiveis > 0;
    lista.hidden = visiveis === 0;
  }
</script>
