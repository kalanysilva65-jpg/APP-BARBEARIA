<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof titulo !== 'undefined' ? titulo + ' · Cortavo' : 'Cortavo' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <%/* Documento público (privacidade/termos). Estilos próprios e SEMPRE claros
         — é lido por revisores de loja/Meta e não deve depender do tema do app
         (no modo escuro o texto sumia no fundo). */%>
    <style>
      :root { color-scheme: light; }
      html, body { margin: 0; background: #ffffff; }
      body {
        color: #191919;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        -webkit-text-size-adjust: 100%;
      }
      .sv-legal { max-width: 720px; margin: 0 auto; padding: 40px 22px 80px; line-height: 1.65; font-size: 15px; color: #191919; }
      .sv-legal-tit { font-size: 28px; font-weight: 700; letter-spacing: -0.8px; margin: 0 0 6px; }
      .sv-legal-data { font-size: 13px; color: #6b6b6b; margin: 0 0 28px; }
      .sv-legal-data a { color: #6b6b6b; }
      .sv-legal h2 { font-size: 17px; font-weight: 600; letter-spacing: -0.3px; margin: 30px 0 8px; color: #191919; }
      .sv-legal p { margin: 0 0 14px; }
      .sv-legal ul { margin: 0 0 14px; padding-left: 20px; }
      .sv-legal li { margin-bottom: 7px; }
      .sv-legal a { color: #0a5; text-decoration: underline; }
      .sv-legal strong { color: #191919; }
    </style>
  </head>
  <body>
    <%- body %>
  </body>
</html>
