<%/* Tela de carregamento do app (redesenho do dono, 2026-09-03): o wordmark
     CORTAVO sobre fundo escuro, entrando com desfoque + espaçamento de letras
     se fechando e saindo com leve zoom/blur. Substituiu o splash antigo de
     saudação+nome.

     Regras:
      - Aparece só na ABERTURA do app (primeira carga por sessão de webview).
        Não repete a cada troca de tela — o sessionStorage sobrevive à navegação
        e só zera quando o app é fechado de verdade (cold launch).
      - As letras entram uma a uma (estilo Netflix) formando CORTAVO, e o splash
        some quando a página termina de carregar, com um piso pra a sequência
        completar (~1,2s) mais um respiro.
      - Tudo INLINE de propósito: precisa pintar já no primeiro quadro, antes de
        qualquer CSS/JS do app carregar.
      - Autossuficiente: não usa nome/foto do usuário, então serve login e
        painel igual. */%>
<script>
  /* Roda ANTES do <div> abaixo existir: se o splash já rolou nesta sessão,
     marca o <html> e o CSS mantém o splash escondido — assim ele nunca pisca na
     navegação interna, só na abertura. */
  (function () {
    try {
      if (sessionStorage.getItem('cortavoSplash') === '1') {
        document.documentElement.setAttribute('data-splash', 'feito');
      } else {
        sessionStorage.setItem('cortavoSplash', '1');
      }
    } catch (e) {
      document.documentElement.setAttribute('data-splash', 'feito');
    }
  })();
</script>
<style>
  @font-face {
    font-family: 'Overused Grotesk';
    src: url('/fonts/OverusedGrotesk-VF.woff2') format('woff2-variations');
    font-weight: 300 900;
    font-display: swap;
  }
  #cortavo-splash {
    position: fixed;
    inset: 0;
    z-index: 100000;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  html[data-splash="feito"] #cortavo-splash { display: none; }
  #cortavo-splash .cs-brilho {
    position: absolute;
    inset: 0;
    /* Vinheta invertida: leve sombra nas bordas pra dar profundidade no branco. */
    background: radial-gradient(circle at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.05));
  }
  #cortavo-splash .cs-marca {
    position: relative;
    font-family: 'Overused Grotesk', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 32px;
    font-weight: 600;
    letter-spacing: 2px;
    color: #191919;
  }
  /* Cada letra entra em SEQUÊNCIA (estilo Netflix): sobe, dá zoom e ganha
     nitidez, uma após a outra pelos `animation-delay` inline. `both` aplica o
     estado inicial já no 1º quadro (sem piscar). */
  #cortavo-splash .cs-marca span {
    display: inline-block;
    animation: cs-letra 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.05) both;
  }
  #cortavo-splash.cs-saindo { animation: cs-sai 0.4s cubic-bezier(0.6, 0, 0.85, 0.3) forwards; }
  @keyframes cs-letra {
    0% { opacity: 0; transform: translateY(0.28em) scale(0.82); filter: blur(4px); }
    100% { opacity: 1; transform: none; filter: blur(0); }
  }
  @keyframes cs-sai {
    0% { opacity: 1; transform: scale(1); filter: blur(0); }
    100% { opacity: 0; transform: scale(1.06); filter: blur(10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #cortavo-splash .cs-marca span { animation: none; }
    #cortavo-splash.cs-saindo { animation: cs-sai 0.25s linear forwards; }
  }
  /* Segura as ENTRADAS da primeira tela enquanto o splash cobre (cold launch):
     sem isso elas tocavam atrás do splash e já estavam prontas quando ele abria
     (a Home aparecia sem animação). Enquanto o #cortavo-splash existe e ainda
     NÃO começou a sair, as animações do conteúdo ficam pausadas no 1º quadro;
     ao começar a saída (.cs-saindo) elas soltam e entram junto com o splash
     dissolvendo. Só afeta a abertura — nas navegações não há splash no DOM.
     :has() é iOS 15.4+; sem suporte, degrada pro comportamento anterior. */
  html:has(#cortavo-splash:not(.cs-saindo)) .pg-sv .conteudo * {
    animation-play-state: paused !important;
  }
</style>
<div id="cortavo-splash" aria-hidden="true">
  <div class="cs-brilho"></div>
  <div class="cs-marca" aria-label="CORTAVO"><% 'CORTAVO'.split('').forEach(function (ch, i) { %><span style="animation-delay:<%= (i * 0.12).toFixed(2) %>s"><%= ch %></span><% }); %></div>
</div>
<script>
  (function () {
    var el = document.getElementById('cortavo-splash');
    if (!el) return;
    /* Já foi mostrado nesta sessão: só limpa e sai. */
    if (document.documentElement.getAttribute('data-splash') === 'feito') { el.remove(); return; }
    /* Some quando a página termina de carregar (window.load), com um piso que dá
       tempo da sequência letra-a-letra formar CORTAVO (~1,2s) e um respiro. */
    var MIN = 1700, inicio = Date.now();
    function sair() {
      el.classList.add('cs-saindo');
      setTimeout(function () { if (el && el.parentNode) el.remove(); }, 420);
    }
    function pronto() { setTimeout(sair, Math.max(0, MIN - (Date.now() - inicio))); }
    if (document.readyState === 'complete') pronto();
    else window.addEventListener('load', pronto);
  })();

  /* Entrega do splash NATIVO (Capacitor) para o splash HTML.
     No app iOS/Android o casco carrega cortavo.com.br de fora; enquanto a página
     remota baixa, é o splash nativo (branco, launchAutoHide:false) que cobre a
     tela — sem isso ficava o fundo PRETO da webview até o 1º paint (a "tela preta
     de 2s"). Este script roda quando o nosso splash HTML já foi parseado; após
     dois quadros ele já pintou (branco idêntico ao nativo), então escondemos o
     nativo: nativo branco -> splash HTML branco, sem corte nem piscada.
     No navegador (sem window.Capacitor) e sem o plugin, é no-op silencioso. */
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      try {
        var C = window.Capacitor;
        if (C && C.Plugins && C.Plugins.SplashScreen) C.Plugins.SplashScreen.hide();
      } catch (e) {}
    });
  });
</script>
