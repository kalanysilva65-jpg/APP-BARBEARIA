<%
  var nomeBarbearia = (typeof barbearia !== 'undefined' && barbearia) ? barbearia.nome : 'Barbearia';
%>
<div class="ag3-passo">
  <div class="ag3-passo-topo">
    <a href="/agendar/horario?servicoIds=<%= servicoIdsStr %>&barbeiroId=<%= barbeiro.id %>&data=<%= data %><%= assinatura ? '&assinatura=' + assinatura.id : '' %>" class="ag3-voltar-inline">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
    </a>
    <span class="ag3-marca">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#8a8a85" stroke-width="2"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 20a6 6 0 0 1 12 0M15.5 20a5 5 0 0 1 5.5-5"/></svg>
      <%= nomeBarbearia %>
    </span>
    <div class="ag3-titulo">Seus dados</div>
  </div>

  <form method="POST" action="/agendar/confirmar">
    <input type="hidden" name="servicoIds" value="<%= servicoIdsStr %>" />
    <input type="hidden" name="barbeiroId" value="<%= barbeiro.id %>" />
    <input type="hidden" name="data" value="<%= data %>" />
    <input type="hidden" name="hora" value="<%= hora %>" />
    <% if (assinatura) { %><input type="hidden" name="assinatura" value="<%= assinatura.id %>" /><% } %>

    <% if (!assinatura) { %>
      <div class="ag3-campo">
        <label class="ag3-campo-label" for="cliente_nome">Nome</label>
        <input class="ag3-input" id="cliente_nome" name="cliente_nome" placeholder="Seu nome completo" required autofocus />
      </div>
      <div class="ag3-campo">
        <label class="ag3-campo-label" for="cliente_telefone">Telefone / WhatsApp</label>
        <input class="ag3-input" id="cliente_telefone" name="cliente_telefone" inputmode="tel" placeholder="(11) 99999-9999" required />
      </div>
      <div class="ag3-campo">
        <label class="ag3-campo-label" for="cliente_nascimento">Data de nascimento (opcional)</label>
        <input class="ag3-input" id="cliente_nascimento" type="date" name="cliente_nascimento" />
      </div>
    <% } %>

    <div class="ag3-resumo">
      <div class="ag3-resumo-linha">
        <span class="ag3-resumo-rot">Serviço</span>
        <span class="ag3-resumo-val"><%= servicos.length === 1 ? servicos[0].nome : servicos.length + ' serviços' %></span>
      </div>
      <div class="ag3-resumo-sep"></div>
      <div class="ag3-resumo-linha">
        <span class="ag3-resumo-rot">Barbeiro</span>
        <span class="ag3-resumo-val"><%= barbeiro.nome %></span>
      </div>
      <div class="ag3-resumo-sep"></div>
      <div class="ag3-resumo-linha">
        <span class="ag3-resumo-rot">Data e hora</span>
        <span class="ag3-resumo-val"><%= dataExtenso %> · <%= hora %></span>
      </div>
      <div class="ag3-resumo-sep"></div>
      <div class="ag3-resumo-linha">
        <span class="ag3-resumo-rot">Valor</span>
        <span class="ag3-resumo-preco"><%= assinatura ? 'Incluso no plano' : fmtBRL(valorTotal) %></span>
      </div>
    </div>

    <% if (assinatura) { %>
      <div class="ag3-cliente-card">
        <div class="ag3-cliente-label">Cliente</div>
        <div class="ag3-cliente-nome"><%= assinatura.cliente.nome %></div>
        <div class="ag3-cliente-tel"><%= fmtTelefone(assinatura.cliente.telefone) %></div>
      </div>
    <% } %>

    <div class="ag3-rodape-acao">
      <button class="ag3-cta" type="submit">Confirmar agendamento</button>
    </div>
  </form>
</div>
