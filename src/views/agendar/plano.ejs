<%
  var DIAS_SEMANA_EXT = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
  function _diasPlanoLabel(diasStr) {
    var dias = String(diasStr || '').split(',').map(Number).filter(function (n) { return !isNaN(n); }).sort(function (a, b) { return a - b; });
    if (dias.length === 7) return 'todos os dias';
    var corrido = dias.every(function (d, i) { return i === 0 || d === dias[i - 1] + 1; });
    if (corrido && dias.length > 1) return DIAS_SEMANA_EXT[dias[0]] + ' a ' + DIAS_SEMANA_EXT[dias[dias.length - 1]];
    return dias.map(function (d) { return DIAS_SEMANA_EXT[d].slice(0, 3); }).join(', ');
  }
%>

<%/* TURNO 6 (2026-07-28): mesma gramática dos outros passos — manchete grande,
     campo só com fio embaixo e a consulta na barra preta do rodapé. Os planos
     encontrados viram linhas separadas por fio, como os serviços. */%>
<form method="GET" action="/agendar/plano" class="ag6-corpo">
  <div class="ag6-rolagem">
    <div class="ag6-cabeca">
      <div class="ag6-titulo">Meu plano</div>
      <div class="ag6-sub">Informe seu telefone para verificarmos seu plano ativo.</div>
    </div>

    <div class="ag6-campos">
      <div class="ag6-campo" style="animation-delay:0.06s">
        <label class="ag6-campo-rot" for="telefone">Telefone / WhatsApp</label>
        <input class="ag6-input" id="telefone" name="telefone" inputmode="tel" autocomplete="tel" placeholder="(11) 90000-0000" value="<%= telefoneDigitado %>" required autofocus />
      </div>
    </div>

    <% if (resultado) { %>
      <% if (resultado.assinaturas.length === 0) { %>
        <div class="ag6-aviso">Nenhum plano ativo encontrado para esse telefone.</div>
        <div class="ag6-cabeca" style="padding-top:16px">
          <a href="/agendar" class="ag6-selo">Agendar sem plano</a>
        </div>
      <% } else { %>
        <div class="ag6-sobrancelha-linha">
          <span class="ag6-sobrancelha">Olá, <%= resultado.cliente.nome.split(' ')[0] %></span>
          <span class="ag6-sobrancelha-val"><%= resultado.assinaturas.length %> plano<%= resultado.assinaturas.length > 1 ? 's' : '' %></span>
        </div>
        <div class="ag6-lista">
          <% resultado.assinaturas.forEach(function (a, i) { %>
            <a class="ag6-item" href="<%= a.plano.servicoId ? '/agendar/barbeiro?servicoId=' + a.plano.servicoId + '&assinatura=' + a.id : '/agendar?assinatura=' + a.id %>" style="animation-delay:<%= (0.2 + i * 0.07).toFixed(2) %>s">
              <span>
                <span class="ag6-item-nome"><%= a.plano.nome %></span>
                <span class="ag6-item-sub">
                  <%= a.plano.tipo === 'ilimitado' ? 'Ilimitado · ' + _diasPlanoLabel(a.plano.diasSemana) : a.usosRestantes + ' uso(s) restante(s)' %>
                  · até <%= fmtData(a.dataFim) %><%= a.plano.servico ? ' · ' + a.plano.servico.nome : '' %>
                </span>
              </span>
              <span class="ag6-item-acao">Usar →</span>
            </a>
          <% }) %>
          <div class="ag6-lista-fim"></div>
        </div>
      <% } %>
    <% } %>
  </div>

  <div class="ag6-barra">
    <button class="ag6-acao ag6-acao--simples" type="submit">Consultar</button>
  </div>
</form>
