<%
  var nomesServicos = agendamento.itens.map(function (it) { return it.servico.nome; }).join(' + ');
%>

<%/* SUAVE (pedido do dono, 2026-07-31): a manchete de 80px do Turno 6 desceu
     pros 46px da referência (ainda "Está / marcado", uma palavra por linha,
     subindo) e o combinado saiu dos fios soltos pra dentro de um cartão
     branco — o resumo passa a ser um objeto só, e não uma tabela. */%>
<div class="sv-ag6-pronto">
  <div>
    <div class="sv-ag6-pronto-manchete">
      <span>Está</span>
      <span>marcado</span>
    </div>

    <div class="sv-ag6-pronto-cartao">
      <div class="sv-ag6-pronto-quando"><%= dataExtenso %> · <%= agendamento.horaInicio %></div>
      <div class="sv-ag6-pronto-oque"><%= nomesServicos %> · com <%= agendamento.usuario.nome %></div>

      <div class="sv-ag6-pronto-linhas">
        <div class="sv-ag6-pronto-linha">
          <span class="sv-ag6-pronto-rot">Cliente</span>
          <span class="sv-ag6-pronto-val"><%= agendamento.clienteNome %></span>
        </div>
        <div class="sv-ag6-pronto-linha">
          <span class="sv-ag6-pronto-rot"><%= agendamento.itens.length === 1 ? 'Valor' : 'Total' %></span>
          <span class="sv-ag6-pronto-val"><%= usouPlano ? 'Via plano' : fmtT6(agendamento.valorTotal) %></span>
        </div>
      </div>

      <div class="sv-ag6-pronto-nota">
        Enviamos a confirmação no WhatsApp <%= fmtTelefone(agendamento.clienteTelefone) %>. Chegue 5 minutos antes.
      </div>
    </div>
  </div>
</div>

<div class="sv-ag6-barra">
  <a class="sv-ag6-acao sv-ag6-acao--simples" href="/agendar">Marcar outro horário</a>
</div>
