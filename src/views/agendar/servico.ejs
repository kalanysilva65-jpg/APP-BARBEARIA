<%
  function _diasPlanoLabelServico(diasStr) {
    var DIAS = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'];
    var dias = String(diasStr || '').split(',').map(Number).filter(function (n) { return !isNaN(n); }).sort(function (a, b) { return a - b; });
    if (dias.length === 7) return 'todos os dias';
    var corrido = dias.every(function (d, i) { return i === 0 || d === dias[i - 1] + 1; });
    if (corrido && dias.length > 1) return DIAS[dias[0]] + '–' + DIAS[dias[dias.length - 1]];
    return dias.map(function (d) { return DIAS[d]; }).join(', ');
  }
%>

<%/* SUAVE (pedido do dono, 2026-07-31): a lista separada por fios do Turno 6
     (nome do serviço a 34px) virou uma pilha de CARTÕES brancos com sombra
     suave, nome a 17px e um seletor redondo à direita. O selecionado inverte
     pra preto — na referência é o único uso do preto na área de conteúdo. */%>
<div class="sv-ag6-rolagem">
  <% if (assinatura) { %>
    <div class="sv-ag6-aviso">
      Usando o plano <strong><%= assinatura.plano.nome %></strong><%= assinatura.usosRestantes !== null ? ' · ' + assinatura.usosRestantes + ' uso(s) restante(s)' : ' · ilimitado (' + _diasPlanoLabelServico(assinatura.plano.diasSemana) + ')' %>.
      <a href="/agendar">Agendar sem plano</a>
    </div>
  <% } else { %>
    <%/* A porta de entrada do plano fica ANTES da lista: quem tem plano não
         deve percorrer os serviços com preço pra depois descobrir o atalho. */%>
    <div class="sv-ag6-cabeca">
      <a href="/agendar/plano" class="sv-ag6-chip sv-ag6-chip--plano">Já tenho um plano</a>
    </div>
  <% } %>

  <% if (servicos.length === 0) { %>
    <p class="sv-ag6-vazio">Nenhum serviço disponível no momento.</p>
  <% } else if (assinatura) { %>
    <%/* Plano: seleção única e direta por link — o plano cobre um serviço por
         agendamento, então não há o que somar nem barra de total. */%>
    <div class="sv-ag6-secao">
      <div class="sv-ag6-secao-tit">Escolha o serviço</div>
    </div>
    <div class="sv-ag6-lista">
      <% servicos.forEach(function (s, i) { %>
        <a class="sv-ag6-servico" href="/agendar/barbeiro?servicoIds=<%= s.id %>&assinatura=<%= assinatura.id %>" style="animation-delay:<%= (0.2 + i * 0.07).toFixed(2) %>s">
          <span class="sv-ag6-servico-txt">
            <span class="sv-ag6-servico-nome"><%= s.nome %></span>
            <span class="sv-ag6-servico-meta"><%= s.duracaoMin %> min · Incluso</span>
          </span>
          <% if (s.fotoUrl) { %><span class="sv-ag6-servico-foto"><img src="<%= s.fotoUrl %>" alt="" /></span><% } %>
          <span class="sv-ag6-servico-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
          </span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <form id="form-servicos" action="/agendar/barbeiro" method="GET" onsubmit="return validarSelecao()">
      <input type="hidden" name="servicoIds" id="servicoIds-input" value="" />
      <div class="sv-ag6-secao">
        <div class="sv-ag6-secao-tit">Escolha os serviços</div>
        <div class="sv-ag6-secao-val" id="ag6-conta">toque para escolher</div>
      </div>
      <div class="sv-ag6-lista" id="lista-servicos">
        <% servicos.forEach(function (s, i) { %>
          <button type="button" class="sv-ag6-servico" data-id="<%= s.id %>" data-valor="<%= s.valor %>" data-min="<%= s.duracaoMin %>" data-encaixe="<%= s.ehEncaixe ? '1' : '' %>" onclick="toggleServico(this)" style="animation-delay:<%= (0.2 + i * 0.07).toFixed(2) %>s">
            <span class="sv-ag6-servico-txt">
              <span class="sv-ag6-servico-nome"><%= s.nome %></span>
              <span class="sv-ag6-servico-meta"><%= s.duracaoMin %> min · <%= fmtT6(s.valor) %></span>
            </span>
            <% if (s.fotoUrl) { %><span class="sv-ag6-servico-foto"><img src="<%= s.fotoUrl %>" alt="" /></span><% } %>
            <span class="sv-ag6-servico-check">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
          </button>
        <% }) %>
      </div>
    </form>
  <% } %>
</div>

<% if (!assinatura && servicos.length > 0) { %>
  <%/* A barra fica SEMPRE visível (a referência esconde enquanto nada está
       escolhido). Aqui ela é o próprio submit do formulário, então some-la
       tiraria a única pista de "e agora?" de quem abriu a tela. Sem seleção,
       ela usa o par de cores inerte fio/apoio claro. */%>
  <div class="sv-ag6-barra">
    <button class="sv-ag6-acao sv-ag6-inerte" type="submit" form="form-servicos" id="btn-continuar" disabled>
      <span>
        <span class="sv-ag6-acao-rot" id="ag6-cta-rot">Escolha um serviço</span>
        <span class="sv-ag6-acao-sub" id="ag6-cta-sub">para seguir pro barbeiro</span>
      </span>
      <span class="sv-ag6-acao-total" id="ag6-cta-total">R$0</span>
    </button>
  </div>

  <script>
    // Seleção múltipla no cliente: o formulário leva só a lista de ids em um
    // campo escondido, então tudo o que a barra mostra (contagem, duração
    // somada, total) é recalculado aqui a cada toque.
    const selecionados = new Set();
    const precos = {};
    const duracoes = {};
    const encaixes = {};
    document.querySelectorAll('#lista-servicos .sv-ag6-servico').forEach(function (el) {
      precos[el.dataset.id] = Number(el.dataset.valor);
      duracoes[el.dataset.id] = Number(el.dataset.min);
      encaixes[el.dataset.id] = el.dataset.encaixe === '1';
    });
    // Regra do "encaixe": serviço-encaixe não soma tempo quando há outro serviço
    // normal na seleção; sozinho (ou só encaixes), conta a própria duração.
    function duracaoSelecao(ids) {
      var regular = 0, enc = 0;
      ids.forEach(function (id) { if (encaixes[id]) enc += duracoes[id]; else regular += duracoes[id]; });
      return regular > 0 ? regular : enc;
    }
    // "R$40" — sem centavos e sem espaço, porque o total aparece a 22px na
    // barra e ",00" só rouba largura.
    function fmtT6Local(centavos) {
      return 'R$' + Math.round(centavos / 100).toLocaleString('pt-BR');
    }
    function fmtDuracaoLocal(min) {
      if (min < 60) return min + ' min';
      const h = Math.floor(min / 60);
      const r = min % 60;
      return h + 'h' + (r ? String(r).padStart(2, '0') : '');
    }
    function toggleServico(el) {
      const id = el.dataset.id;
      if (selecionados.has(id)) {
        selecionados.delete(id);
        el.classList.remove('sel');
      } else {
        selecionados.add(id);
        el.classList.add('sel');
      }
      document.getElementById('servicoIds-input').value = Array.from(selecionados).join(',');

      const n = selecionados.size;
      const btn = document.getElementById('btn-continuar');
      btn.disabled = n === 0;
      btn.classList.toggle('sv-ag6-inerte', n === 0);
      document.getElementById('ag6-conta').textContent = n ? n + ' selecionado' + (n > 1 ? 's' : '') : 'toque para escolher';

      const ids = Array.from(selecionados);
      const total = ids.reduce(function (s, id) { return s + precos[id]; }, 0);
      const min = duracaoSelecao(ids);
      document.getElementById('ag6-cta-total').textContent = fmtT6Local(total);
      document.getElementById('ag6-cta-rot').textContent = n ? 'Escolher barbeiro' : 'Escolha um serviço';
      document.getElementById('ag6-cta-sub').textContent = n
        ? n + ' serviço' + (n > 1 ? 's' : '') + ' · ' + fmtDuracaoLocal(min)
        : 'para seguir pro barbeiro';
    }
    function validarSelecao() {
      return selecionados.size > 0;
    }
  </script>
<% } %>
