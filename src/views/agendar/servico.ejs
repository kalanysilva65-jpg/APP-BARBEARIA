<%
  function _diasPlanoLabelServico(diasStr) {
    var DIAS = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'];
    var dias = String(diasStr || '').split(',').map(Number).filter(function (n) { return !isNaN(n); }).sort(function (a, b) { return a - b; });
    if (dias.length === 7) return 'todos os dias';
    var corrido = dias.every(function (d, i) { return i === 0 || d === dias[i - 1] + 1; });
    if (corrido && dias.length > 1) return DIAS[dias[0]] + '–' + DIAS[dias[dias.length - 1]];
    return dias.map(function (d) { return DIAS[d]; }).join(', ');
  }
  var nomeBarbearia = (typeof barbearia !== 'undefined' && barbearia) ? barbearia.nome : 'Barbearia';
%>
<div class="ag3-passo">
  <div class="ag3-passo-topo">
    <span class="ag3-marca">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#8a8a85" stroke-width="2"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 20a6 6 0 0 1 12 0M15.5 20a5 5 0 0 1 5.5-5"/></svg>
      <%= nomeBarbearia %>
    </span>
    <div class="ag3-titulo">Serviços</div>
    <% if (!assinatura) { %>
      <a href="/agendar/plano" class="ag3-plano-pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 9h18"/></svg>
        Já tenho um plano
      </a>
    <% } else { %>
      <div class="ag3-plano-ativo">
        Usando o plano <strong><%= assinatura.plano.nome %></strong><%= assinatura.usosRestantes !== null ? ' · ' + assinatura.usosRestantes + ' uso(s) restante(s)' : ' · ilimitado (' + _diasPlanoLabelServico(assinatura.plano.diasSemana) + ')' %>.
        <a href="/agendar">Agendar sem plano</a>
      </div>
    <% } %>
  </div>

  <% if (servicos.length === 0) { %>
    <p class="ag3-vazio">Nenhum serviço disponível no momento.</p>
  <% } else if (assinatura) { %>
    <%/* Plano: seleção única direta por link. */%>
    <div class="ag3-servicos-grid">
      <% servicos.forEach(function (s) { %>
        <a href="/agendar/barbeiro?servicoIds=<%= s.id %>&assinatura=<%= assinatura.id %>" class="ag3-servico-card">
          <span class="ag3-servico-foto">
            <% if (s.fotoUrl) { %><img src="<%= s.fotoUrl %>" alt="" /><% } %>
          </span>
          <span class="ag3-servico-info">
            <span class="ag3-servico-nome"><%= s.nome %></span>
            <span class="ag3-servico-meta"><%= s.duracaoMin %> min · Incluso</span>
          </span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <form id="form-servicos" action="/agendar/barbeiro" method="GET" onsubmit="return validarSelecao()">
      <input type="hidden" name="servicoIds" id="servicoIds-input" value="" />
      <div class="ag3-servicos-grid" id="lista-servicos">
        <% servicos.forEach(function (s) { %>
          <div class="ag3-servico-card" data-id="<%= s.id %>" data-valor="<%= s.valor %>" onclick="toggleServico(this)">
            <span class="ag3-servico-foto">
              <% if (s.fotoUrl) { %><img src="<%= s.fotoUrl %>" alt="" /><% } %>
              <span class="ag3-servico-check">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
              </span>
            </span>
            <span class="ag3-servico-info">
              <span class="ag3-servico-nome"><%= s.nome %></span>
              <span class="ag3-servico-meta"><%= s.duracaoMin %> min · <%= fmtBRL(s.valor) %></span>
            </span>
          </div>
        <% }) %>
      </div>

      <div class="ag3-rodape-acao">
        <button class="ag3-cta" type="submit" id="btn-continuar" disabled>Selecione ao menos um serviço</button>
      </div>
    </form>

    <script>
      const selecionados = new Set();
      const precos = {};
      document.querySelectorAll('#lista-servicos .ag3-servico-card').forEach(function (el) {
        precos[el.dataset.id] = Number(el.dataset.valor);
      });
      function fmtBRLLocal(centavos) {
        return 'R$ ' + (centavos / 100).toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
      }
      function toggleServico(el) {
        const id = el.dataset.id;
        if (selecionados.has(id)) {
          selecionados.delete(id);
          el.classList.remove('sel');
        } else {
          selecionados.add(id);
          el.classList.add('sel');
        }
        document.getElementById('servicoIds-input').value = Array.from(selecionados).join(',');
        const btn = document.getElementById('btn-continuar');
        btn.disabled = selecionados.size === 0;
        if (selecionados.size === 0) {
          btn.textContent = 'Selecione ao menos um serviço';
        } else {
          const total = Array.from(selecionados).reduce(function (s, id) { return s + precos[id]; }, 0);
          btn.textContent = 'Continuar — ' + fmtBRLLocal(total);
        }
      }
      function validarSelecao() {
        return selecionados.size > 0;
      }
    </script>
  <% } %>
</div>
