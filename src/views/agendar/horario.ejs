<%
  function _duracao(min) {
    if (min < 60) return min + ' min';
    var h = Math.floor(min / 60);
    var r = min % 60;
    return h + 'h' + (r ? String(r).padStart(2, '0') : '');
  }
  var qsPlano = assinatura ? '&assinatura=' + assinatura.id : '';
  var livresManha = horariosManha.filter(function (h) { return h.livre; }).length;
  var livresTarde = horariosTarde.filter(function (h) { return h.livre; }).length;
  var nomesServicos = servicos.map(function (s) { return s.nome; }).join(' + ');
%>

<%/* SUAVE (pedido do dono, 2026-07-31): a manchete de 36px virou o cartão
     branco de resumo da referência (22px), os dias viraram ladrilhos de canto
     arredondado e os horários, pílulas. Ocupado fica no cinza fio-claro e
     riscado — sem sombra, então afunda no fundo em vez de sumir.

     Os horários continuam sendo LINKS: um toque marca, sem passo extra de
     "confirmar" (a referência tem um CTA aí porque o protótipo guarda o
     horário em estado; aqui o próprio toque já navega). */%>
<div class="sv-ag6-rolagem">
  <div class="sv-ag6-cartao" style="margin-top:6px">
    <div class="sv-ag6-cartao-tit"><%= nomesServicos %></div>
    <div class="sv-ag6-cartao-sub"><%= servicos.length %> serviço<%= servicos.length > 1 ? 's' : '' %> · <%= _duracao(duracaoTotal) %> · com <%= barbeiro.nome %></div>
  </div>

  <% if (diasPlanoLabel) { %>
    <div class="sv-ag6-aviso">Plano <strong><%= assinatura.plano.nome %></strong>: agendamento só <strong><%= diasPlanoLabel %></strong>.</div>
  <% } %>

  <% if (datas.length === 0) { %>
    <p class="sv-ag6-vazio">Sem datas disponíveis<%= diasPlanoLabel ? ' (' + diasPlanoLabel + ')' : '' %>.</p>
  <% } else { %>
    <div class="sv-ag6-secao" style="animation-delay:0.08s">
      <div class="sv-ag6-secao-tit">Dia</div>
    </div>
    <div class="sv-ag6-dias sv-ag6-sem-sb" id="ag6-dias">
      <% datas.forEach(function (d, i) { %>
        <a href="/agendar/horario?servicoIds=<%= servicoIdsStr %>&barbeiroId=<%= barbeiro.id %>&data=<%= d.iso %><%= qsPlano %>" class="sv-ag6-dia <%= d.iso === dataSel ? 'sel' : '' %>" style="animation-delay:<%= (0.12 + i * 0.04).toFixed(2) %>s">
          <div class="sv-ag6-dia-dow"><%= d.dow %></div>
          <div class="sv-ag6-dia-num"><%= d.dia %></div>
        </a>
      <% }) %>
    </div>

    <% if (horariosManha.length === 0 && horariosTarde.length === 0) { %>
      <p class="sv-ag6-vazio">Sem horários nesta data. Tente outra.</p>
    <% } else { %>
      <%/* Manhã e Tarde continuam separadas (o app tem expediente com almoço
           no meio; a referência tem uma grade só porque o protótipo não tem
           intervalo). A contagem de livres vai no canto direito da seção. */%>
      <% [['Manhã', horariosManha, livresManha], ['Tarde', horariosTarde, livresTarde]].forEach(function (bloco) { %>
        <% if (bloco[1].length > 0) { %>
          <div class="sv-ag6-secao" style="animation-delay:0.14s">
            <div class="sv-ag6-secao-tit"><%= bloco[0] %></div>
            <div class="sv-ag6-secao-val"><%= bloco[2] %> livre<%= bloco[2] === 1 ? '' : 's' %></div>
          </div>
          <div class="sv-ag6-horarios">
            <% bloco[1].forEach(function (h, i) { %>
              <% if (h.livre) { %>
                <a class="sv-ag6-hora" style="animation-delay:<%= (0.2 + i * 0.018).toFixed(3) %>s" href="/agendar/dados?servicoIds=<%= servicoIdsStr %>&barbeiroId=<%= barbeiro.id %>&data=<%= dataSel %>&hora=<%= h.hora %><%= qsPlano %>"><%= h.hora %></a>
              <% } else { %>
                <span class="sv-ag6-hora sv-ag6-hora--ocupado" style="animation-delay:<%= (0.2 + i * 0.018).toFixed(3) %>s"><%= h.hora %></span>
              <% } %>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
      <div style="height:22px"></div>
    <% } %>
  <% } %>
</div>

<%/* O rodapé não é um botão: é o lembrete do que já foi escolhido (e de quanto
     vai custar) enquanto o cliente decide o horário. Cartão branco, e não o
     cinza inerte da ação — cinza ali leria como botão desligado. */%>
<div class="sv-ag6-barra">
  <div class="sv-ag6-lembrete">
    <span>
      <span class="sv-ag6-lembrete-rot">Toque num horário livre</span>
      <span class="sv-ag6-lembrete-sub"><%= servicos.length %> serviço<%= servicos.length > 1 ? 's' : '' %> · <%= _duracao(duracaoTotal) %></span>
    </span>
    <span class="sv-ag6-lembrete-total"><%= assinatura ? 'Incluso' : fmtT6(valorTotal) %></span>
  </div>
</div>

<script>
  // Traz o dia selecionado pra vista: com janela de 14/60 dias a tira fica
  // longa e o dia atual pode nascer fora da tela depois de trocar de data.
  (function () {
    var tira = document.getElementById('ag6-dias');
    if (!tira) return;
    var sel = tira.querySelector('.sv-ag6-dia.sel');
    if (sel) tira.scrollLeft = Math.max(0, sel.offsetLeft - tira.clientWidth / 2 + sel.offsetWidth / 2);
  })();
</script>
