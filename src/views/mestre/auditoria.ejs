<div class="cabecalho-pagina agenda-cabecalho">
  <div>
    <h1>Auditoria</h1>
    <p class="texto-secundario">Registro das ações administrativas do painel-mestre. Só leitura — nada aqui é editável ou apagável pelo app.</p>
  </div>
  <a href="/mestre" class="btn btn-secundario btn-sm">← Voltar</a>
</div>

<div class="card">
  <h2>Ações (<%= total %>)</h2>
  <% if (logs.length === 0) { %>
    <p class="texto-secundario mt-16">Nenhuma ação registrada ainda.</p>
  <% } else { %>
    <div class="tabela-rolagem">
      <table class="tabela mt-16">
        <thead>
          <tr>
            <th>Quando</th>
            <th>Quem</th>
            <th>Ação</th>
            <th>Detalhe</th>
            <th>IP</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function (log) { %>
            <tr>
              <td><span class="texto-sutil"><%= new Date(log.criadoEm).toLocaleString('pt-BR') %></span></td>
              <td><%= log.adminNome %></td>
              <td><span class="badge-papel"><%= log.acao %></span></td>
              <td><%= log.detalhe || '' %></td>
              <td><span class="texto-sutil"><%= log.ip || '—' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (paginacao.totalPaginas > 1) { %>
      <div class="flex gap-8 mt-16" style="align-items:center;justify-content:center">
        <% if (paginacao.pagina > 1) { %>
          <a href="/mestre/auditoria?pagina=<%= paginacao.pagina - 1 %>" class="btn btn-secundario btn-sm">← Anterior</a>
        <% } %>
        <span class="texto-sutil">Página <%= paginacao.pagina %> de <%= paginacao.totalPaginas %></span>
        <% if (paginacao.pagina < paginacao.totalPaginas) { %>
          <a href="/mestre/auditoria?pagina=<%= paginacao.pagina + 1 %>" class="btn btn-secundario btn-sm">Próxima →</a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>
